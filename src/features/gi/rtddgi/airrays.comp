#version 460
// MODULES1 RESUME 15 item 2, route (b) of notes RESEARCH_AIR.md (MegaLights-style rays, Narkowicz & Costa 2025 pp. 14-20,
// 57-63): the placed lamps' shadow in the air from ray queries on the DDGI volume's BVH, one invocation a froxel of a
// half-resolution grid. Per froxel: 2 lamps by weighted reservoir sampling over every lamp whose sphere holds the
// froxel centre (weight = luminance x falloff x spot; the air has no normal), one shadow ray each, the ratio estimator
// (shadowed / unshadowed of the sampled lamps, Heitz et al. 2018, as restir.comp mode 3) as running means of num and den
// reprojected from the previous frame's froxel. cell_volair.frag mode 2 multiplies the exact unshadowed lamp sum by it.
// Set 0 = the DDGI volume's descriptor set (ddgi_common.glsl), set 1 = the buffers below. No CPU twin yet (owed).
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : require
layout( local_size_x = 64 ) in;
#include "ddgi_common.glsl"
#include "restir_common.glsl"

#define AIR_BIT_NOHOLE 1     // red: alpha holes block
#define AIR_BIT_NOHIST 2     // red: no reprojection, this frame's two rays alone
#define AIR_BIT_NOSHADOW 4   // red: every ray unblocked (ratio 1: the unshadowed air)

struct AirParams {
	ivec4 size;       // froxel columns, rows, slices, frame
	ivec4 opts;       // samples a froxel, the frames clamp, red bits, 0
	vec4 slice;       // near, ln(far / near) (cell_volair.frag volSlices.xy), shadow-ray bias, history valid (1)
	vec4 rows[3];     // view -> world (the soup's local frame)
	vec4 proj;        // P00, P11, P20, P21
	vec4 prows[3];    // the previous frame's
	vec4 pproj;
};
layout( std430, set = 1, binding = 0 ) readonly buffer AParams { AirParams A; };
layout( std430, set = 1, binding = 1 ) buffer AAcc { vec4 acc[]; };                 // running means: num, den, frames, 0
layout( std430, set = 1, binding = 2 ) readonly buffer AAccPrev { vec4 accPrev[]; };
layout( std430, set = 1, binding = 3 ) buffer AOut { vec2 outRatio[]; };            // the ratio, its frames (0: none)

// MIRROR restir.comp rsPrim / rsTriTest / rsBlocked (the TRUE triangle; the BLAS is grown; skill ww-bake-gpu-rays)
uint arPrim( uint g, uint i ) { return i + ( g == 1u ? uint( P.counts.w ) : 0u ); }

bool arTriTest( uint pr, vec3 o, vec3 d, out float t, out float u, out float v )
{
	t = 0.0;
	u = 0.0;
	v = 0.0;
	const uint vb = pr * 9u;
	const vec3 p0 = vec3( verts[vb], verts[vb + 1u], verts[vb + 2u] );
	const vec3 e1 = vec3( verts[vb + 3u], verts[vb + 4u], verts[vb + 5u] ) - p0;
	const vec3 e2 = vec3( verts[vb + 6u], verts[vb + 7u], verts[vb + 8u] ) - p0;
	const vec3 pv = cross( d, e2 );
	const float det = dot( e1, pv );
	if ( abs( det ) < 1e-12 )
		return false;
	const float id = 1.0 / det;
	const vec3 tv = o - p0;
	u = dot( tv, pv ) * id;
	if ( u < 0.0 || u > 1.0 )
		return false;
	const vec3 qv = cross( tv, e1 );
	v = dot( d, qv ) * id;
	if ( v < 0.0 || u + v > 1.0 )
		return false;
	t = dot( e2, qv ) * id;
	return true;
}

bool arBlocked( vec3 o, vec3 d, float tmax )
{
	if ( tmax <= 1e-3 )
		return false;
	const bool noHole = ( A.opts.z & AIR_BIT_NOHOLE ) != 0;
	rayQueryEXT q;
	rayQueryInitializeEXT( q, tlas, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsNoOpaqueEXT, 0xFF, o, 0.0, d, tmax );
	while ( rayQueryProceedEXT( q ) ) {
		if ( rayQueryGetIntersectionTypeEXT( q, false ) != gl_RayQueryCandidateIntersectionTriangleEXT )
			continue;
		const uint pr = arPrim( rayQueryGetIntersectionGeometryIndexEXT( q, false ), rayQueryGetIntersectionPrimitiveIndexEXT( q, false ) );
		float t, u, v;
		if ( arTriTest( pr, o, d, t, u, v ) && t > DDGI_TMIN && t <= tmax && ( noHole || !ddgiHole( remap[pr], u, v ) ) )
			rayQueryConfirmIntersectionEXT( q );
	}
	return rayQueryGetIntersectionTypeEXT( q, true ) == gl_RayQueryCommittedIntersectionTriangleEXT;
}

// a lamp's weight at an air point: restirTarget without the surface's cosine (the air scatters every way)
float arTarget( uint b, vec3 Pw )
{
	const vec4 l0 = lights[b], l1 = lights[b + 1u], l2 = lights[b + 2u], l3 = lights[b + 3u];
	const vec3 Lv = l0.xyz - Pw;
	const float d = length( Lv );
	if ( d >= l0.w )
		return 0.0;
	const int shape = int( lights[b + 7u].x + 0.5 );
	if ( shape == 1 && dot( Pw - l0.xyz, l2.xyz ) < 0.0 )
		return 0.0;
	if ( shape == 2 ) {
		const vec4 b0 = lights[b + 4u], b1 = lights[b + 5u], b2 = lights[b + 6u];
		if ( abs( dot( b0.xyz, Pw ) + b0.w ) > 1.0 || abs( dot( b1.xyz, Pw ) + b1.w ) > 1.0 || abs( dot( b2.xyz, Pw ) + b2.w ) > 1.0 )
			return 0.0;
	}
	float att = ddgiRadial( d, l0.w, l3.x, l3.y, l3.z );
	if ( l1.w > 0.5 )
		att = att * ddgiSpot( -dot( Lv, l2.xyz ) / max( d, 0.001 ), l2.w, l3.w );
	return max( restirLum( l1.x, l1.y, l1.z ) * att, 0.0 );
}

uint arHash( uint x )
{
	x ^= x >> 16u;
	x *= 0x7feb352du;
	x ^= x >> 15u;
	x *= 0x846ca68bu;
	x ^= x >> 16u;
	return x;
}
float arRand( inout uint s )
{
	s = arHash( s );
	return float( s >> 8u ) * ( 1.0 / 16777216.0 );
}

// MIRROR restir.comp rsToWorld (rows = view -> world; their inverse below is the transpose about .w)
vec3 arToWorld( vec4 r0, vec4 r1, vec4 r2, vec3 v ) { return vec3( dot( r0.xyz, v ) + r0.w, dot( r1.xyz, v ) + r1.w, dot( r2.xyz, v ) + r2.w ); }

// froxel (x, y, k centre) -> view point; the slices exponential as cell_volair.frag's volSlices
vec3 arView( float x, float y, float k, vec4 pr )
{
	const float z = A.slice.x * exp( k / float( A.size.z ) * A.slice.y );
	const vec2 ndc = vec2( x / float( A.size.x ), y / float( A.size.y ) ) * 2.0 - 1.0;
	return vec3( ( ndc.x + pr.z ) / pr.x * z, ( ndc.y + pr.w ) / pr.y * z, -z );
}

void main()
{
	const uint n = uint( A.size.x * A.size.y * A.size.z );
	const uint id = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * 64u;
	if ( id >= n )
		return;
	const int x = int( id ) % A.size.x, y = ( int( id ) / A.size.x ) % A.size.y, k = int( id ) / ( A.size.x * A.size.y );
	const vec3 Pw = arToWorld( A.rows[0], A.rows[1], A.rows[2], arView( float( x ) + 0.5, float( y ) + 0.5, float( k ) + 0.5, A.proj ) );

	// one pass over the lamps: S independent reservoirs of one lamp each (weighted reservoir sampling)
	const int S = clamp( A.opts.x, 1, 4 );
	uint seed = arHash( id * 9781u + uint( A.size.w ) * 6271u + 1u );
	float wsum = 0.0;
	int pick[4] = int[4]( -1, -1, -1, -1 );
	for ( int i = 0; i < P.counts.y; i++ ) {
		const float w = arTarget( uint( i ) * 8u, Pw );
		if ( !( w > 0.0 ) )
			continue;
		wsum += w;
		for ( int s = 0; s < S; s++ )
			if ( arRand( seed ) * wsum < w )
				pick[s] = i;
	}
	float num = 0.0, den = 0.0;
	if ( wsum > 0.0 ) {
		// each sample's w / pdf is wsum: num / den is the share of the sampled lamps' light that reaches the point
		for ( int s = 0; s < S; s++ ) {
			const uint b = uint( pick[s] ) * 8u;
			bool lit = true;
			if ( ( A.opts.z & AIR_BIT_NOSHADOW ) == 0 && lights[b + 7u].z > 0.5 ) {
				const vec3 L = lights[b].xyz - Pw;
				const float d = length( L );
				const vec3 dir = L / max( d, 1e-4 );
				lit = !arBlocked( Pw + dir * A.slice.z, dir, d - 2.0 * A.slice.z );
			}
			num += lit ? wsum : 0.0;
			den += wsum;
		}
		num /= float( S );
		den /= float( S );
	}

	// history: the previous frame's froxel holding this world point, running means clamped to opts.y frames
	vec4 a = vec4( num, den, 1.0, 0.0 );
	if ( A.slice.w > 0.5 && ( A.opts.z & AIR_BIT_NOHIST ) == 0 ) {
		const vec3 t = Pw - vec3( A.prows[0].w, A.prows[1].w, A.prows[2].w );
		const vec3 v = vec3( dot( vec3( A.prows[0].x, A.prows[1].x, A.prows[2].x ), t ), dot( vec3( A.prows[0].y, A.prows[1].y, A.prows[2].y ), t ),
			dot( vec3( A.prows[0].z, A.prows[1].z, A.prows[2].z ), t ) );
		if ( v.z < -A.slice.x ) {
			const float z = -v.z;
			const vec2 ndc = vec2( v.x / z * A.pproj.x - A.pproj.z, v.y / z * A.pproj.y - A.pproj.w );
			const vec3 f = vec3( ( ndc * 0.5 + 0.5 ) * vec2( A.size.xy ), log( z / A.slice.x ) / A.slice.y * float( A.size.z ) );
			const ivec3 c = ivec3( floor( f ) );
			if ( all( greaterThanEqual( c, ivec3( 0 ) ) ) && all( lessThan( c, A.size.xyz ) ) ) {
				const vec4 h = accPrev[uint( c.x + ( c.y + c.z * A.size.y ) * A.size.x )];
				const float fr = min( h.z + 1.0, float( max( A.opts.y, 1 ) ) );
				a = vec4( mix( h.xy, vec2( num, den ), 1.0 / fr ), fr, 0.0 );
			}
		}
	}
	acc[id] = a;
	outRatio[id] = vec2( a.y > 0.0 ? clamp( a.x / a.y, 0.0, 1.0 ) : 1.0, a.y > 0.0 ? a.z : 0.0 );
}
