#version 460
// Lane RTGI1: the whole-ray RT tracer. One invocation a ray answers what the CPU's probebvh walk answers -- the
// nearest accepted triangle (or, for an occlusion ray, whether any is accepted) -- and says whether it is SURE.
// Every candidate the hardware reports is re-tested in double with probebvh::Bvh::tri's own arithmetic and the
// alpha hole in double (AlphaMask::hole). Unsure (the CPU then casts the ray itself):
//   - a candidate passing within the float trace's error of a triangle edge (an unreported neighbour may hit there;
//     on a grown BLAS only within the double rounding, see testD),
//   - a hole decision on a texel border or at the threshold, a determinant at probebvh's 1e-12 cut,
//   - a hit at the ray's 1e-4 start or its tmax, two accepted hits within bakertwalk.h's near pad of each other.
// Phase 1 finds the nearest hit; phase 2 re-walks (start, that hit + the float error] with every triangle reported,
// so ties just past the float hit are seen too.
#extension GL_EXT_ray_query : require
layout( local_size_x = 128 ) in;

struct XRay { dvec3 o; double tmax; dvec3 d; double pad; };   // 64 bytes; the tree's local frame, as the CPU casts it
layout( std430, set = 0, binding = 0 ) readonly buffer Rays { XRay rays[]; };
layout( std430, set = 0, binding = 1 ) writeonly buffer Hits { uvec2 hits[]; };   // tri (0xFFFFFFFF = miss), 1 = unsure
layout( std430, set = 0, binding = 2 ) readonly buffer TriOf { int triOf[]; };
layout( std430, set = 0, binding = 3 ) readonly buffer MaskTris { uint mt[]; };
layout( std430, set = 0, binding = 4 ) readonly buffer Maps { uvec4 maps[]; };
layout( std430, set = 0, binding = 5 ) readonly buffer Alpha { uint ab[]; };
layout( set = 0, binding = 6 ) uniform accelerationStructureEXT tlas;
layout( std430, set = 0, binding = 7 ) readonly buffer Remap { int remap[]; };   // BLAS primitive -> soup triangle
layout( std430, set = 0, binding = 8 ) readonly buffer Verts { float vt[]; };    // 9 floats a BLAS primitive

// flags bit 0: occlusion ray (any accepted hit answers)
// grow: how far bakert.cpp grew the BLAS triangles (0 = not grown: the float-scale edge band, RTGI1's rule)
layout( push_constant ) uniform Pc { uint first; uint count; uint useMask; uint nTri; uint nOpaque; uint flags; float grow; uint pad; } pc;

const double kNearPad = 1e-6LF;   // bakertwalk.h
const double kErr = 4e-6LF;       // the float trace's error, relative to the coordinates' size (~30 float ulps)
/* ROOMFIT10: on a grazing ray (|cos| ~2e-3..3e-2 to the plane) the hardware t of a triangle is off by the float
 * origin's rounding over cos (0.05-0.4 u at Concord), so a nearer true hit could sit past phase 1's committed t plus
 * kErr: phase 2 reaches this much further (relative to the coordinates' size). Red: flags bit 2 (kErr only). */
const double kGraze = 1e-4LF;

float mf( uint i ) { return uintBitsToFloat( mt[i] ); }

// AlphaMask::hole in double; why |= 2 when the texel or threshold decision sat on its edge
bool holeD( int tri, double b1, double b2, inout uint why )
{
	if ( pc.useMask == 0u || tri < 0 || uint( tri ) >= pc.nTri )
		return false;
	const int m = triOf[tri];
	if ( m < 0 )
		return false;
	const uint b = uint( m ) * 12u;
	const double b0 = 1.0LF - b1 - b2;
	double u = b0 * double( mf( b + 2u ) ) + b1 * double( mf( b + 4u ) ) + b2 * double( mf( b + 6u ) );
	double v = b0 * double( mf( b + 3u ) ) + b1 * double( mf( b + 5u ) ) + b2 * double( mf( b + 7u ) );
	const uvec4 mp = maps[mt[b]];
	u -= floor( u );
	v -= floor( v );
	const double xu = u * double( mp.y ), yv = v * double( mp.z );
	const double fx = xu - floor( xu ), fy = yv - floor( yv );
	if ( fx < 1e-7LF || fx > 1.0LF - 1e-7LF || fy < 1e-7LF || fy > 1.0LF - 1e-7LF || u < 1e-9LF || v < 1e-9LF )
		why |= 2u;
	const int x = clamp( int( xu ), 0, int( mp.y ) - 1 );
	const int y = clamp( int( yv ), 0, int( mp.z ) - 1 );
	const uint off = mp.x + uint( y ) * mp.y + uint( x );
	const uint a = ( ab[off >> 2u] >> ( ( off & 3u ) * 8u ) ) & 255u;
	const uint thr = mt[b + 1u];
	if ( mt[b + 11u] == 0u )
		return a < thr;
	const double s = b0 * double( mf( b + 8u ) ) + b1 * double( mf( b + 9u ) ) + b2 * double( mf( b + 10u ) );
	const double lhs = double( a ) * s;
	if ( abs( lhs - double( thr ) ) <= 1e-9LF * ( 1.0LF + double( thr ) ) )
		why |= 2u;
	return lhs < double( thr );
}

/* BLAS primitive p against the double ray: probebvh::Bvh::tri, then (1e-4, tmax] and the hole. Returns accepted;
 * tt = its distance; why = which of those decisions sat within its error band (the reason bits). */
bool testD( uint p, dvec3 o, dvec3 d, double tmax, double eDist, out double tt, inout uint why )
{
	tt = 0.0LF;
	const uint b = p * 9u;
	const dvec3 p0 = dvec3( vt[b], vt[b + 1u], vt[b + 2u] );
	const dvec3 p1 = dvec3( vt[b + 3u], vt[b + 4u], vt[b + 5u] );
	const dvec3 p2 = dvec3( vt[b + 6u], vt[b + 7u], vt[b + 8u] );
	const dvec3 e1 = p1 - p0, e2 = p2 - p0;
	const dvec3 pv = dvec3( d.y * e2.z - d.z * e2.y, d.z * e2.x - d.x * e2.z, d.x * e2.y - d.y * e2.x );
	const double det = e1.x * pv.x + e1.y * pv.y + e1.z * pv.z;
	if ( abs( abs( det ) - 1e-12LF ) <= 1e-18LF )
		why |= 4u;
	if ( abs( det ) < 1e-12LF )
		return false;
	const double id = 1.0LF / det;
	const dvec3 tv = o - p0;
	const double u = ( tv.x * pv.x + tv.y * pv.y + tv.z * pv.z ) * id;
	const dvec3 qv = dvec3( tv.y * e1.z - tv.z * e1.y, tv.z * e1.x - tv.x * e1.z, tv.x * e1.y - tv.y * e1.x );
	const double v = ( d.x * qv.x + d.y * qv.y + d.z * qv.z ) * id;
	tt = ( e2.x * qv.x + e2.y * qv.y + e2.z * qv.z ) * id;
	// the hit point's distance to each edge line: barycentric x that edge's height (2 area / edge length)
	const dvec3 nn = cross( e1, e2 );
	const double a2 = length( nn );
	const double h0 = a2 / max( length( p2 - p1 ), 1e-30LF ), h1 = a2 / max( length( e2 ), 1e-30LF ),
		h2 = a2 / max( length( e1 ), 1e-30LF );
	const double w = 1.0LF - u - v;
	/* lane ROOMFIT10: on a grown BLAS a triangle the double test accepts is reported by the float hardware however
	 * near its edge the ray passes (GIBAKE2), so the edge band only has to cover the GPU's double rounding against the
	 * CPU's: 1e-9 x (|o| + t + 1). Kept at the float band when the growth does not cover the float error (eDist past
	 * it), for a grazing ray (|cos| < 4e-3: the float ray crosses the plane ulp / cos away) and for a sliver (a corner
	 * with sin(half angle) < 2e-3: growTri caps its corner shift, so the grown rim is thinner there). */
	double eEdge = eDist;
	if ( pc.grow > 0.0 && eDist <= 0.9LF * double( pc.grow ) && abs( dot( nn, d ) ) >= 4e-3LF * a2 * length( d ) ) {
		const double l0 = length( p2 - p1 ), l1 = length( e2 ), l2 = length( e1 );
		const double c0 = dot( e1, e2 ) / max( l1 * l2, 1e-300LF ), c1 = dot( -e1, p2 - p1 ) / max( l2 * l0, 1e-300LF ),
			c2 = dot( -e2, p1 - p2 ) / max( l1 * l0, 1e-300LF );
		// sin(half angle)^2 = (1 - cos) / 2 >= 4e-6 at every corner
		if ( min( c0, min( c1, c2 ) ) > -2.0LF && max( c0, max( c1, c2 ) ) <= 1.0LF - 8e-6LF )
			eEdge = eDist * 2.5e-4LF;
	}
	if ( abs( w ) * h0 <= eEdge || abs( u ) * h1 <= eEdge || abs( v ) * h2 <= eEdge )
		why |= 1u;
	// a grazing ray: the float trace's t error grows as 1 / cos
	if ( u < 0.0LF || u > 1.0LF || v < 0.0LF || u + v > 1.0LF )
		return false;
	if ( abs( tt - 1e-4LF ) <= 1e-9LF || abs( tt - tmax ) <= kNearPad * ( 1.0LF + tmax ) )
		why |= 8u;
	if ( !( tt > 1e-4LF ) || tt > tmax )
		return false;
	if ( holeD( remap[p], u, v, why ) )
		return false;
	return true;
}

// the BLAS primitive (opaque ones first, then the alpha-tested) of a query's candidate (C = false) or commit (true)
#define PRIM( Q, C ) ( rayQueryGetIntersectionPrimitiveIndexEXT( Q, C ) + ( rayQueryGetIntersectionGeometryIndexEXT( Q, C ) == 1u ? pc.nOpaque : 0u ) )

void main()
{
	const uint k = gl_GlobalInvocationID.x;
	if ( k >= pc.count )
		return;
	const XRay r = rays[pc.first + k];
	const dvec3 o = r.o, d = r.d;
	const double tmax = r.tmax;
	const bool any = ( pc.flags & 1u ) != 0u;
	const double oMag = max( abs( o.x ), max( abs( o.y ), abs( o.z ) ) );
	/* lane ROOMFIT10: the float ray starts `back` behind the true origin. A point on a surface (the volume fit's lattice)
	 * meets a triangle at t ~1e-4..2e-3, inside the float origin's rounding: from the rounded origin the hardware saw
	 * it behind the ray and never reported it (check: 190 unlike answers on Concord). The hardware t is then back
	 * longer than the true t; the double test uses the true origin. */
	const double back = kErr * ( oMag + 1.0LF );
	const vec3 of = vec3( o - d * back ), df = vec3( d );
	const float tmaxF = float( tmax * ( 1.0LF + kErr ) + kErr * ( oMag + 1.0LF ) + back );
	uint why = 0u;   // ROOMFIT10: the unsure reasons (0 = sure), each counted in the census
	int tri = -1;

	/* phase 1: the nearest hit. ROOMFIT10: every triangle goes through the double test (no opaque commits in hardware):
	 * on the grown BLAS a ray passing a silhouette within the growth (2 u at Concord) committed the rim, phase 2 then
	 * found no true hit and the ray went to the CPU (7.5% of Concord's fit rays) */
	rayQueryEXT q;
	rayQueryInitializeEXT( q, tlas, any ? gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsNoOpaqueEXT : gl_RayFlagsNoOpaqueEXT, 0xFF, of, 0.0, df,
		tmaxF );
	while ( rayQueryProceedEXT( q ) ) {
		if ( rayQueryGetIntersectionTypeEXT( q, false ) != gl_RayQueryCandidateIntersectionTriangleEXT )
			continue;
		const uint p = PRIM( q, false );
		const float tf = rayQueryGetIntersectionTEXT( q, false );
		double tt;
		uint m = 0u;
		const bool acc = testD( p, o, d, tmax, kErr * ( oMag + double( tf ) + 1.0LF ), tt, m );
		why |= m;
		if ( any ) {   // an occlusion ray ends on its first SURE accepted hit; a doubtful one only marks the ray
			if ( acc && m == 0u ) {
				tri = remap[p];
				rayQueryConfirmIntersectionEXT( q );
			}
		} else if ( acc )
			rayQueryConfirmIntersectionEXT( q );
	}
	const bool hit1 = rayQueryGetIntersectionTypeEXT( q, true ) == gl_RayQueryCommittedIntersectionTriangleEXT;
	if ( !hit1 ) {   // a miss: sure unless an alpha decision on the way sat on its edge
		hits[pc.first + k] = uvec2( 0xFFFFFFFFu, why );
		return;
	}
	const float t0 = rayQueryGetIntersectionTEXT( q, true );
	if ( any ) {
		if ( tri >= 0 ) {   // a sure alpha-tested hit answers it, whatever else was doubtful
			hits[pc.first + k] = uvec2( uint( tri ), 0u );
			return;
		}
		// an opaque commit: sure when its double re-test accepts it clear of every edge
		const uint p = PRIM( q, true );
		double tt;
		uint m2 = 0u;
		const bool acc = testD( p, o, d, tmax, kErr * ( oMag + double( t0 ) + 1.0LF ), tt, m2 );
		hits[pc.first + k] = acc && m2 == 0u ? uvec2( uint( remap[p] ), 0u ) : uvec2( 0xFFFFFFFFu, acc ? m2 : m2 | 32u );
		return;
	}

	// phase 2: everything in (0, t0 + the float error], each in double; nothing committed so nothing is culled
	why = 0u;
	const double eT = kErr * ( oMag + double( t0 ) + 1.0LF );
	const double eG = ( pc.flags & 2u ) != 0u ? 0.0LF : kGraze * ( oMag + double( t0 ) + 1.0LF );
	const float tEnd = min( tmaxF, float( double( t0 ) * ( 1.0LF + kErr ) + eT + eG ) );
	rayQueryEXT q2;
	rayQueryInitializeEXT( q2, tlas, gl_RayFlagsNoOpaqueEXT, 0xFF, of, 0.0, df, tEnd );
	double best = 1e300LF, second = 1e300LF;
	int bestTri = -1;
	while ( rayQueryProceedEXT( q2 ) ) {
		if ( rayQueryGetIntersectionTypeEXT( q2, false ) != gl_RayQueryCandidateIntersectionTriangleEXT )
			continue;
		const uint p = PRIM( q2, false );
		double tt;
		if ( !testD( p, o, d, tmax, eT, tt, why ) )
			continue;
		const int st = remap[p];
		if ( tt < best ) {
			if ( st != bestTri )
				second = best;
			best = tt;
			bestTri = st;
		} else if ( st != bestTri && tt < second )
			second = tt;
	}
	if ( bestTri < 0 )
		why |= 32u;
	else if ( second - best <= kNearPad * ( 1.0LF + best ) )
		why |= 16u;
	hits[pc.first + k] = uvec2( bestTri < 0 ? 0xFFFFFFFFu : uint( bestTri ), why );
}
