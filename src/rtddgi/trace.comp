#version 460
// Lane RTXGI1: the probe trace. One invocation a (probe, ray): ray query against bakert's BLAS (geometry 0 opaque,
// geometry 1 alpha-tested, holes tested here), nearest hit. The CPU twin is src/rtddgi.cpp traceRay(); the rules:
//   miss          sky radiance (0 without sky), distance DDGI_MISS
//   backface      radiance 0, distance -0.2 t (a one-sided face seen from behind) [J21 4.1]
//   fixed ray     distance only (rays < 32 are never blended [SDK])
//   front face    albedo / pi x (sun behind a shadow ray + interior directional + the placed lights behind shadow
//                 rays + the volume's own irradiance at the hit, the infinite bounce [J19 5.3]) + Le
// mode 0 = an update (active probes, every ray), mode 1 = the fixed rays of every probe (relocation, classification).
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : require
layout( local_size_x = 64 ) in;
#include "ddgi_common.glsl"

bool ddgiShadow( vec3 o, vec3 d, float tmax )
{
	if ( tmax <= 1e-3 )
		return false;
	rayQueryEXT q;
	rayQueryInitializeEXT( q, tlas, gl_RayFlagsTerminateOnFirstHitEXT, 0xFF, o, 0.0, d, tmax );
	while ( rayQueryProceedEXT( q ) ) {
		if ( rayQueryGetIntersectionTypeEXT( q, false ) != gl_RayQueryCandidateIntersectionTriangleEXT )
			continue;
		const uint g = rayQueryGetIntersectionGeometryIndexEXT( q, false );
		const uint pr = rayQueryGetIntersectionPrimitiveIndexEXT( q, false ) + ( g == 1u ? uint( P.counts.w ) : 0u );
		const vec2 bc = rayQueryGetIntersectionBarycentricsEXT( q, false );
		if ( !ddgiHole( remap[pr], bc.x, bc.y ) )
			rayQueryConfirmIntersectionEXT( q );
	}
	return rayQueryGetIntersectionTypeEXT( q, true ) == gl_RayQueryCommittedIntersectionTriangleEXT;
}

// MIRROR src/rtddgi.cpp sampleVolume: the 8-probe irradiance at P (normal n, viewer direction o), x 2 pi
vec3 ddgiIrradianceAt( vec3 Pw, vec3 n, vec3 o )
{
	const float D = P.stepv.w;
	vec3 Pb = Pw;
	if ( ( uint( P.flags.w ) & DDGI_RED_NOBIAS ) == 0u )
		Pb += ddgiBiasVector( n, o, D, P.blendp.z );
	const vec3 g = ( Pb - P.origin.xyz ) / P.stepv.xyz;
	const ivec3 base = clamp( ivec3( floor( g ) ), ivec3( 0 ), max( P.dims.xyz - ivec3( 2 ), ivec3( 0 ) ) );
	const vec3 a = clamp( g - vec3( base ), vec3( 0.0 ), vec3( 1.0 ) );
	vec3 sum = vec3( 0.0 );
	float wsum = 0.0;
	for ( int c = 0; c < 8; c++ ) {
		const ivec3 off = ivec3( c & 1, ( c >> 1 ) & 1, ( c >> 2 ) & 1 );
		const ivec3 pc3 = min( base + off, P.dims.xyz - ivec3( 1 ) );
		const uint p = uint( pc3.x + P.dims.x * ( pc3.y + P.dims.y * pc3.z ) );
		if ( ddgiProbeState( p ) != DDGI_VIGILANT || age[p] == 0u )
			continue;
		const vec3 tri = mix( vec3( 1.0 ) - a, a, vec3( off ) );
		const float trilinear = tri.x * tri.y * tri.z;
		const vec3 pp = ddgiProbePos( p );
		const vec3 toProbe = normalize( pp - Pw );
		float w = ddgiBackfaceWeight( toProbe, n );
		const vec3 bToProbe = pp - Pb;
		const float r = length( bToProbe );
		if ( ( uint( P.flags.w ) & DDGI_RED_NOCHEB ) == 0u && r > 0.0 ) {
			const vec2 m = ddgiSampleDist( p, -bToProbe / r );
			w *= ddgiChebyshev( r, m.x, m.y );
		}
		w = max( w, 1e-6 );
		w = ddgiCrush( w );
		w *= trilinear;
		const vec3 e = ddgiSampleIrr( p, n );
		sum += w * pow( max( e, vec3( 0.0 ) ), vec3( 2.5 ) );
		wsum += w;
	}
	if ( wsum <= 0.0 )
		return vec3( 0.0 );
	const vec3 m = sum / wsum;
	return m * m * ( 2.0 * DDGI_PI );
}

vec3 ddgiDirect( vec3 Pw, vec3 n )
{
	vec3 E = vec3( 0.0 );
	const vec3 o = Pw + n * 0.5;
	if ( P.sunTo.w > 0.5 ) {
		const float nl = dot( n, P.sunTo.xyz );
		if ( nl > 0.0 && !ddgiShadow( o, P.sunTo.xyz, P.sun.w ) )
			E += P.sun.rgb * nl;
	}
	if ( P.dirTo.w > 0.5 ) {
		const float nl = dot( n, P.dirTo.xyz );
		if ( nl > 0.0 )
			E += P.dirColor.rgb * nl;
	}
	for ( int li = 0; li < P.counts.y; li++ ) {
		const uint b = uint( li ) * 8u;
		const vec4 l0 = lights[b], l1 = lights[b + 1u], l2 = lights[b + 2u], l3 = lights[b + 3u];
		const vec4 l7 = lights[b + 7u];
		const vec3 Lv = l0.xyz - Pw;
		const float d = length( Lv );
		if ( d >= l0.w )
			continue;
		const int shape = int( l7.x + 0.5 );
		if ( shape == 1 && dot( Pw - l0.xyz, l2.xyz ) < 0.0 )
			continue;
		if ( shape == 2 ) {
			bool inside = true;
			for ( int k = 0; k < 3; k++ ) {
				const vec4 bx = lights[b + 4u + uint( k )];
				if ( abs( dot( bx.xyz, Pw ) + bx.w ) > 1.0 )
					inside = false;
			}
			if ( !inside )
				continue;
		}
		const vec3 L = Lv / max( d, 0.001 );
		const float nl = dot( n, L );
		if ( nl <= 0.0 )
			continue;
		float att = ddgiRadial( d, l0.w, l3.x, l3.y, l3.z );
		if ( l1.w > 0.5 )
			att *= ddgiSpot( -dot( L, l2.xyz ), l2.w, l3.w );
		if ( att * nl <= 0.0 )
			continue;
		const vec3 dl = l0.xyz - o;
		const float len = length( dl );
		if ( ddgiShadow( o, dl / max( len, 1e-6 ), len - P.dirColor.w ) )
			continue;
		E += l1.rgb * att * nl;
	}
	return E;
}

void main()
{
	const uint id = ddgiLinearId();
	const uint nRay = pc.job.w;
	if ( id >= uint( P.dims.w ) * nRay )
		return;
	const uint p = id / nRay;
	const int i = int( pc.job.z + id % nRay );
	const int N = P.counts.x;
	const int st = ddgiProbeState( p );
	if ( pc.job.x == 0u && ( st == DDGI_OFF || ( st == DDGI_ASLEEP && P.flags.y != 0 ) ) )
		return;
	const vec3 o = ddgiProbePos( p );
	const vec3 d = ddgiRayDir( i, N );
	rayQueryEXT q;
	rayQueryInitializeEXT( q, tlas, gl_RayFlagsNoneEXT, 0xFF, o, 0.0, d, P.sun.w );
	while ( rayQueryProceedEXT( q ) ) {
		if ( rayQueryGetIntersectionTypeEXT( q, false ) != gl_RayQueryCandidateIntersectionTriangleEXT )
			continue;
		const uint g = rayQueryGetIntersectionGeometryIndexEXT( q, false );
		const uint pr = rayQueryGetIntersectionPrimitiveIndexEXT( q, false ) + ( g == 1u ? uint( P.counts.w ) : 0u );
		const vec2 bc = rayQueryGetIntersectionBarycentricsEXT( q, false );
		if ( !ddgiHole( remap[pr], bc.x, bc.y ) )
			rayQueryConfirmIntersectionEXT( q );
	}
	vec4 rec;
	if ( rayQueryGetIntersectionTypeEXT( q, true ) != gl_RayQueryCommittedIntersectionTriangleEXT ) {
		rec = vec4( P.sky[0].w > 0.5 && i >= DDGI_FIXED ? ddgiSky( d ) : vec3( 0.0 ), DDGI_MISS );
	} else {
		const float t = rayQueryGetIntersectionTEXT( q, true );
		const uint g = rayQueryGetIntersectionGeometryIndexEXT( q, true );
		const uint pr = rayQueryGetIntersectionPrimitiveIndexEXT( q, true ) + ( g == 1u ? uint( P.counts.w ) : 0u );
		const int tri = remap[pr];
		const uint vb = pr * 9u;
		const vec3 v0 = vec3( verts[vb], verts[vb + 1u], verts[vb + 2u] );
		const vec3 e1 = vec3( verts[vb + 3u], verts[vb + 4u], verts[vb + 5u] ) - v0;
		const vec3 e2 = vec3( verts[vb + 6u], verts[vb + 7u], verts[vb + 8u] ) - v0;
		const vec3 nf = normalize( cross( e1, e2 ) );
		const vec4 a0 = triAttr[uint( tri ) * 2u];
		const bool back = a0.w < 0.5 && dot( nf, d ) > 0.0;
		if ( back && ( uint( P.flags.w ) & DDGI_RED_NOBACK ) == 0u ) {
			rec = vec4( 0.0, 0.0, 0.0, -0.2 * t );
		} else if ( i < DDGI_FIXED ) {
			rec = vec4( 0.0, 0.0, 0.0, t );
		} else {
			const vec3 n = dot( nf, d ) > 0.0 ? -nf : nf;
			const vec3 Pw = o + d * t;
			vec3 E = ddgiDirect( Pw, n );
			if ( P.flags.x == 0 )
				E += ddgiIrradianceAt( Pw, n, -d );
			rec = vec4( a0.rgb * E / DDGI_PI + triAttr[uint( tri ) * 2u + 1u].rgb, t );
		}
	}
	rays[p * uint( N ) + uint( i )] = rec;
}
