+void lodgenSetLandHexSize( float units )
+{
+	/* Clamped at zero, not refused, like the warp's amplitude: a negative size
+	 * is a typo and the meaningful floor of this control is "off". */
+	g_landHexSize = units > 0.0f ? units : 0.0f;
+}
