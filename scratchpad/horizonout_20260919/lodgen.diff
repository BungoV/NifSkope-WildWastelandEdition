+
+void LodgenErosionCensus::add( const LodgenErosionCensus & o )
+{
+	if ( o.cells == 0 )
+		return;
+	const double w0 = double( moved ), w1 = double( o.moved );
+	if ( w0 + w1 > 0.0 )
+		meanAbs = ( meanAbs * w0 + o.meanAbs * w1 ) / ( w0 + w1 );
+	cells += o.cells;
+	moved += o.moved;
+	maxCut = qMin( maxCut, o.maxCut );
+	maxFill = qMax( maxFill, o.maxFill );
+	step = o.step;
+}
