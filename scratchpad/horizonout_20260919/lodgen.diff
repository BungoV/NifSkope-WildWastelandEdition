+QString lodgenFileDigest( const QString & path )
+{
+	QFile f( path );
+	if ( !f.open( QIODevice::ReadOnly ) )
+		return QString();
+	QCryptographicHash h( QCryptographicHash::Sha1 );
+	if ( !h.addData( &f ) )
+		return QString();
+	return QString::fromLatin1( h.result().toHex() );
+}
