float3 rpOctDecode(float2 uv)
{
    float2 f = (uv * 2.0f) - 1.0f.xx;
    float3 n = float3(f, (1.0f - abs(f.x)) - abs(f.y));
    float t = max(-n.z, 0.0f);
    float nPick2;
    if (n.x >= 0.0f)
    {
        nPick2 = -t;
    }
    else
    {
        nPick2 = t;
    }
    n.x += nPick2;
    float nPick;
    if (n.y >= 0.0f)
    {
        nPick = -t;
    }
    else
    {
        nPick = t;
    }
    n.y += nPick;
    return normalize(n);
}

// a miss direction below the horizon (world z up)
bool wwSkyBelow(float3 d)
{
    return d.z < 0.0f;
}

// tap k (0..8) of the ground's albedo: straight down, 4 on the axes 20 degrees below the horizon, 4 on the diagonals at 60
float3 wwSkyBelowTap(int k)
{
    if (k == 0)
    {
        return float3(0.0f, 0.0f, -1.0f);
    }
    if (k < 5)
    {
        float c = 0.93969261646270751953125f;
        float s = -0.34202015399932861328125f;
        if (k == 1)
        {
            return float3(c, 0.0f, s);
        }
        if (k == 2)
        {
            return float3(-c, 0.0f, s);
        }
        if (k == 3)
        {
            return float3(0.0f, c, s);
        }
        return float3(0.0f, -c, s);
    }
    float q = 0.3535533845424652099609375f;
    float s6 = -0.866025388240814208984375f;
    float wwSkyBelowTapRet2;
    bool wwh0 = (k == 5);
    bool wwh1 = (k == 8);
    if (or(wwh0, wwh1))   // HLSLFIX2 orfix.py: no short-circuit branch (NV took the wrong side)
    {
        wwSkyBelowTapRet2 = q;
    }
