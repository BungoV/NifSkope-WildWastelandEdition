// HLSL port of features/weather/cell_precip_gpu.frag (frag shader). Generated by notes/hlslbulk1/tools/convert.py:
// glslang -G, then spirv-cross --hlsl; loose uniforms are the LooseUniforms cbuffer (register b31); the
// GLSL includes are inlined as the loader does. Fusion Shaders (F4FS) feeds it the GL-side inputs
// named in notes/vkcompute1/hlsl_plan.md. Not wired: nothing loads this file.
// profile: ps_6_0
#include "WeatherBindingsVk.hlsli"
cbuffer LooseUniforms : register(b31, space0)
{
    int pcFar;
    bool pcHasTex;
    float4 pcAtlas;	// cell uv size, the deepest mip a near quad reads, the one-texel-a-cell mip
    float2 pcNear;	// view units from the eye: gone at x, whole at y (a flake never covers the lens)
};
Texture2D<float4> pcTex : register(t0, space0);
SamplerState _pcTex_sampler : register(s0, space0);

static float2 gQ;
static float2 gUv;
static float4 gBox;
static float4 gCol;
static float3 gView;
static float4 fragColor;
static float3 gA;
static float3 gB;

struct SPIRV_Cross_Input
{
    float2 gUv : TEXCOORD0;
    float2 gQ : TEXCOORD1;
    float3 gView : TEXCOORD2;
    nointerpolation float4 gCol : TEXCOORD3;
    nointerpolation float4 gBox : TEXCOORD4;
    nointerpolation float3 gA : TEXCOORD5;
    nointerpolation float3 gB : TEXCOORD6;
};

struct SPIRV_Cross_Output
{
    float4 fragColor : SV_Target0;
};

void frag_main()
{
    float4 t;
    if (pcFar != 0)
    {
        // a far dot: the cell's mean (gCol) over a soft round footprint whose mean over the quad is 1
        t = float4(1.0f, 1.0f, 1.0f, exp((-2.5f) * dot(gQ, gQ)) / 0.298500001430511474609375f);
    }
    else
    {
        if (pcHasTex)
        {
            float tmp = pcTex.CalculateLevelOfDetail(_pcTex_sampler, gUv);
            float2 lodPart = tmp.xx;
            float lod = min(lodPart.x, pcAtlas.z);
            t = pcTex.SampleLevel(_pcTex_sampler, clamp(gUv, gBox.xy, gBox.zw), lod);
        }
        else
        {
            t = float4(1.0f, 1.0f, 1.0f, clamp(1.0f - dot(gQ, gQ), 0.0f, 1.0f));
        }
    }
    float a = clamp(t.w * gCol.w, 0.0f, 1.0f) * smoothstep(pcNear.x, pcNear.y, -gView.z);
    if (a < 0.001953125f)
    {
        discard;
    }
    // linear: the sRGB texture decodes on read
    float3 alb = t.xyz * gCol.xyz;
    fragColor = float4(max((alb * gA) + gB, 0.0f.xxx), a);
}

SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
{
    gQ = stage_input.gQ;
    gUv = stage_input.gUv;
    gBox = stage_input.gBox;
    gCol = stage_input.gCol;
    gView = stage_input.gView;
    gA = stage_input.gA;
    gB = stage_input.gB;
    frag_main();
    SPIRV_Cross_Output stage_output;
    stage_output.fragColor = fragColor;
    return stage_output;
}
