    float ln = length(n);
    float3 lv = float3(csmMat[0][0].z, csmMat[0][1].z, csmMat[0][2].z);
    bool cond2 = ln <= 9.9999996826552253889678874634872e-21f;
    bool cond;
    if (!cond2)
    {
        cond = dot(lv, lv) <= 0.0f;
    }
    else
    {
        cond = cond2;
    }
    if (cond)
    {
        return 0.0f.xxx;
    }
    float3 nPick;
    if (dot(n, posView) > 0.0f)
    {
        nPick = (-n) / ln.xxx;
    }
    else
