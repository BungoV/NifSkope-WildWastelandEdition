float3 cellLightE(int i, float3 P, float3 N, inout float3 L, out bool noSpec)
{
    float4 t0 = cellLights.Load(i * 8);
    float3 Lv = t0.xyz - P;
    float d = length(Lv);
    L = Lv / max(d, 0.001000000047497451305389404296875f).xxx;
    noSpec = true;
    bool cond8 = d >= t0.w;
    bool cond7;
    if (!cond8)
    {
        cond7 = dot(N, L) <= 0.0f;
    }
    else
    {
        cond7 = cond8;
    }
    if (cond7)
    {
        return 0.0f.xxx;
    }
    float4 t1 = cellLights.Load((i * 8) + 1);
    int iArg4 = i;
    float3 PArg2 = P;
    float3 LposArg = t0.xyz;
    float shapeArg = t1.w;
    if (!cellShapeIn(iArg4, PArg2, LposArg, shapeArg))
    {
        return 0.0f.xxx;
    }
    float4 t3 = cellLights.Load((i * 8) + 3);
    float dArg = d;
    float rArg = t0.w;
    float3 bseArg = t3.xyz;
    float a = cellRadial(dArg, rArg, bseArg);
    // lane LIGHTS5 (GOBO1)
    float3 g = 1.0f.xxx;
    float3 gAx_1 = 0.0f.xxx;
    if (t1.w > (-1.5f))
    {
        float4 t2 = cellLights.Load((i * 8) + 2);
        float base = clamp(1.0f - ((1.0f - dot(-L, t2.xyz)) / max(1.0f - t1.w, 9.9999997473787516355514526367188e-05f)), 0.0f, 1.0f);
        a *= min(pow(base, max(t2.w, 0.001000000047497451305389404296875f)), 1.0f);
        gAx_1 = t2.xyz;
    }
    if (a > 0.0f)
    {
        int iArg3 = i;
        float3 DArg = -Lv;
        float3 axisArg = gAx_1;
        bool spotArg = t1.w > (-1.5f);
        // one call for every shape
        g = cellGobo(iArg3, DArg, axisArg, spotArg);
    }
    if (a > 0.0f)
    {
        int iArg2 = i;
        float3 PArg = P;
        float3 NArg = N;
        a *= cellShadowF(iArg2, PArg, NArg);
    }
    noSpec = (int(t3.w + 0.5f) & 1) != 0;
    return (t1.xyz * g) * a;
}

