        vsColor[i] = stage_input[i].vsColor;
    }
    for (int i = 0; i < 1; i++)
    {
        vsAngle[i] = stage_input[i].vsAngle;
    }
    for (int i = 0; i < 1; i++)
    {
        vsCell[i] = stage_input[i].vsCell;
    }
    geom_main(stage_input, geometry_stream);
}
