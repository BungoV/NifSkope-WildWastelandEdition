// HLSL port of features/post/game_doflens.frag (frag shader). Generated by notes/hlslbulk1/tools/convert.py:
// glslang -G, then spirv-cross --hlsl; loose uniforms are the LooseUniforms cbuffer (register b31); the
// GLSL includes' functions are #included from the shared .hlsli files, the rest is inlined as the loader does. Fusion Shaders (F4FS) feeds it the GL-side inputs
// named in notes/vkcompute1/hlsl_plan.md. Not wired: nothing loads this file.
// profile: ps_6_0
#include "PostBindingsVk.hlsli"
cbuffer LooseUniforms : register(b31, space0)
{
    float4 lz;
    float4 lensP;
    float4 lensQ;
    float4 c2;
    int farOnly;
    float4 c0;
    float4 c1;
    int dofRed;
    float4 c3;
};
Texture2D<float4> t0 : register(t0, space0);
SamplerState _t0_sampler : register(s0, space0);
Texture2D<float4> t2 : register(t1, space0);
SamplerState _t2_sampler : register(s1, space0);
Texture2D<float4> t1 : register(t2, space0);
SamplerState _t1_sampler : register(s2, space0);
Texture2D<float4> lensNear : register(t3, space0);	// the near layer, premultiplied (rgb * a, a)
SamplerState _lensNear_sampler : register(s3, space0);

static float4 gl_FragCoord;
static float4 fragColor;

struct SPIRV_Cross_Input
{
    float4 gl_FragCoord : SV_Position;
};

struct SPIRV_Cross_Output
{
    float4 fragColor : SV_Target0;
};

static float lensS1;

static uint dummy_parameter;

uint2 spvTextureSize(Texture2D<float4> Tex, uint Level, out uint Param)
{
    uint2 ret;
    Tex.GetDimensions(Level, ret.x, ret.y, Param);
    return ret;
}

// the view distance of a window depth; < 0 = the sky (no geometry)
#define WW_FN_lensDist
#include "game_doflens.hlsli"
#undef WW_FN_lensDist

// the focus distance: the record's, or the distance at the frame's centre (autofocus)
#define WW_FN_lensFocus
#include "game_doflens.hlsli"
#undef WW_FN_lensFocus

// the signed circle of confusion (px) at view distance z (< 0 = the sky), focus s1
#define WW_FN_lensCoc
#define WW_FN_lensSat
#include "game_doflens.hlsli"
#undef WW_FN_lensCoc
#undef WW_FN_lensSat

// the lens composite at one full-size texel: the sharp frame, the far layer where the circle passes 1 px, the near
// layer over both; an in-focus texel with no near neighbour is the frame bit for bit
float4 lensTexel(int2 p)
{
    float4 a = t0.Load(int3(p, 0));
    float dArg = t2.Load(int3(p, 0)).x;
    float zArg = lensDist(dArg);
    float s1Arg = lensS1;
    float cf = lensCoc(zArg, s1Arg);
    float2 uq = (float2(p) + 0.5f.xx) / (float2(int2(spvTextureSize(t1, uint(0), dummy_parameter))) * 4.0f);
    float3 m = a.xyz;
    if (cf > 1.0f)
    {
        float vArg = (cf - 1.0f) / 3.0f;
        m = lerp(a.xyz, t1.Sample(_t1_sampler, uq).xyz, lensSat(vArg).xxx);
    }
    if (lensQ.y != 0.0f)
    {
        float4 n = lensNear.Sample(_lensNear_sampler, uq);
        if (n.w > 0.0f)
        {
            m = (m * (1.0f - n.w)) + n.xyz;
        }
    }
    return float4(m, a.w);
}

void frag_main()
{
    lensS1 = 0.0f;
    lensS1 = lensFocus(t2, _t2_sampler);
    int2 pArg = int2(gl_FragCoord.xy);
    fragColor = lensTexel(pArg);
}

SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
{
    gl_FragCoord = stage_input.gl_FragCoord;
    gl_FragCoord.w = 1.0 / gl_FragCoord.w;
    frag_main();
    SPIRV_Cross_Output stage_output;
    stage_output.fragColor = fragColor;
    return stage_output;
}
