float sat(float v)
{
    float satRet;
    if (v >= 0.0f)
    {
        satRet = min(v, 1.0f);
    }
    else
    {
        satRet = 0.0f;
    }
    return satRet;
}

void frag_main()
{
    float2 v1 = gl_FragCoord.xy / float2(int2(spvTextureSize(t0, uint(0), dummy_parameter)));
    // add r0.x, -r0.x, 1
    float x = 1.0f - t2.Sample(_t2_sampler, v1).x;
    // mad
    float y = (x * c2.z) + c2.y;
    // lt
    bool notSky = 9.9999997473787516355514526367188e-06f < x;
    // div: the view distance
    y = c2.w / y;
    float k;
    if (farOnly != 0)
    {
        float vArg2 = (y - c0.z) / c0.y;
        // add, div_sat
        k = sat(vArg2);
        k *= c1.x;
        bool notSkyPick2;
        if (!notSky)
        {
            notSkyPick2 = !(0.0f != c1.w);
        }
        else
        {
            notSkyPick2 = notSky;
        }
        // ne, not, or
        notSky = notSkyPick2;
    }
    else
    {
        float nearT = (c0.z - y) / c0.x;
        bool cond2 = y < c0.z;
        bool nearOnPick;
        if (cond2)
        {
            nearOnPick = 0.0f != c1.y;
        }
        else
        {
            nearOnPick = cond2;
        }
        bool nearOn = nearOnPick;
        // and with the mask
        nearT = nearOn ? nearT : 0.0f;
        float farT = y - c0.z;
        bool cond = c0.z < y;
        bool farOnPick;
        if (cond)
        {
            farOnPick = 0.0f != c1.z;
        }
        else
        {
            farOnPick = cond;
        }
        bool farOn = farOnPick;
        bool notSkyPick;
        if (!notSky)
        {
            notSkyPick = !(0.0f != c1.w);
        }
        else
        {
            notSkyPick = notSky;
        }
        notSky = notSkyPick;
        farT /= c0.y;
        float vArg = farOn ? farT : nearT;
        // movc_sat
        k = sat(vArg);
        k *= c1.x;
    }
    if (dofRed != 0)
    {
        k = c1.x;
    }
    // and r0.x, r0.y, r0.x
    k = notSky ? k : 0.0f;
    float4 b = t1.Sample(_t1_sampler, v1 * c3.zw);
    float4 a = t0.Sample(_t0_sampler, v1);
