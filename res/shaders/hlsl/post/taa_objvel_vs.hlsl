float3 grassOffset(float phase)
{
    float L = length(bitangentVector);
    float offPick;
    if (L > 2.0f)
    {
        offPick = L - 1024.0f;
    }
    else
    {
        offPick = 0.0f;
    }
    float off = offPick;
    float p = (phase - off) * wwGrassWind2.z;
    float half_range = (wwGrassWind2.y - wwGrassWind2.x) * 0.5f;
    float sp = sin(p);
    float cp = cos(p);
    float w = sin(sp * 3.1415927410125732421875f) + sin(sp * 6.283185482025146484375f);
    w = (w * 0.300000011920928955078125f) + (cos(cp * 3.1415927410125732421875f) * 0.20000000298023223876953125f);
    w += 1.0f;
    w = (w * half_range) + wwGrassWind2.x;
    w *= ((vertexColor.w * vertexColor.w) * 0.5f);
    return float3(cos(wwGrassWind.x), sin(wwGrassWind.x), 0.0f) * w;
}

void vert_main()
{
    float3 cur = vertexPosition;
    bool3 prevPart = (velMode == 1).xxx;
    float3 prev = float3(prevPart.x ? prevPosition.x : vertexPosition.x, prevPart.y ? prevPosition.y : vertexPosition.y, prevPart.z ? prevPosition.z : vertexPosition.z);
    bool cond2 = velMode == 2;
    bool cond;
    if (cond2)
    {
        cond = wwGrassWind2.w > 0.5f;
    }
    else
    {
        cond = cond2;
    }
    if (cond)
    {
        float phaseArg2 = wwGrassWind.w;
        cur += grassOffset(phaseArg2);
        float phaseArg = wwGrassWind.z;
        prev += grassOffset(phaseArg);
    }
    cCur = mul(float4(cur, 1.0f), clipCur);
    cPrev = mul(float4(prev, 1.0f), clipPrev);
    viewPos = mul(float4(cur, 1.0f), modelViewMatrix).xyz;
    texCoord = multiTexCoord0;
    vAlpha = vertexColor.w;
    btnMatrix[2] = normalize(mul(normalMatrix, normalVector));
    btnMatrix[1] = normalize(mul(normalMatrix, tangentVector));
    btnMatrix[0] = normalize(mul(normalMatrix, bitangentVector));
    gl_Position = mul(float4(cur, 1.0f), clipJit);
}

SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
{
    bitangentVector = stage_input.bitangentVector;
    vertexColor = stage_input.vertexColor;
    vertexPosition = stage_input.vertexPosition;
    prevPosition = stage_input.prevPosition;
    multiTexCoord0 = stage_input.multiTexCoord0;
    normalVector = stage_input.normalVector;
    tangentVector = stage_input.tangentVector;
    vert_main();
    SPIRV_Cross_Output stage_output;
    stage_output.gl_Position = gl_Position;
    stage_output.cCur = cCur;
    stage_output.cPrev = cPrev;
    stage_output.viewPos = viewPos;
    stage_output.texCoord = texCoord;
    stage_output.vAlpha = vAlpha;
    stage_output.btnMatrix = btnMatrix;
    return stage_output;
}
