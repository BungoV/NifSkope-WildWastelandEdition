// HLSL port of features/post/taa_objvel.frag (frag shader). Generated by notes/hlslbulk1/tools/convert.py:
// glslang -G, then spirv-cross --hlsl; loose uniforms are the LooseUniforms cbuffer (register b31); the
// GLSL includes are inlined as the loader does. Fusion Shaders (F4FS) feeds it the GL-side inputs
// named in notes/vkcompute1/hlsl_plan.md. Not wired: nothing loads this file.
// profile: ps_6_0
#include "PostBindingsVk.hlsli"
Texture2D<float4> NormalMap : register(t0, space0);
SamplerState _NormalMap_sampler : register(s0, space0);
cbuffer LooseUniforms : register(b31, space0)
{
    float2 uvScale;
    float2 uvOffset;
    bool fxOrtho;	// the colour pass's projectionMatrix[3][3] == 1 (ViewDir = +z)
    float4 falloffParams;	// start angle, stop angle, start opacity, stop opacity (the colour pass's uniform)
    int2 fxDepthOrigin;	// the colour pass's viewportDimensions.xy
    float2 fxProj;	// the colour pass's projectionMatrix[2][2], [3][2]
    float fxDistScale;	// view units -> game units (celllights.cpp)
    float fxSoftDepth;	// game units
    float3 wwGrassFade;
    int alphaTest;
    int covMode;
    int fxMode;
    float alpha;
    float alphaThreshold;
    float covThreshold;
};
Texture2D<float4> fxDepth : register(t1, space0);	// Scene::fxDepthTexId: the opaque pass's depth, the viewport's corner at texel 0
SamplerState _fxDepth_sampler : register(s1, space0);
Texture2D<float4> BaseMap : register(t2, space0);
SamplerState _BaseMap_sampler : register(s2, space0);
Texture2D<float4> GreyscaleMap : register(t3, space0);
SamplerState _GreyscaleMap_sampler : register(s3, space0);

static float4 gl_FragCoord;
static float2 texCoord;
static float3x3 btnMatrix;
static float3 viewPos;
static float vAlpha;
static float4 cCur;
static float4 cPrev;
static float2 vel;
static float4 flag;

struct SPIRV_Cross_Input
{
    float4 cCur : TEXCOORD0;
    float4 cPrev : TEXCOORD1;
    float3 viewPos : TEXCOORD2;
    float2 texCoord : TEXCOORD3;
    float vAlpha : TEXCOORD4;
    float3x3 btnMatrix : TEXCOORD5;
    float4 gl_FragCoord : SV_Position;
};

struct SPIRV_Cross_Output
{
    float2 vel : SV_Target0;
    float4 flag : SV_Target1;
};

// fo4_effectshader.frag's falloff (its normal, V and two lines, unchanged); the back-face flip leaves |N.V| as it is
float fxFalloff()
{
    float3 normal = normalize((NormalMap.Sample(_NormalMap_sampler, (texCoord * uvScale) + uvOffset).xyz * 2.0f) - 1.0f.xxx);
    normal.z = sqrt(max(1.0f - dot(normal.xy, normal.xy), 0.0f));
    float3x3 btn = float3x3(float3(normalize(btnMatrix[0])), float3(normalize(btnMatrix[1])), float3(normalize(btnMatrix[2])));
    normal = normalize(mul(normal, btn));
    float3 VPick;
    if (fxOrtho)
    {
        VPick = float3(0.0f, 0.0f, 1.0f);
    }
    else
    {
        VPick = -viewPos;
    }
    float3 V = normalize(VPick);
    float falloff = smoothstep(falloffParams.x, falloffParams.y, abs(dot(normal, V)));
    return lerp(max(falloffParams.z, 0.0f), min(falloffParams.w, 1.0f), falloff);
}

// fo4_effectshader.frag cellFxFade(), line for line
float fxSoftFade()
{
    float d = fxDepth.Load(int3(int2(gl_FragCoord.xy) - fxDepthOrigin, 0)).x;
    float sceneW = fxProj.y / (fxProj.x + ((2.0f * d) - 1.0f));
    float k = fxDistScale / fxSoftDepth;
    float fragW = 1.0f / gl_FragCoord.w;
    float soft = clamp((sceneW - fragW) * k, 0.0f, 1.0f);
    float t = clamp(((fragW * k) - 0.07500000298023223876953125f) * 2.352941036224365234375f, 0.0f, 1.0f);
    return ((soft * t) * t) * (3.0f - (2.0f * t));
}

void frag_main()
{
    bool cond6 = wwGrassFade.z > 0.5f;
    bool cond5;
    if (cond6)
    {
        cond5 = (length(viewPos) - wwGrassFade.x) >= max(wwGrassFade.y, 0.001000000047497451305389404296875f);
    }
    else
    {
        cond5 = cond6;
    }
    if (cond5)
    {
        discard;
    }
    bool wwh0 = (alphaTest != 0);
    bool wwh1 = (covMode != 0);
    if (or(wwh0, wwh1))   // HLSLFIX2 orfix.py: no short-circuit branch (NV took the wrong side)
    {
        float a = BaseMap.Sample(_BaseMap_sampler, (texCoord * uvScale) + uvOffset).w;
        if (fxMode != 0)
        {
            float k = ((fxMode & 1) != 0) ? vAlpha : 1.0f;
            float fPick;
            if ((fxMode & 8) != 0)
            {
                fPick = fxFalloff();
            }
            else
            {
                fPick = 1.0f;
            }
            float f = fPick;
            float sPick;
            if ((fxMode & 16) != 0)
            {
                sPick = fxSoftFade();
            }
            else
            {
                sPick = 1.0f;
            }
            float s = sPick;
            float aPick;
            if ((fxMode & 2) != 0)
            {
                aPick = GreyscaleMap.SampleLevel(_GreyscaleMap_sampler, float2(a, (((1.0f * f) * k) * alpha) * s), 0.0f).w;
            }
            else
            {
                aPick = (((a * f) * k) * alpha) * s;
            }
            a = aPick;
        }
        else
        {
            a *= alpha;
        }
        // the reactive draw covers the texels the colour pass drops too (the card shows nothing there either)
        if (((alphaTest != 0) && (covMode != 2)) && (a < alphaThreshold))
        {
            discard;
        }
        if ((covMode == 1) && (a < covThreshold))
        {
            discard;
        }
        bool cond4 = covMode == 2;
        bool cond3;
        if (cond4)
        {
            cond3 = !(a < covThreshold);
        }
        else
        {
            cond3 = cond4;
        }
        if (cond3)
        {
            discard;
        }
    }
    bool cond2 = cCur.w <= 0.0f;
    bool cond;
    if (!cond2)
    {
        cond = cPrev.w <= 0.0f;
    }
    else
    {
        cond = cond2;
    }
    if (cond)
    {
        // behind the eye last frame: no usable history
        vel = 0.0f.xx;
    }
    else
    {
        vel = ((cPrev.xy / cPrev.w.xx) - (cCur.xy / cCur.w.xx)) * 0.5f;
    }
    flag = float4(float(covMode == 2), 0.0f, 1.0f, 0.0f);
}

SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
{
    gl_FragCoord = stage_input.gl_FragCoord;
    gl_FragCoord.w = 1.0 / gl_FragCoord.w;
    texCoord = stage_input.texCoord;
    btnMatrix = stage_input.btnMatrix;
    viewPos = stage_input.viewPos;
    vAlpha = stage_input.vAlpha;
    cCur = stage_input.cCur;
    cPrev = stage_input.cPrev;
    frag_main();
    SPIRV_Cross_Output stage_output;
    stage_output.vel = vel;
    stage_output.flag = flag;
    return stage_output;
}
