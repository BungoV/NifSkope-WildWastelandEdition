    cellExtSpec = 0.0f.xxx;
    cellReflAdd = 0.0f.xxx;
    cellSpecTint = 1.0f.xxx;
    cellFoBloomHere = 0.0f.xxx;
    cellBloomGain = 1.0f;
    cellGiPath = 0;
    cellDdgiTwo = false;
    cellDdgiD2 = float3(0.0f, 0.0f, 1.0f);
    cellDdgiThree = false;
    cellDdgiD3 = float3(0.0f, 0.0f, 1.0f);
    cellGiHalfVis = 1.0f.xxx;
    cellGiHalfVis2 = 1.0f.xx;
    cellGiMemoOk = false;
    cellGiMemoP = 0.0f.xxx;
    cellGiMemoN = 0.0f.xxx;
    cellGiMemoS = 0.0f.xxxx;
    cellGiMemoV = float2(1.0f, 0.0f);
    cellGiVisN = float2(1.0f, 0.0f);
    cellGiOneRead = false;
    cellGiSpecV = float2(1.0f, 0.0f);
    cellFarIters = 0;
    if (bloomImpulse.z > 0.0f)
    {
        int2 tmp73 = int2(gl_FragCoord.xy) / int2(2, 2);
        int2 tmp78 = int2(bloomImpulse.xy) / int2(2, 2);
        float3 tmp83;
        if (all(bool2(tmp73.x == tmp78.x, tmp73.y == tmp78.y)))
        {
            tmp83 = bloomImpulse.z.xxx;
        }
        else
        {
            tmp83 = 0.0f.xxx;
        }
        fragColor = float4(tmp83, 1.0f);
        return;
    }
    if ((!cellOn) || (!cellIsOn))
    {
        fragColor = 0.0f.xxxx;
        return;
    }
    float4 x = hdrSrc.Load(int2(gl_FragCoord.xy), gl_SampleID);
    fragColor = float4(max(x.xyz, 0.0f.xxx) * (((cellIsRed & 2) != 0) ? 1.0f : cellIsExposure), 1.0f);
}

SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
{
    gl_FragCoord = stage_input.gl_FragCoord;
    gl_FragCoord.w = 1.0 / gl_FragCoord.w;
    gl_SampleID = stage_input.gl_SampleID;
    frag_main();
    SPIRV_Cross_Output stage_output;
    stage_output.fragColor = fragColor;
    return stage_output;
}
