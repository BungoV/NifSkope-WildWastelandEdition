// HLSL port of features/post/cell_bloom_comb.frag (frag shader). Generated by notes/hlslbulk1/tools/convert.py:
// glslang -G, then spirv-cross --hlsl; loose uniforms are the LooseUniforms cbuffer (register b31); the
// GLSL includes' functions are #included from the shared .hlsli files, the rest is inlined as the loader does. Fusion Shaders (F4FS) feeds it the GL-side inputs
// named in notes/vkcompute1/hlsl_plan.md. Not wired: nothing loads this file.
// profile: ps_6_0
#include "PostBindingsVk.hlsli"
cbuffer LooseUniforms : register(b31, space0)
{
    float2 cellIsFoBloomFrame;	// the frame's size
    float4 cellIsFoBloomParams;	// radius (pixels), bloom weight, dispersion, the Bloom Mip mode (cell_hdr.frag)
};
Texture2D<float4> cellIsFoBloom : register(t0, space0);	// the chain's top (the tone map's own sampler, unit, filter and mips)
SamplerState _cellIsFoBloom_sampler : register(s0, space0);

static float4 gl_FragCoord;
static float4 fragColor;

struct SPIRV_Cross_Input
{
    float4 gl_FragCoord : SV_Position;
};

struct SPIRV_Cross_Output
{
    float4 fragColor : SV_Target0;
};

static uint dummy_parameter;

uint2 spvTextureSize(Texture2D<float4> Tex, uint Level, out uint Param)
{
    uint2 ret;
    Tex.GetDimensions(Level, ret.x, ret.y, Param);
    return ret;
}

// F4FX_SanitizeBloomSample: a NaN tap reads 0 (tested by its bits), anything else clamps to 0..65504
#define WW_FN_bloomSanitize
#include "cell_bloom.hlsli"
#undef WW_FN_bloomSanitize

// lane GAPLOOK1 (BLOOMMIP): the same tent read lod levels down the chain top's own mips (the blur chosen per pixel)
#define WW_FN_bloomTentLod
#define WW_FN_bloomTentDispersedLod
#include "cell_bloom.hlsli"
#undef WW_FN_bloomTentLod
#undef WW_FN_bloomTentDispersedLod

// F4FX_UpsampleTent: 9 taps, 4 / 2 2 2 2 / 1 1 1 1 over 16, at the bloom texel x the radius
#define WW_FN_bloomTent
#include "cell_bloom.hlsli"
#undef WW_FN_bloomTent

// BloomUpCS's dispersion: red and blue tents pushed apart along the radial from the frame's center, green the anchor
#define WW_FN_bloomTentDispersed
#include "cell_bloom.hlsli"
#undef WW_FN_bloomTentDispersed

void frag_main()
{
    float2 uv = (floor(gl_FragCoord.xy) + 0.5f.xx) / cellIsFoBloomFrame;
    float bloomLod = (cellIsFoBloomParams.w < 0.0f) ? 2.0f : 0.0f;
    if (bloomLod > 0.0f)
    {
        float2 param = uv;
        float param_1 = cellIsFoBloomParams.x;
        float param_2 = cellIsFoBloomParams.z;
        float param_3 = bloomLod;
        fragColor = float4(bloomTentDispersedLod(cellIsFoBloom, _cellIsFoBloom_sampler, param, param_1, param_2, param_3), bloomLod);
    }
    else
    {
        float2 param_4 = uv;
        float param_5 = cellIsFoBloomParams.x;
        float param_6 = cellIsFoBloomParams.z;
        fragColor = float4(bloomTentDispersed(cellIsFoBloom, _cellIsFoBloom_sampler, param_4, param_5, param_6), 0.0f);
    }
}

SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
{
    gl_FragCoord = stage_input.gl_FragCoord;
    gl_FragCoord.w = 1.0 / gl_FragCoord.w;
    frag_main();
    SPIRV_Cross_Output stage_output;
    stage_output.fragColor = fragColor;
    return stage_output;
}
