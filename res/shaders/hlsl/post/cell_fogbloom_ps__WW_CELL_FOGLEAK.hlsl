// the density per unit sigma0 at height z (cell_volair.frag airRho)
float wwAirRhoLaw(inout float z, float4 med, float4 layer, float4 ground)
{
    float k = 1.0f;
    if (z > med.w)
    {
        if (ground.z <= 0.0f)
        {
            return 0.0f;
        }
        // G2: the top's density, falling off
        k = exp((-(z - med.w)) * ground.z);
        z = med.w;
    }
    float rPick3;
    if (med.z > 0.0f)
    {
        rPick3 = min(1.0f, exp((-(z - med.y)) * med.z));
    }
    else
    {
        rPick3 = 1.0f;
    }
    float r = rPick3;
    bool cond10 = layer.x <= 0.0f;
    bool cond9;
    if (cond10)
    {
        cond9 = layer.w <= 0.0f;
    }
    else
    {
        cond9 = cond10;
    }
    if (cond9)
    {
        return k * r;
    }
    if (layer.x > 0.0f)
    {
        float rPick2;
        if (layer.z > 0.0f)
        {
            rPick2 = min(1.0f, exp((-(z - layer.y)) * layer.z));
        }
        else
        {
            rPick2 = 1.0f;
        }
        r = ((1.0f - layer.x) * r) + (layer.x * rPick2);
    }
    if (layer.w > 0.0f)
    {
        float rPick;
        if (ground.y > 0.0f)
        {
            rPick = min(1.0f, exp((-(z - ground.x)) * ground.y));
        }
        else
        {
            rPick = 1.0f;
        }
        r += (layer.w * rPick);
    }
    return k * r;
}

