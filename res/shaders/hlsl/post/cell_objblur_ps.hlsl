// HLSL port of features/post/cell_objblur.frag (frag shader). Generated by notes/hlslbulk1/tools/convert.py:
// glslang -G, then spirv-cross --hlsl; loose uniforms are the LooseUniforms cbuffer (register b31); the
// GLSL includes are inlined as the loader does. Fusion Shaders (F4FS) feeds it the GL-side inputs
// named in notes/vkcompute1/hlsl_plan.md. Not wired: nothing loads this file.
// profile: ps_6_0
#include "PostBindingsVk.hlsli"
Texture2D<float4> depthTex : register(t0, space0);
SamplerState _depthTex_sampler : register(s0, space0);
cbuffer LooseUniforms : register(b31, space0)
{
    float zFar;
    float zNear;
    int tile;
    float noiseSeed;
    int samples;
};
Texture2D<float4> colTex : register(t1, space0);
SamplerState _colTex_sampler : register(s1, space0);
Texture2D<float4> neighTex : register(t2, space0);
SamplerState _neighTex_sampler : register(s2, space0);
Texture2D<float4> blurTex : register(t3, space0);
SamplerState _blurTex_sampler : register(s3, space0);

static float4 gl_FragCoord;
static float4 fragColor;

struct SPIRV_Cross_Input
{
    float4 gl_FragCoord : SV_Position;
};

struct SPIRV_Cross_Output
{
    float4 fragColor : SV_Target0;
};

static uint dummy_parameter;

uint2 spvTextureSize(Texture2D<float4> Tex, uint Level, out uint Param)
{
    uint2 ret;
    Tex.GetDimensions(Level, ret.x, ret.y, Param);
    return ret;
}

float dist(int2 p)
{
    float x = 1.0f - depthTex.Load(int3(p, 0)).x;
    return (zFar * zNear) / ((x * (zFar - zNear)) + zNear);
}

float front(float za, float zb, float k)
{
    return clamp(1.0f - ((za - zb) / k), 0.0f, 1.0f);
}

float reach(float d, float r)
{
    return clamp((r + 0.5f) - d, 0.0f, 1.0f);
}

void frag_main()
{
    int2 X = int2(gl_FragCoord.xy);
    int2 sz = int2(spvTextureSize(colTex, uint(0), dummy_parameter));
    float4 cX = colTex.Load(int3(X, 0));
    // radius: half the shutter's travel each side
    float2 vn = neighTex.Load(int3(X / tile.xx, 0)).xy * 0.5f;
    float ln = length(vn);
    if (ln < 0.5f)
    {
        fragColor = cX;
        return;
    }
    // the span reaches the half pixel the last covered pixel overhangs
    float2 vs = vn * ((ln + 0.5f) / ln);
    float rx = length(blurTex.Load(int3(X, 0)).xy) * 0.5f;
    int2 pArg2 = X;
    float zx = dist(pArg2);
    float k = max(0.0199999995529651641845703125f * zx, 1.0f);
    float wsum = 1.0f;
    float4 sum = cX;
    float j = frac(52.98291778564453125f * frac(dot(gl_FragCoord.xy, float2(0.067110560834407806396484375f, 0.005837149918079376220703125f)) + noiseSeed)) - 0.5f;
    int n = max(samples, 2);
    float aPick;
    for (int i = 0; i < n; i++)
    {
        float t = lerp(-1.0f, 1.0f, ((float(i) + j) + 1.0f) / float(n + 1));
        int2 Y = clamp(int2(floor((float2(X) + 0.5f.xx) + (vs * t))), int2(0, 0), sz - int2(1, 1));
        float d = length(float2(Y - X));
        float ry = length(blurTex.Load(int3(Y, 0)).xy) * 0.5f;
        int2 pArg = Y;
        float zy = dist(pArg);
        float zaArg2 = zy;
        float zbArg2 = zx;
        float kArg2 = k;
        float yf = front(zaArg2, zbArg2, kArg2);
        float zaArg = zx;
        float zbArg = zy;
        float kArg = k;
        float xf = front(zaArg, zbArg, kArg);
        float same = yf * xf;
        float rm = max(rx, ry);
        if (rm < 0.5f)
        {
            aPick = 1.0f;
        }
        else
        {
            float dArg3 = d;
            float rArg3 = rm;
            aPick = reach(dArg3, rArg3);
        }
        float dArg2 = d;
        float rArg2 = ry;
        float dArg = d;
        float rArg = rx;
        float a = ((same * aPick) + ((yf - same) * reach(dArg2, rArg2))) + ((xf - same) * reach(dArg, rArg));
        wsum += a;
        sum += (colTex.Load(int3(Y, 0)) * a);
    }
    fragColor = sum / wsum.xxxx;
}

SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
{
    gl_FragCoord = stage_input.gl_FragCoord;
    gl_FragCoord.w = 1.0 / gl_FragCoord.w;
    frag_main();
    SPIRV_Cross_Output stage_output;
    stage_output.fragColor = fragColor;
    return stage_output;
}
