// HLSL port of features/post/cell_bloom_down.frag (frag shader). Generated by notes/hlslbulk1/tools/convert.py:
// glslang -G, then spirv-cross --hlsl; loose uniforms are the LooseUniforms cbuffer (register b31); the
// GLSL includes' functions are #included from the shared .hlsli files, the rest is inlined as the loader does. Fusion Shaders (F4FS) feeds it the GL-side inputs
// named in notes/vkcompute1/hlsl_plan.md. Not wired: nothing loads this file.
// profile: ps_6_0
#include "PostBindingsVk.hlsli"
cbuffer LooseUniforms : register(b31, space0)
{
    float2 bloomDst;	// this mip's size
    float4 bloomParams;	// threshold, soft knee, prefilter (level 0), scale (1)
    int bloomRed;	// 1: level 0 a plain box, no Karis average
};
Texture2D<float4> bloomSrc : register(t0, space0);	// the resolved source (level 0) or the previous mip, linear, clamped
SamplerState _bloomSrc_sampler : register(s0, space0);

static float4 gl_FragCoord;
static float4 fragColor;

struct SPIRV_Cross_Input
{
    float4 gl_FragCoord : SV_Position;
};

struct SPIRV_Cross_Output
{
    float4 fragColor : SV_Target0;
};

static uint dummy_parameter;

uint2 spvTextureSize(Texture2D<float4> Tex, uint Level, out uint Param)
{
    uint2 ret;
    Tex.GetDimensions(Level, ret.x, ret.y, Param);
    return ret;
}

// F4FX_SanitizeBloomSample: a NaN tap reads 0 (tested by its bits), anything else clamps to 0..65504
#define WW_FN_bloomSanitize
#include "cell_bloom.hlsli"
#undef WW_FN_bloomSanitize

// F4FX_Luminance
float bloomLuma(float3 c)
{
    return max(dot(c, float3(0.2125999927520751953125f, 0.715200006961822509765625f, 0.072200000286102294921875f)), 9.9999997473787516355514526367188e-05f);
}

// F4FX_BloomThresholdWeight
float bloomThresholdWeight(inout float luminance, inout float threshold, float softKnee)
{
    luminance = max(luminance, 0.0f);
    if (luminance <= 9.9999997473787516355514526367188e-05f)
    {
        return 0.0f;
    }
    threshold = max(threshold, 0.0f);
    float knee = threshold * max(softKnee, 0.0f);
    float hard = luminance - threshold;
    float contribution = max(hard, 0.0f);
    if (knee > 9.9999997473787516355514526367188e-05f)
    {
        float soft = clamp(hard + knee, 0.0f, 2.0f * knee);
        contribution = max(contribution, (soft * soft) / (4.0f * knee));
    }
    return clamp(contribution / luminance, 0.0f, 1.0f);
}

void frag_main()
{
    float2 uv = (floor(gl_FragCoord.xy) + 0.5f.xx) / bloomDst;
    float2 texel = 1.0f.xx / float2(max(int2(spvTextureSize(bloomSrc, uint(0), dummy_parameter)), int2(1, 1)));
    float prefilter = clamp(bloomParams.z, 0.0f, 1.0f);
    float karis = (bloomRed == 1) ? 0.0f : prefilter;
    float3 cArg6 = bloomSrc.SampleLevel(_bloomSrc_sampler, uv + (texel * (-0.5f).xx), 0.0f).xyz;
    float3 taps[4];
    taps[0] = bloomSanitize(cArg6);
    float3 cArg5 = bloomSrc.SampleLevel(_bloomSrc_sampler, uv + (texel * float2(0.5f, -0.5f)), 0.0f).xyz;
    taps[1] = bloomSanitize(cArg5);
    float3 cArg4 = bloomSrc.SampleLevel(_bloomSrc_sampler, uv + (texel * float2(-0.5f, 0.5f)), 0.0f).xyz;
    taps[2] = bloomSanitize(cArg4);
    float3 cArg3 = bloomSrc.SampleLevel(_bloomSrc_sampler, uv + (texel * 0.5f.xx), 0.0f).xyz;
    taps[3] = bloomSanitize(cArg3);
    float3 color = 0.0f.xxx;
    float weightSum = 0.0f;
    for (int t = 0; t < 4; t++)
    {
        float3 cArg2 = taps[t];
        float w = lerp(1.0f, 1.0f / (1.0f + bloomLuma(cArg2)), karis);
        color += (taps[t] * w);
        weightSum += w;
    }
    color /= max(weightSum, 9.9999997473787516355514526367188e-05f).xxx;
    float3 cArg = color;
    float luminanceArg = bloomLuma(cArg);
    float thresholdArg = bloomParams.x;
    float softKneeArg = bloomParams.y;
    float bloomThresholdWeightRet = bloomThresholdWeight(luminanceArg, thresholdArg, softKneeArg);
    float extract = lerp(1.0f, bloomThresholdWeightRet, prefilter);
    fragColor = float4((color * extract) * max(bloomParams.w, 0.0f), 1.0f);
}

SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
{
    gl_FragCoord = stage_input.gl_FragCoord;
    gl_FragCoord.w = 1.0 / gl_FragCoord.w;
    frag_main();
    SPIRV_Cross_Output stage_output;
    stage_output.fragColor = fragColor;
    return stage_output;
}
