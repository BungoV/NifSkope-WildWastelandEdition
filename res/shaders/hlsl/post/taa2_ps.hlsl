}

// Jimenez 2016: Catmull-Rom from 5 bilinear taps (the four corner taps dropped, weights renormalised)
float3 histCatmullRom(float2 uv)
{
    float2 size = 1.0f.xx / invSize;
    float2 pos = uv * size;
    float2 tc = floor(pos - 0.5f.xx) + 0.5f.xx;
    float2 f = pos - tc;
    float2 w0 = f * ((-0.5f).xx + (f * (1.0f.xx - (f * 0.5f))));
    float2 w1 = 1.0f.xx + ((f * f) * ((-2.5f).xx + (f * 1.5f)));
    float2 w2 = f * (0.5f.xx + (f * (2.0f.xx - (f * 1.5f))));
    float2 w3 = (f * f) * ((-0.5f).xx + (f * 0.5f));
    float2 w12 = w1 + w2;
    float2 t0 = (tc - 1.0f.xx) * invSize;
    float2 t3 = (tc + 2.0f.xx) * invSize;
    float2 t12 = (tc + (w2 / w12)) * invSize;
    float a = w12.x * w0.y;
    float b = w0.x * w12.y;
    float c = w12.x * w12.y;
    float d = w3.x * w12.y;
    float e = w12.x * w3.y;
    float3 r = ((((histTex.Sample(_histTex_sampler, float2(t12.x, t0.y)).xyz * a) + (histTex.Sample(_histTex_sampler, float2(t0.x, t12.y)).xyz * b)) + (histTex.Sample(_histTex_sampler, t12).xyz * c)) + (histTex.Sample(_histTex_sampler, float2(t3.x, t12.y)).xyz * d)) + (histTex.Sample(_histTex_sampler, float2(t12.x, t3.y)).xyz * e);
    return max(r / ((((a + b) + c) + d) + e).xxx, 0.0f.xxx);
}

// the history pulled along the line toward c (inside the box) until it is inside the box
float3 clipToward(float3 h, float3 c, float3 mn, float3 mx)
{
    float3 dir = h - c;
    float3 lim = lerp(mn, mx, step(0.0f.xxx, dir)) - c;
    float3 t = 1.0f.xxx;
    for (int i = 0; i < 3; i++)
    {
        if (abs(dir[i]) > 1.0000000116860974230803549289703e-07f)
        {
            t[i] = clamp(lim[i] / dir[i], 0.0f, 1.0f);
        }
    }
    return c + (dir * min(t.x, min(t.y, t.z)));
}

float3 toRgb(float3 y)
{
    return float3((y.x + y.y) - y.z, y.x + y.z, (y.x - y.y) - y.z);
}

float3 tonemapOut(inout float3 t)
{
    t = clamp(t, 0.0f.xxx, 0.999000012874603271484375f.xxx);
    return t / ((1.0f - max(t.x, max(t.y, t.z))) * max(taa2Expose, 9.9999999747524270787835121154785e-07f)).xxx;
}

