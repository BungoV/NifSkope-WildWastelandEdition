// Karis 2014: the resolve runs on c / (1 + max(c)), so one bright sample cannot take the box or the blend over
float3 tonemapIn(inout float3 c)
{
    if (taa2Linear == 0)
    {
        return c;
    }
    c = max(c, 0.0f.xxx) * taa2Expose;
    return c / (1.0f + max(c.x, max(c.y, c.z))).xxx;
}

