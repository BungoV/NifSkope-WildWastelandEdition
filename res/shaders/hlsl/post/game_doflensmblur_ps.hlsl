        float param_3 = (cf - 1.0f) / 3.0f;
        m = lerp(a.xyz, t2.Sample(_t2_sampler, uq).xyz, lensSat(param_3).xxx);
    }
    if (lensQ.y != 0.0f)
    {
        float4 n = lensNear.Sample(_lensNear_sampler, uq);
        if (n.w > 0.0f)
        {
            m = (m * (1.0f - n.w)) + n.xyz;
        }
    }
    return float4(m, a.w);
}

// game_dof.frag's composite at one texel
