    float param = t3.Load(int3(p, 0)).x;
    float param_1 = lensDist(param);
    float param_2 = lensS1;
    float cf = lensCoc(param_1, param_2);
    float2 uq = (float2(p) + 0.5f.xx) / (float2(int2(spvTextureSize(t2, uint(0), dummy_parameter))) * 4.0f);
    float3 m = a.xyz;
    if (cf > 1.0f)
