// HLSL port of features/post/game_doflensmblur.frag (frag shader). Generated by notes/hlslbulk1/tools/convert.py:
// glslang -G, then spirv-cross --hlsl; loose uniforms are the LooseUniforms cbuffer (register b31); the
// GLSL includes' functions are #included from the shared .hlsli files, the rest is inlined as the loader does. Fusion Shaders (F4FS) feeds it the GL-side inputs
// named in notes/vkcompute1/hlsl_plan.md. Not wired: nothing loads this file.
// profile: ps_6_0
#include "PostBindingsVk.hlsli"
cbuffer LooseUniforms : register(b31, space0)
{
    float4 lz;
    float4 lensP;
    float4 lensQ;
    float4 dc2;
    int farOnly;
    float4 dc0;
    float4 dc1;
    int dofRed;
    float4 dc3;
    float4 mc0;
    float4 mc1;
};
Texture2D<float4> t0 : register(t0, space0);
SamplerState _t0_sampler : register(s0, space0);
Texture2D<float4> t3 : register(t1, space0);
SamplerState _t3_sampler : register(s1, space0);
Texture2D<float4> t2 : register(t2, space0);
SamplerState _t2_sampler : register(s2, space0);
Texture2D<float4> lensNear : register(t3, space0);	// the near layer, premultiplied (rgb * a, a)
SamplerState _lensNear_sampler : register(s3, space0);
Texture2D<float4> t1 : register(t4, space0);
SamplerState _t1_sampler : register(s4, space0);

static float4 gl_FragCoord;
static float4 fragColor;

struct SPIRV_Cross_Input
{
    float4 gl_FragCoord : SV_Position;
};

struct SPIRV_Cross_Output
{
    float4 fragColor : SV_Target0;
};

static float lensS1;

static uint dummy_parameter;

uint2 spvTextureSize(Texture2D<float4> Tex, uint Level, out uint Param)
{
    uint2 ret;
    Tex.GetDimensions(Level, ret.x, ret.y, Param);
    return ret;
}

// the view distance of a window depth; < 0 = the sky (no geometry)
#define WW_FN_lensDist
#include "game_doflens.hlsli"
#undef WW_FN_lensDist

// the focus distance: the record's, or the distance at the frame's centre (autofocus)
#define WW_FN_lensFocus
#include "game_doflens.hlsli"
#undef WW_FN_lensFocus

float2 V(float2 d)
{
    return float2(d.x, 1.0f - d.y);
}

float2 mvAt(float2 d)
{
    float2 dArg = d;
    float2 m = t1.Sample(_t1_sampler, V(dArg)).xy;
    return float2(m.x, -m.y);
}

float sat(float v)
{
    float satRet;
    if (v >= 0.0f)
    {
        satRet = min(v, 1.0f);
    }
    else
    {
        satRet = 0.0f;
    }
    return satRet;
}

// the signed circle of confusion (px) at view distance z (< 0 = the sky), focus s1
#define WW_FN_lensCoc
#define WW_FN_lensSat
#include "game_doflens.hlsli"
#undef WW_FN_lensCoc
#undef WW_FN_lensSat

// the lens composite at one full-size texel: the sharp frame, the far layer where the circle passes 1 px, the near
// layer over both; an in-focus texel with no near neighbour is the frame bit for bit
float4 lensTexel(int2 p)
{
    float4 a = t0.Load(int3(p, 0));
    float dArg2 = t3.Load(int3(p, 0)).x;
    float zArg = lensDist(dArg2);
    float s1Arg = lensS1;
    float cf = lensCoc(zArg, s1Arg);
    float2 uq = (float2(p) + 0.5f.xx) / (float2(int2(spvTextureSize(t2, uint(0), dummy_parameter))) * 4.0f);
    float3 m = a.xyz;
    if (cf > 1.0f)
    {
        float vArg = (cf - 1.0f) / 3.0f;
        m = lerp(a.xyz, t2.Sample(_t2_sampler, uq).xyz, lensSat(vArg).xxx);
    }
    if (lensQ.y != 0.0f)
    {
        float4 n = lensNear.Sample(_lensNear_sampler, uq);
        if (n.w > 0.0f)
        {
            m = (m * (1.0f - n.w)) + n.xyz;
        }
    }
    return float4(m, a.w);
}

// game_dof.frag's composite at one texel
float4 dofTexel(int2 p, float2 size)
{
    int2 pArg = p;
    return lensTexel(pArg);
}

float tapW(float2 m, float L)
{
    float l = sqrt(dot(m, m));
    float vArg2 = ((-abs(L - l)) * mc0.z) + 1.0f;
    return sat(vArg2);
}

// the composite read as a linear filter reads its target at uv (clamped to the edge)
float3 dofAt(float2 uv, float2 size)
{
    float2 x = (uv * size) - 0.5f.xx;
    float2 i0 = floor(x);
    float2 f = x - i0;
    int2 lo = int2(i0);
    int2 hi = min((lo + int2(1, 1)), (int2(size) - int2(1, 1)));
    lo = max(lo, int2(0, 0));
    hi = max(hi, int2(0, 0));
    int2 pArg5 = lo;
    float2 sizeArg4 = size;
    float3 r = dofTexel(pArg5, sizeArg4).xyz * ((1.0f - f.x) * (1.0f - f.y));
    if (f.x > 0.0f)
    {
        int2 pArg4 = int2(hi.x, lo.y);
        float2 sizeArg3 = size;
        r += (dofTexel(pArg4, sizeArg3).xyz * (f.x * (1.0f - f.y)));
    }
    if (f.y > 0.0f)
    {
        int2 pArg3 = int2(lo.x, hi.y);
        float2 sizeArg2 = size;
        r += (dofTexel(pArg3, sizeArg2).xyz * ((1.0f - f.x) * f.y));
        if (f.x > 0.0f)
        {
            int2 pArg2 = hi;
            float2 sizeArg = size;
            r += (dofTexel(pArg2, sizeArg).xyz * (f.x * f.y));
        }
    }
    return r;
}

void frag_main()
{
    lensS1 = 0.0f;
    lensS1 = lensFocus(t3, _t3_sampler);
    float2 size = float2(int2(spvTextureSize(t0, uint(0), dummy_parameter)));
    float2 g = gl_FragCoord.xy / size;
    float2 dArg12 = g;
    float2 v1 = V(dArg12);
    float2 dArg11 = v1;
    float2 m = mvAt(dArg11);
    float l2 = dot(m, m);
    float L = sqrt(l2);
    float2 dc = v1 - mc1.zw;
    float rr = sqrt(dot(dc, dc));
    float vArg3 = (rr * 0.100000001490116119384765625f) + (-0.017999999225139617919921875f);
    rr = sat(vArg3);
    rr = L * rr;
    if (rr < 0.001000000047497451305389404296875f)
    {
        int2 pArg6 = int2(gl_FragCoord.xy);
        float2 sizeArg9 = size;
        fragColor = dofTexel(pArg6, sizeArg9);
        return;
    }
    float2 dir = m * rsqrt(l2);
    float len = min(rr, mc0.y);
    dir *= len;
    dir *= mc0.x;
    float2 p0 = min(v1, mc1.xy);
    float2 dArg10 = p0;
    float2 mArg4 = mvAt(dArg10);
    float LArg4 = L;
    float w0 = tapW(mArg4, LArg4);
    float2 dArg9 = p0;
    float2 uvArg4 = V(dArg9);
    float2 sizeArg8 = size;
    float3 col = dofAt(uvArg4, sizeArg8);
    float4 p12 = min((dir.xyxy * float4(0.25f, 0.25f, 0.5f, 0.5f)) + v1.xyxy, mc1.xyxy);
    float2 dArg8 = p12.xy;
    float2 mArg3 = mvAt(dArg8);
    float LArg3 = L;
    float w1 = tapW(mArg3, LArg3);
    float ws = w0 + w1;
    float2 dArg7 = p12.xy;
    float2 uvArg3 = V(dArg7);
    float2 sizeArg7 = size;
    float3 c1t = dofAt(uvArg3, sizeArg7) * w1;
    col = (col * w0) + c1t;
    float2 dArg6 = p12.zw;
    float2 mArg2 = mvAt(dArg6);
    float LArg2 = L;
    float w2 = tapW(mArg2, LArg2);
    ws = w2 + ws;
    float2 dArg5 = p12.zw;
    float2 uvArg2 = V(dArg5);
    float2 sizeArg6 = size;
    col = (dofAt(uvArg2, sizeArg6) * w2) + col;
    float2 p3 = min((dir * 0.75f) + v1, mc1.xy);
    float2 dArg4 = p3;
    float2 mArg = mvAt(dArg4);
    float LArg = L;
    float w3 = tapW(mArg, LArg);
    ws = w3 + ws;
    float2 dArg3 = p3;
    float2 uvArg = V(dArg3);
    float2 sizeArg5 = size;
    col = (dofAt(uvArg, sizeArg5) * w3) + col;
    ws += 0.001000000047497451305389404296875f;
    fragColor = float4(col / ws.xxx, 1.0f);
}

SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
{
    gl_FragCoord = stage_input.gl_FragCoord;
    gl_FragCoord.w = 1.0 / gl_FragCoord.w;
    frag_main();
    SPIRV_Cross_Output stage_output;
    stage_output.fragColor = fragColor;
    return stage_output;
}
