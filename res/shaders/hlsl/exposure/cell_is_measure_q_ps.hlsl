// glslang -G, then spirv-cross --hlsl; loose uniforms are the LooseUniforms cbuffer (register b31); the
// GLSL includes are inlined as the loader does. Fusion Shaders (F4FS) feeds it the GL-side inputs
// named in notes/vkcompute1/hlsl_plan.md. Not wired: nothing loads this file.
// profile: ps_6_0
#include "ExposureBindingsVk.hlsli"
Texture2DMS<float4> hdrSrc : register(t0, space0);
SamplerState _hdrSrc_sampler : register(s0, space0);
Texture2DMS<uint4> hdrStencil : register(t1, space0);
SamplerState _hdrStencil_sampler : register(s1, space0);
cbuffer LooseUniforms : register(b31, space0)
{
    int hdrSamples;
};

static float4 gl_FragCoord;
static float4 fragColor;

struct SPIRV_Cross_Input
{
    float4 gl_FragCoord : SV_Position;
};

struct SPIRV_Cross_Output
{
    float4 fragColor : SV_Target0;
};

static uint dummy_parameter;

uint2 spvTextureSize(Texture2DMS<float4> Tex, uint Level, out uint Param)
{
    uint2 ret;
    Tex.GetDimensions(ret.x, ret.y, Param);
    return ret;
}

float finiteOr0(float v)
{
    bool cond = isnan(v);
    bool finiteOr0Ret;
    if (!cond)
    {
        finiteOr0Ret = isinf(v);
    }
    else
    {
        finiteOr0Ret = cond;
    }
    return finiteOr0Ret ? 0.0f : v;
}

void frag_main()
{
    int2 size = int2(spvTextureSize(hdrSrc, 0u, dummy_parameter));
    int2 base = int2(gl_FragCoord.xy) * int2(4, 4);
    float3 sum = 0.0f.xxx;
    float cover = 0.0f;
    for (int y = 0; y < 4; y++)
    {
        for (int x = 0; x < 4; x++)
        {
            int2 p = base + int2(x, y);
            bool cond3 = p.x >= size.x;
            bool cond2;
            if (!cond3)
            {
                cond2 = p.y >= size.y;
            }
            else
            {
                cond2 = cond3;
            }
            if (cond2)
            {
                continue;
            }
            if ((hdrStencil.Load(p, 0).x & 3u) != 1u)
            {
                continue;
            }
            float3 px = 0.0f.xxx;
            for (int i = 0; i < hdrSamples; i++)
            {
                float3 v = hdrSrc.Load(p, i).xyz;
                float vArg3 = v.x;
                float vArg2 = v.y;
                float vArg = v.z;
                px += float3(finiteOr0(vArg3), finiteOr0(vArg2), finiteOr0(vArg));
            }
            sum += (px / float(max(hdrSamples, 1)).xxx);
            cover += 1.0f;
        }
    }
    fragColor = float4(sum / 16.0f.xxx, cover / 16.0f);
}

SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
{
    gl_FragCoord = stage_input.gl_FragCoord;
    gl_FragCoord.w = 1.0 / gl_FragCoord.w;
    frag_main();
    SPIRV_Cross_Output stage_output;
    stage_output.fragColor = fragColor;
    return stage_output;
}
