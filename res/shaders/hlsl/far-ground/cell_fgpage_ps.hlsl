// HLSL port of features/far-ground/cell_fgpage.frag (frag shader). Generated by notes/hlslbulk1/tools/convert.py:
// glslang -G, then spirv-cross --hlsl; loose uniforms are the LooseUniforms cbuffer (register b31); the
// GLSL includes' functions are #included from the shared .hlsli files, the rest is inlined as the loader does. Fusion Shaders (F4FS) feeds it the GL-side inputs
// named in notes/vkcompute1/hlsl_plan.md. Not wired: nothing loads this file.
// profile: ps_6_0
#include "FarGroundBindingsVk.hlsli"
cbuffer LooseUniforms : register(b31, space0)
{
    float4 fgGridMap;	// origin x, y (world), 1 / sample spacing, LTEX tiling (world units a repeat)
    float2 fgGridN;
    float4 fgBinMap;	// origin x, y, 1 / bin size, the atlas' last mip
    float4 fgBinN;	// bins x, y, the bins' first texel, the ids' first texel
    float fgStampSide;
    float2 fgStampCell;	// the page's cell origin, world
    int fgPageDecals;	// red WW_CELL_FARGROUND_RED=nodecals: 0
    int fgMode;	// 0 = the sheet (the twin's uniforms not set), else the live ground
    int fgDecalsOn;	// red WW_CELL_FARGROUND_RED=nodecals: 0
};
Texture2D<uint4> fgGrid : register(t0, space0);	// per .lodl sample: ids 0|1, ids 2|3, weights unorm8 x4, colour RGB8 + page
SamplerState _fgGrid_sampler : register(s0, space0);
Texture2DArray<float4> fgLtex : register(t1, space0);
SamplerState _fgLtex_sampler : register(s1, space0);
Buffer<float4> fgDecal : register(t2, space0);
Texture2D<float4> fgAtlas : register(t3, space0);
SamplerState _fgAtlas_sampler : register(s3, space0);
Texture2D<float4> fgHeight : register(t4, space0);	// the .lodl heights, a texel a sample
SamplerState _fgHeight_sampler : register(s4, space0);

static float4 gl_FragCoord;
static float4 fragColor;

struct SPIRV_Cross_Input
{
    float4 gl_FragCoord : SV_Position;
};

struct SPIRV_Cross_Output
{
    float4 fragColor : SV_Target0;
};

uint spvPackUnorm4x8(float4 value)
{
    uint4 Packed = uint4(round(saturate(value) * 255.0));
    return Packed.x | (Packed.y << 8) | (Packed.z << 16) | (Packed.w << 24);
}

float4 spvUnpackUnorm4x8(uint value)
{
    uint4 Packed = uint4(value & 0xff, (value >> 8) & 0xff, (value >> 16) & 0xff, value >> 24);
    return float4(Packed) / 255.0;
}

#define WW_FN_fgSplat
#define WW_FN_fgQrot
#include "cell_farground.hlsli"
#undef WW_FN_fgSplat
#undef WW_FN_fgQrot

// the decals over world point w, premultiplied, composited in record order; pix = world units a pixel
#define WW_FN_fgDecals
#include "cell_farground.hlsli"
#undef WW_FN_fgDecals

void frag_main()
{
    float texel = 4096.0f / fgStampSide;
    float2 w = fgStampCell + (gl_FragCoord.xy * texel);
    float2 wArg2 = w;
    float2 wdxArg = float2(texel, 0.0f);
    float2 wdyArg = float2(0.0f, texel);
    float3 col = fgSplat(wArg2, wdxArg, wdyArg);
    if (fgPageDecals != 0)
    {
        float2 g = (w - fgGridMap.xy) * fgGridMap.z;
        float z = fgHeight.Sample(_fgHeight_sampler, (g + 0.5f.xx) / fgGridN).x;
        float3 wArg = float3(w, z);
        float pixArg = texel;
        float4 d = fgDecals(wArg, pixArg);
        col = (col * (1.0f - d.w)) + d.xyz;
    }
    fragColor = float4(col, 1.0f);
}

SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
{
    gl_FragCoord = stage_input.gl_FragCoord;
    gl_FragCoord.w = 1.0 / gl_FragCoord.w;
    frag_main();
    SPIRV_Cross_Output stage_output;
    stage_output.fragColor = fragColor;
    return stage_output;
}
