uint spvPackUnorm4x8(float4 value)
{
    uint4 Packed = uint4(round(saturate(value) * 255.0));
    return Packed.x | (Packed.y << 8) | (Packed.z << 16) | (Packed.w << 24);
}

float4 spvUnpackUnorm4x8(uint value)
{
    uint4 Packed = uint4(value & 0xff, (value >> 8) & 0xff, (value >> 16) & 0xff, value >> 24);
    return float4(Packed) / 255.0;
}

float3 fgSplat(float2 w, float2 wdx, float2 wdy)
{
    float2 g = (w - fgGridMap.xy) * fgGridMap.z;
    float2 g0 = floor(g);
    float2 f = g - g0;
    float2 uv = w / fgGridMap.w.xx;
    float2 dx = wdx / fgGridMap.w.xx;
    float2 dy = wdy / fgGridMap.w.xx;
    int2 n = int2(fgGridN);
    float3 acc = 0.0f.xxx;
    float3 vc = 0.0f.xxx;
    float tmp133;
    float tmp148;
    float3 tmp227;
    for (int c = 0; c < 4; c++)
    {
        int2 o = int2(c & 1, c >> 1);
        int2 p = clamp(int2(g0) + o, int2(0, 0), n - int2(1, 1));
        if (o.x == 1)
        {
            tmp133 = f.x;
        }
        else
        {
            tmp133 = 1.0f - f.x;
        }
        if (o.y == 1)
        {
            tmp148 = f.y;
        }
        else
        {
            tmp148 = 1.0f - f.y;
        }
        float bw = tmp133 * tmp148;
        uint4 s = fgGrid.Load(int3(p, 0));
        vc += (spvUnpackUnorm4x8(s.w).xyz * bw);
        if (bw <= 0.0f)
        {
            continue;
        }
        float4 wt = spvUnpackUnorm4x8(s.z);
        uint tmp206[4] = { s.x & 65535u, s.x >> uint(16), s.y & 65535u, s.y >> uint(16) };
        uint id[4] = tmp206;
        for (int k = 0; k < 4; k++)
        {
            if (wt[k] <= 0.0f)
            {
                continue;
            }
            if (id[k] == 65535u)
            {
                tmp227 = 0.5f.xxx;
            }
            else
            {
                tmp227 = fgLtex.SampleGrad(_fgLtex_sampler, float3(uv, float(id[k])), dx, dy).xyz;
            }
            float3 t = tmp227;
            acc += (t * (bw * wt[k]));
        }
    }
    return acc * vc;
}

float3 fgQrot(float4 q, float3 v)
{
    return v + (cross(q.xyz, cross(q.xyz, v) + (v * q.w)) * 2.0f);
}

// the decals over world point w, premultiplied, composited in record order; pix = world units a pixel
float4 fgDecals(float3 w, float pix)
{
    int2 b = int2(floor((w.xy - fgBinMap.xy) * fgBinMap.z));
    int2 bn = int2(fgBinN.xy);
    bool tmp288 = b.x < 0;
    bool tmp295;
    if (!tmp288)
    {
        tmp295 = b.y < 0;
    }
    else
    {
        tmp295 = tmp288;
    }
    bool tmp304;
    if (!tmp295)
    {
        tmp304 = b.x >= bn.x;
    }
    else
    {
        tmp304 = tmp295;
    }
    bool tmp313;
    if (!tmp304)
    {
        tmp313 = b.y >= bn.y;
    }
    else
    {
        tmp313 = tmp304;
    }
    if (tmp313)
    {
        return 0.0f.xxxx;
    }
    float4 bin = fgDecal.Load((int(fgBinN.z) + (b.y * bn.x)) + b.x);
    int start = int(bin.x);
    int cnt = int(bin.y);
    float4 acc = 0.0f.xxxx;
    for (int i = 0; i < cnt; i++)
    {
        int k = start + i;
        int r = int(fgDecal.Load(int(fgBinN.w) + (k >> 2))[k & 3]) * 5;
        float4 ps = fgDecal.Load(r);
        float4 q = fgDecal.Load(r + 1);
        float4 b0 = fgDecal.Load(r + 2);
        float4 b1 = fgDecal.Load(r + 3);
        float4 param = float4(-q.xyz, q.w);
        float3 param_1 = w - ps.xyz;
        float3 l = fgQrot(param, param_1) / ps.w.xxx;
        bool tmp426 = l.x < b0.x;
        bool tmp435;
        if (!tmp426)
        {
            tmp435 = l.x > b0.z;
        }
        else
        {
            tmp435 = tmp426;
        }
        bool tmp444;
        if (!tmp435)
        {
            tmp444 = l.y < b0.y;
        }
        else
        {
            tmp444 = tmp435;
        }
        bool tmp453;
        if (!tmp444)
        {
            tmp453 = l.y > b0.w;
        }
        else
        {
            tmp453 = tmp444;
        }
        bool tmp462;
        if (!tmp453)
        {
            tmp462 = l.z < b1.x;
        }
        else
        {
            tmp462 = tmp453;
        }
        bool tmp471;
        if (!tmp462)
        {
            tmp471 = l.z > b1.y;
        }
        else
        {
            tmp471 = tmp462;
        }
        if (tmp471)
        {
            continue;
        }
        float4 at = fgDecal.Load(r + 4);
        float2 uv = float2((l.x - b0.x) / (b0.z - b0.x), (b0.w - l.y) / (b0.w - b0.y));
        float lod = clamp(log2(max(1.0f, pix / (b1.z * ps.w))), 0.0f, fgBinMap.w);
        float4 c = fgAtlas.SampleLevel(_fgAtlas_sampler, lerp(at.xy, at.zw, uv), lod);
        acc = float4(c.xyz * c.w, c.w) + (acc * (1.0f - c.w));
    }
    return acc;
}

void frag_main()
{
    float texel = 4096.0f / fgStampSide;
    float2 w = fgStampCell + (gl_FragCoord.xy * texel);
    float2 param = w;
    float2 param_1 = float2(texel, 0.0f);
    float2 param_2 = float2(0.0f, texel);
    float3 col = fgSplat(param, param_1, param_2);
    if (fgPageDecals != 0)
    {
        float2 g = (w - fgGridMap.xy) * fgGridMap.z;
        float z = fgHeight.Sample(_fgHeight_sampler, (g + 0.5f.xx) / fgGridN).x;
        float3 param_3 = float3(w, z);
        float param_4 = texel;
        float4 d = fgDecals(param_3, param_4);
        col = (col * (1.0f - d.w)) + d.xyz;
    }
    fragColor = float4(col, 1.0f);
}

SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
{
    gl_FragCoord = stage_input.gl_FragCoord;
    gl_FragCoord.w = 1.0 / gl_FragCoord.w;
    frag_main();
    SPIRV_Cross_Output stage_output;
    stage_output.fragColor = fragColor;
    return stage_output;
}
