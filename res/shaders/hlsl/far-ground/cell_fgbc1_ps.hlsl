// glslang -G, then spirv-cross --hlsl; loose uniforms are the LooseUniforms cbuffer (register b31); the
// GLSL includes are inlined as the loader does. Fusion Shaders (F4FS) feeds it the GL-side inputs
// named in notes/vkcompute1/hlsl_plan.md. Not wired: nothing loads this file.
// profile: ps_6_0
#include "FarGroundBindingsVk.hlsli"
Texture2D<float4> fgSrc : register(t0, space0);
SamplerState _fgSrc_sampler : register(s0, space0);
cbuffer LooseUniforms : register(b31, space0)
{
    int fgSrcLevel;
    int fgBc1Red;	// test only: 1 swaps the endpoints without the indices (a broken encoder)
};

static float4 gl_FragCoord;
static uint2 fragBlock;

struct SPIRV_Cross_Input
{
    float4 gl_FragCoord : SV_Position;
};

struct SPIRV_Cross_Output
{
    uint2 fragBlock : SV_Target0;
};

uint to565(float3 c)
{
    uint3 q = uint3(floor((clamp(c, 0.0f.xxx, 1.0f.xxx) * float3(31.0f, 63.0f, 31.0f)) + 0.5f.xxx));
    return ((q.x << uint(11)) | (q.y << uint(5))) | q.z;
}

float3 from565(uint v)
{
    return float3(float((v >> uint(11)) & 31u) / 31.0f, float((v >> uint(5)) & 63u) / 63.0f, float(v & 31u) / 31.0f);
}

void frag_main()
{
    int2 b = int2(gl_FragCoord.xy) * int2(4, 4);
    float3 lo = 1.0f.xxx;
    float3 hi = 0.0f.xxx;
    float3 px[16];
    for (int i = 0; i < 16; i++)
    {
        px[i] = fgSrc.Load(int3(b + int2(i & 3, i >> 2), fgSrcLevel)).xyz;
        lo = min(lo, px[i]);
        hi = max(hi, px[i]);
    }
    float3 mid = (lo + hi) * 0.5f;
    float crg = 0.0f;
    float cbg = 0.0f;
    for (int i_1 = 0; i_1 < 16; i_1++)
    {
        float3 t = px[i_1] - mid;
        crg += (t.x * t.y);
        cbg += (t.z * t.y);
    }
    float3 inset = (hi - lo) / 16.0f.xxx;
    lo += inset;
    hi -= inset;
    float3 e0 = hi;
    float3 e1 = lo;
    if (crg < 0.0f)
    {
        e0.x = lo.x;
        e1.x = hi.x;
    }
    if (cbg < 0.0f)
    {
        e0.z = lo.z;
        e1.z = hi.z;
    }
    float3 param = e0;
    uint c0 = to565(param);
    float3 param_1 = e1;
    uint c1 = to565(param_1);
    if (c0 < c1)
    {
        uint t_1 = c0;
        c0 = c1;
        c1 = t_1;
    }
    uint bits = 0u;
    if (c0 != c1)
    {
        uint param_2 = c0;
        float3 p0 = from565(param_2);
        uint param_3 = c1;
        float3 p1 = from565(param_3);
        float3 ax = p0 - p1;
        float inv = 3.0f / dot(ax, ax);
        uint tmp282;
        uint tmp288;
        for (int i_2 = 0; i_2 < 16; i_2++)
        {
            int q = int(clamp((dot(px[i_2] - p1, ax) * inv) + 0.5f, 0.0f, 3.0f));
            if (q == 0)
            {
                tmp282 = 1u;
            }
            else
            {
                if (q == 1)
                {
                    tmp288 = 3u;
                }
                else
                {
                    tmp288 = (q == 2) ? 2u : 0u;
                }
                tmp282 = tmp288;
            }
            uint idx = tmp282;
            bits |= (idx << uint(2 * i_2));
        }
    }
    if ((fgBc1Red != 0) && (c0 != c1))
    {
        uint t_2 = c0;
        c0 = c1;
        c1 = t_2;
    }
    fragBlock = uint2(c0 | (c1 << uint(16)), bits);
}

SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
{
    gl_FragCoord = stage_input.gl_FragCoord;
    gl_FragCoord.w = 1.0 / gl_FragCoord.w;
    frag_main();
    SPIRV_Cross_Output stage_output;
    stage_output.fragBlock = fragBlock;
    return stage_output;
}
