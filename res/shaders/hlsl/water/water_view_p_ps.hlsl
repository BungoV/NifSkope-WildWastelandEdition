// integer hash (a lowbias32 mix), the same bits on any GPU and in the Python model
uint wwShoreHash(int2 c)
{
    uint h = (uint(c.x) * 2376512323u) ^ (uint(c.y) * 3625334849u);
    h ^= (h >> uint(16));
    h *= 2146121005u;
    h ^= (h >> uint(15));
    h *= 2221713035u;
    h ^= (h >> uint(16));
    return h;
}

