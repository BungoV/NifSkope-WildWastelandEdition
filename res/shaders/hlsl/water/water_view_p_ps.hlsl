float smooth01(float x)
{
    return (x * x) * (3.0f - (2.0f * x));
}

// lane FARSEA1: 1 a band inside the bake's box, 0 at its edge (the open sea)
float wwSeamFade(float2 worldXY)
{
    float2 a = worldXY - waterSeamBox.xy;
    float2 b = waterSeamBox.zw - worldXY;
    return clamp(min(min(a.x, a.y), min(b.x, b.y)) / max(waterSeam.x, 1.0f), 0.0f, 1.0f);
}

uint wwWaterInfoWord(float2 worldXY)
{
    float2 worldXYArg3 = worldXY;
    uint w = wwWaterInfoRaw(worldXYArg3);
    bool wwh0 = (waterSeam.x <= 0.0f);
    if (wwh0 || (!waterInfoOn))
    {
        return w;
    }
    uint id = w & 65535u;
    uint sea = uint(waterSeam.y);
    if (id == 0u)
    {
        uint wwWaterInfoWordRet;
        if (waterSeam.z > 0.0f)
        {
            wwWaterInfoWordRet = sea | 4294901760u;
        }
        else
        {
            wwWaterInfoWordRet = w;
        }
        return wwWaterInfoWordRet;
    }
    if (id != sea)
    {
        return w;
    }
    float2 worldXYArg2 = worldXY;
    float f = wwSeamFade(worldXYArg2);
    uint sh = uint(lerp(255.0f, float((w >> uint(16)) & 255u), f) + 0.5f);
    uint dc = uint(lerp(255.0f, float(w >> uint(24)), f) + 0.5f);
    return (id | (sh << uint(16))) | (dc << uint(24));
}

// one texel: (distance to the shore in world units, 1 wet / 0 dry or off the map)
float2 wwShoreTexelValue(uint w, bool inMap)
{
    if (!inMap)
    {
        return float2(255.0f * waterInfoGrid.w, 0.0f);
    }
    if ((w & 65535u) == 0u)
    {
        return 0.0f.xx;
    }
    return float2(float((w >> uint(16)) & 255u) * waterInfoGrid.w, 1.0f);
}

// (distance to the shore, wet texels of the 2 x 2 around the point); (0, 0) when the lookup is off
float2 wwShoreField(float2 worldXY)
{
    if (!waterInfoOn)
    {
        return 0.0f.xx;
    }
    // in texel centres
    float2 g = ((worldXY - waterInfoGrid.xy) / waterInfoGrid.z.xx) - 0.5f.xx;
    int2 t0 = int2(floor(g));
    float2 f = g - float2(t0);
    if ((waterShoreRed & 1) != 0)
    {
        f = step(0.5f.xx, f);
    }
    int E = int(waterInfoLayout.z);
    int2 n = int2(waterInfoLayout.xy) * E.xx;
    bool i00 = true;
    bool i10 = true;
    bool i01 = true;
    bool i11 = true;
    int2 tile = t0 / E.xx;
    int2 in0 = t0 - (tile * E.xx);
    bool cond14 = t0.x >= 0;
    bool cond13;
    if (cond14)
    {
        cond13 = t0.y >= 0;
    }
    else
    {
        cond13 = cond14;
    }
    bool cond12;
    if (cond13)
    {
        cond12 = (t0.x + 1) < n.x;
    }
    else
    {
        cond12 = cond13;
    }
    bool cond11;
    if (cond12)
    {
        cond11 = (t0.y + 1) < n.y;
    }
    else
    {
        cond11 = cond12;
    }
    bool cond10;
    if (cond11)
    {
        cond10 = in0.x < (E - 1);
    }
    else
    {
        cond10 = cond11;
    }
    bool cond9;
    if (cond10)
    {
        cond9 = in0.y < (E - 1);
    }
    else
    {
        cond9 = cond10;
    }
