    float a = wwFoamHash01(cArg5);
    int2 cArg4 = int2(c1.x, c.y) + seed;
    float b = wwFoamHash01(cArg4);
    int2 cArg3 = int2(c.x, c1.y) + seed;
    float e = wwFoamHash01(cArg3);
    int2 cArg2 = c1 + seed;
    float h = wwFoamHash01(cArg2);
