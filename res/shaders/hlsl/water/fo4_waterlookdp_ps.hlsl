float3 noiseN(Texture2D<float4> s, SamplerState _s_sampler, float2 uv, inout float2 tap)
{
    tap = s.Sample(_s_sampler, uv).xy;
    float2 t = (tap * 2.0f) - 1.0f.xx;
    return float3(t, sqrt(1.0f - min(dot(t, t), 1.0f)));
