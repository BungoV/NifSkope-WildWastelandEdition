// the inverse of tonemap() above: a stored frame value back to linear light
float3 untonemap(float3 y)
{
    float3 k = min(((y * y) * (A.w * 0.933333337306976318359375f)) + 0.066666670143604278564453125f.xxx, 0.999989986419677734375f.xxx);
    float3 qa = (k - 1.0f.xxx) * 0.1500000059604644775390625f;
    float3 qb = (k - 0.100000001490116119384765625f.xxx) * 0.5f;
    float3 qc = ((k * 0.300000011920928955078125f) - 0.0199999995529651641845703125f.xxx) * 0.20000000298023223876953125f;
    float3 z = ((-qb) - sqrt(max((qb * qb) - ((qa * 4.0f) * qc), 0.0f.xxx))) / (qa * 2.0f);
    return max(z, 0.0f.xxx) / ((D.w * A.w) * 4.229787349700927734375f).xxx;
}

// the frame stores what the cell programs wrote: linear (the HDR frame), or after the curve
float3 frameToLinear(float3 t)
{
    if (cellOn && cellIsOn)
    {
        float3 frameToLinearRet;
        if (cellIsLinear)
        {
            frameToLinearRet = t;
        }
        else
        {
            frameToLinearRet = pow(max(t, 0.0f.xxx), 2.2000000476837158203125f.xxx);
        }
        return frameToLinearRet;
    }
    float3 yArg = t;
    return untonemap(yArg);
}

