// HLSL port of features/water/ocean_spectrum.frag (frag shader). Generated by notes/hlslbulk1/tools/convert.py:
// glslang -G, then spirv-cross --hlsl; loose uniforms are the LooseUniforms cbuffer (register b31); the
// GLSL includes are inlined as the loader does. Fusion Shaders (F4FS) feeds it the GL-side inputs
// named in notes/vkcompute1/hlsl_plan.md. Not wired: nothing loads this file.
// profile: ps_6_0
#include "WaterBindingsVk.hlsli"
cbuffer LooseUniforms : register(b31, space0)
{
    float oceanDk[6];	// 2 pi / L of each tile, rad/m
    float oceanPhase;	// ( clock mod T ) / T
};
Texture2D<float4> oceanH0 : register(t0, space0);	// RGBA32F: h0( k ), conj( h0( -k ) )
SamplerState _oceanH0_sampler : register(s0, space0);
Texture2D<float4> oceanQ : register(t1, space0);	// R32F: q = floor( w T / 2 pi )
SamplerState _oceanQ_sampler : register(s1, space0);

static float4 gl_FragCoord;
static float4 o0;
static float4 o1;

struct SPIRV_Cross_Input
{
    float4 gl_FragCoord : SV_Position;
};

struct SPIRV_Cross_Output
{
    float4 o0 : SV_Target0;
    float4 o1 : SV_Target1;
};

float2 cmul(float2 a, float2 b)
{
    return float2((a.x * b.x) - (a.y * b.y), (a.x * b.y) + (a.y * b.x));
}

void frag_main()
{
    int2 p = int2(gl_FragCoord.xy);
    int tile = p.x / 128;
    int2 m = int2(p.x - (tile * 128), p.y);
    int nPick2;
    if (m.x < 64)
    {
        nPick2 = m.x;
    }
    else
    {
        nPick2 = m.x - 128;
    }
    int nPick;
    if (m.y < 64)
    {
        nPick = m.y;
    }
    else
    {
        nPick = m.y - 128;
    }
    float2 n = float2(float(nPick2), float(nPick));
    float2 k = n * oceanDk[tile];
    float kl = length(k);
    float4 h0 = oceanH0.Load(int3(p, 0));
    float q = oceanQ.Load(int3(p, 0)).x;
    float ph = 6.283185482025146484375f * frac(q * oceanPhase);
    float2 e = float2(cos(ph), sin(ph));
    float2 aArg2 = h0.xy;
    float2 bArg2 = e;
    float2 aArg = h0.zw;
    float2 bArg = float2(e.x, -e.y);
    float2 h = cmul(aArg2, bArg2) + cmul(aArg, bArg);
    // i h
    float2 ih = float2(-h.y, h.x);
    float kiPick;
    if (kl > 0.0f)
    {
        kiPick = 1.0f / kl;
    }
    else
    {
        kiPick = 0.0f;
    }
    float ki = kiPick;
    float2 sx = ih * k.x;
    float2 sy = ih * k.y;
    float2 dx = ih * (k.x * ki);
    float2 dy = ih * (k.y * ki);
    float2 dxx = h * (((-k.x) * k.x) * ki);
    float2 dyy = h * (((-k.y) * k.y) * ki);
    float2 dxy = h * (((-k.x) * k.y) * ki);
    // a + i b for complex a, b: ( a.x - b.y, a.y + b.x )
    o0 = float4(sx.x - sy.y, sx.y + sy.x, dxx.x - dyy.y, dxx.y + dyy.x);
    o1 = float4(dxy.x - h.y, dxy.y + h.x, dx.x - dy.y, dx.y + dy.x);
}

SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
{
    gl_FragCoord = stage_input.gl_FragCoord;
    gl_FragCoord.w = 1.0 / gl_FragCoord.w;
    frag_main();
    SPIRV_Cross_Output stage_output;
    stage_output.o0 = o0;
    stage_output.o1 = o1;
    return stage_output;
}
