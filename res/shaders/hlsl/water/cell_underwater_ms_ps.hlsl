cbuffer LooseUniforms : register(b31, space0)
{
    int waterClearRed;	// 1 noscatter, 2 nodown, 3 fast, 4 old
    int uwLight;	// 1 = the Underwater light row is on
    int uwLightRed;	// 2 nomeniscus, 4 nocolor (the WATR fog law stays); 1 nosnell is the water program's
    float2 uwMenK;	// the meniscus: half width (px), darkening at its middle
    int uwClass;	// the body's class: 0 sea, 1 river, 2 lake (placed water)
    float4 uwSun;	// the sun's linear colour (0 below the horizon), its height (cos from the zenith)
    float3 uwSky;	// the water's diffuse sky light, linear: half the horizon + half the upper row
    row_major float4x4 uwInvProj;	// clip -> view
    float4 uwRow[3];	// view -> world rows
    float4 uwFog;	// amount, near, far, surface height
    float4 uwVp;	// the viewport x, y, w, h
    float3 uwEye;	// the camera, world
    float3 uwColor;
    float3 uwTint;
    int uwRed;
    float4 waterInfoGrid;	// world x, y of texel (0, 0), world units a texel, world units a shore step
    float4 waterInfoLayout;	// tiles x, tiles y, texels a tile edge, tiles an atlas row
    bool waterInfoOn;	// built, uploaded, and not WW_CELL_WATER_INFO_RED=off
    float4 waterSeam;
    float4 waterSeamBox;
    float4 waterFlowGrid;	// world x, y of texel (0, 0), world units a texel, counts a world unit a second
    float4 waterFlowLayout;	// tiles x, tiles y, texels a tile edge, tiles an atlas row
    bool waterFlowOn;	// built, uploaded, the file has a flow plane, and not WW_CELL_WATER_INFO_RED=off
    int waterDepthRed;	// 1 flat (the bed depth read as 0), 2 noabsorb (no pure-water term), 3 nearest (no bilinear)
    bool waterDepthOn;	// lane WATERCOMBINE1: the Water depth colour row (fo4_waterlook carries every water look)
    bool waterClearOn;	// the Water clear colour row
    int uwSamples;	// its samples; 0 = one fog per pixel from the farthest depth (one sample, or red maxdepth)
};
