// glslang -G, then spirv-cross --hlsl; loose uniforms are the LooseUniforms cbuffer (register b31); the
// GLSL includes are inlined as the loader does. Fusion Shaders (F4FS) feeds it the GL-side inputs
// named in notes/vkcompute1/hlsl_plan.md. Not wired: nothing loads this file.
// profile: ps_6_0
#include "ShadowsBindingsVk.hlsli"
Texture2D<float4> gbuf : register(t0, space0);	// the full-size opaque pass (.a linear depth; 1e6 none)
SamplerState _gbuf_sampler : register(s0, space0);
cbuffer LooseUniforms : register(b31, space0)
{
    float maskScale;	// full pixels per mask pixel (2)
    int2 maskSize;
    int2 fullSize;
    float tolerance;
};
Texture2D<float4> mask : register(t1, space0);	// the half-size contact mask (R8)
SamplerState _mask_sampler : register(s1, space0);

static float4 gl_FragCoord;
static float fragMask;

struct SPIRV_Cross_Input
{
    float4 gl_FragCoord : SV_Position;
};

struct SPIRV_Cross_Output
{
    float fragMask : SV_Target0;
};

void frag_main()
{
    int2 fq = int2(gl_FragCoord.xy);
    float z = gbuf.Load(int3(fq, 0)).w;
    float2 mp = (gl_FragCoord.xy / maskScale.xx) - 0.5f.xx;
    int2 base = int2(floor(mp));
    float2 fr = mp - float2(base);
    bool wwh0 = (z >= 900000.0f);
    bool wwh1 = (z <= 0.0f);
    if (or(wwh0, wwh1))   // HLSLFIX2 orfix.py: no short-circuit branch (NV took the wrong side)
    {
        fragMask = mask.Load(int3(clamp(int2(floor(gl_FragCoord.xy / maskScale.xx)), int2(0, 0), maskSize - int2(1, 1)), 0)).x;
        return;
    }
    float wsum = 0.0f;
    float acc = 0.0f;
    float best = 1000000015047466219876688855040.0f;
    float bestM = 1.0f;
    float bwPick2;
    float bwPick;
    for (int j = 0; j < 2; j++)
    {
        for (int i = 0; i < 2; i++)
        {
            int2 c = clamp(base + int2(i, j), int2(0, 0), maskSize - int2(1, 1));
            float m = mask.Load(int3(c, 0)).x;
            int2 rq = clamp(int2(floor((float2(c) + 0.5f.xx) * maskScale)), int2(0, 0), fullSize - int2(1, 1));
            float cz = gbuf.Load(int3(rq, 0)).w;
            float dz = abs(cz - z);
            if (dz < best)
            {
                best = dz;
                bestM = m;
            }
            if (i == 0)
            {
                bwPick2 = 1.0f - fr.x;
            }
            else
            {
                bwPick2 = fr.x;
            }
            if (j == 0)
            {
                bwPick = 1.0f - fr.y;
            }
            else
            {
                bwPick = fr.y;
            }
            float bw = bwPick2 * bwPick;
            float w = bw * clamp(1.0f - (dz / (z * tolerance)), 0.0f, 1.0f);
            wsum += w;
            acc += (w * m);
        }
    }
    float fragMaskPick;
    if (wsum > 9.9999997473787516355514526367188e-05f)
    {
        fragMaskPick = acc / wsum;
    }
    else
    {
        fragMaskPick = bestM;
    }
    fragMask = fragMaskPick;
}

SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
{
    gl_FragCoord = stage_input.gl_FragCoord;
    gl_FragCoord.w = 1.0 / gl_FragCoord.w;
    frag_main();
    SPIRV_Cross_Output stage_output;
    stage_output.fragMask = fragMask;
    return stage_output;
}
