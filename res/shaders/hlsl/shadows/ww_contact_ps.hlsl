float linAt(float2 maskPx, out bool valid)
{
    int2 q = int2(floor(maskPx * maskScale));
    bool cond2 = any(bool2(q.x < int2(0, 0).x, q.y < int2(0, 0).y));
    bool cond;
    if (!cond2)
    {
        cond = any(bool2(q.x >= fullSize.x, q.y >= fullSize.y));
    }
    else
    {
        cond = cond2;
    }
    if (cond)
    {
        valid = false;
        return 1000000.0f;
    }
    float l = gbuf.Load(int3(q, 0)).w;
    valid = l < 900000.0f;
    return l;
}

//! lane FIX1101A: a mask pixel at linear depth z -> view position (game units), for the reach
float3 sssViewPos(float2 maskPx, float z)
{
    float2 ndc = (((maskPx * maskScale) / float2(fullSize)) * 2.0f) - 1.0f.xx;
    return float3((ndc.x * sssTan.x) * z, (ndc.y * sssTan.y) * z, z);
}

float3 normalAt(float2 maskPx)
{
    int2 q = clamp(int2(floor(maskPx * maskScale)), int2(0, 0), fullSize - int2(1, 1));
    return gbuf.Load(int3(q, 0)).xyz;
}

