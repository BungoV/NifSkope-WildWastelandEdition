void frag_main()
{
    float2 uv = (gl_FragCoord.xy - cvRect.xy) * cvRect.zw;
    if (cvFront >= 1)
    {
        float z = cvScene.Sample(_cvScene_sampler, uv).x;
        if (z >= 1.0f)
        {
            discard;
        }
        float2 ndc = (uv * 2.0f) - 1.0f.xx;
        float3 v = float3((ndc.x + cvProj.z) / cvProj.x, (ndc.y + cvProj.w) / cvProj.y, -1.0f);
        float tScene = ((length(v) * cvSceneZ.y) / (((2.0f * z) - 1.0f) + cvSceneZ.x)) * cvSceneZ.z;
        int2 hs = int2(spvTextureSize(cvHistDepth, uint(0), dummy_parameter));
        float dm = cvHistDepth.Load(int3(clamp(int2(uv * float2(hs)), int2(0, 0), hs - int2(1, 1)), 0)).x;
        if ((cvSceneZ.w > 0.5f) && (dm >= tScene))
        {
            discard;
        }
    }
    float4 h = cvHist.Sample(_cvHist_sampler, uv);
    float a = clamp(1.0f - h.w, 0.0f, 1.0f);
    if (a <= 9.9999997473787516355514526367188e-05f)
    {
        discard;
    }
    if (cvLtOn != 0)
    {
        float2 param = uv;
        float param_1 = a;
        float4 tmp616 = h;
        float3 tmp618 = tmp616.xyz + cvLtLight(param, param_1);
        h.x = tmp618.x;
        h.y = tmp618.y;
        h.z = tmp618.z;
    }
    float4 tmp629;
    if (cvFront == 2)
    {
        tmp629 = float4(max(h.xyz, 0.0f.xxx), a);
    }
    else
    {
        float3 param_2 = h.xyz / a.xxx;
        float3 tmp647 = studioOutput(param_2);
        tmp629 = float4(tmp647, a);
    }
    fragColor = tmp629;
}

SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
{
    gl_FragCoord = stage_input.gl_FragCoord;
    gl_FragCoord.w = 1.0 / gl_FragCoord.w;
    frag_main();
    SPIRV_Cross_Output stage_output;
    stage_output.fragColor = fragColor;
    return stage_output;
}
