float2 csSheetHash(inout float2 s)
{
    s = frac(s * float2(1271.51513671875f, 3337.82373046875f));
    s += dot(s, s.yx + 19.1900005340576171875f.xx).xx;
    return frac((s.xx + s.yy) * s.yx);
}

float csSheetAlpha(int i, float2 st, float mip)
