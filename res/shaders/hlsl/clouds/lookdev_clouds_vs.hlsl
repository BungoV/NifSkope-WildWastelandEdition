void vert_main()
{
    bool3 wdirPart = probe.xxx;
    wdir = float3(wdirPart.x ? float3(0.0f, 0.0f, 1.0f).x : vertexPosition.x, wdirPart.y ? float3(0.0f, 0.0f, 1.0f).y : vertexPosition.y, wdirPart.z ? float3(0.0f, 0.0f, 1.0f).z : vertexPosition.z);
