// glslang -G, then spirv-cross --hlsl; loose uniforms are the LooseUniforms cbuffer (register b31); the
// GLSL includes are inlined as the loader does. Fusion Shaders (F4FS) feeds it the GL-side inputs
// named in notes/vkcompute1/hlsl_plan.md. Not wired: nothing loads this file.
// profile: ps_6_0
#include "CloudsBindingsVk.hlsli"
cbuffer LooseUniforms : register(b31, space0)
{
    float cvMoveClamp;
    float2 cvHistSize;
    float cvStride;
    float2 cvPhase;
    float cvHistOn;	// 0 = no history yet (first frame, resize, a jump)
    float cvReproj;	// 0 = the red noreproj: the same pixel of the history, the camera's motion ignored
    row_major float3x3 cvCam;	// this frame: world columns right, up, back
    float4 cvProj;	// P00, P11, P20, P21
    row_major float3x3 cvPrevCam;	// last frame's
    float3 cvCamKm;
    float3 cvPrevCamKm;
    float4 cvPrevProj;
};
Texture2D<float4> cvMarch : register(t0, space0);	// rgb = light, a = transmittance, at history / stride
SamplerState _cvMarch_sampler : register(s0, space0);
Texture2D<float4> cvMarchDepth : register(t1, space0);	// km
SamplerState _cvMarchDepth_sampler : register(s1, space0);
Texture2D<float4> cvPrevDepth : register(t2, space0);
SamplerState _cvPrevDepth_sampler : register(s2, space0);
Texture2D<float4> cvPrev : register(t3, space0);	// last frame's history
SamplerState _cvPrev_sampler : register(s3, space0);

static float4 gl_FragCoord;
static float4 cvOut;
static float4 cvDepth;

struct SPIRV_Cross_Input
{
    float4 gl_FragCoord : SV_Position;
};

struct SPIRV_Cross_Output
{
    float4 cvOut : SV_Target0;
    float4 cvDepth : SV_Target1;
};

static uint dummy_parameter;

float mod(float x, float y)
{
    return x - y * floor(x / y);
}

float2 mod(float2 x, float2 y)
{
    return x - y * floor(x / y);
}

float3 mod(float3 x, float3 y)
{
    return x - y * floor(x / y);
}

float4 mod(float4 x, float4 y)
{
    return x - y * floor(x / y);
}

uint2 spvTextureSize(Texture2D<float4> Tex, uint Level, out uint Param)
{
    uint2 ret;
    Tex.GetDimensions(Level, ret.x, ret.y, Param);
    return ret;
}

float4 cvCatmull(float t)
{
    float t2 = t * t;
    float t3 = t2 * t;
    // NV GL's lowering: w1, w2 by Horner on t2; w0, w3 unfused
    precise float w0 = ((2.0f * t2) - t3) - t;
    precise float w3 = t3 - t2;
    return float4(w0, mad(t2, mad(3.0f, t, -5.0f), 2.0f), mad(t2, mad(-3.0f, t, 4.0f), t), w3) * 0.5f;
}

float4 cvMoveBox(float2 q, float2 uv, float2 pv, float4 c)
{
    bool cond2 = cvMoveClamp < 0.5f;
    bool cond;
    if (!cond2)
    {
        float2 condPart = abs(pv - uv) * cvHistSize;
        cond = all(bool2(condPart.x < 0.00999999977648258209228515625f.xx.x, condPart.y < 0.00999999977648258209228515625f.xx.y));
    }
    else
    {
        cond = cond2;
    }
    if (cond)
    {
        return c;
    }
    int2 m = int2(floor(q / cvStride.xx));
    int2 mhi = int2(spvTextureSize(cvMarch, uint(0), dummy_parameter)) - int2(1, 1);
    float4 lo = 1000000015047466219876688855040.0f.xxxx;
    float4 up = (-1000000015047466219876688855040.0f).xxxx;
    for (int j = -1; j <= 1; j++)
    {
        for (int i = -1; i <= 1; i++)
        {
            float4 n = cvMarch.Load(int3(clamp(m + int2(i, j), int2(0, 0), mhi), 0));
            lo = min(lo, n);
            up = max(up, n);
        }
    }
    return clamp(c, lo, up);
}

void frag_main()
{
    float2 q = floor(gl_FragCoord.xy);
    float2 slot = mod(q, cvStride.xx);
    float2 uv = (q + 0.5f.xx) / cvHistSize;
    if (all(bool2(slot.x == cvPhase.x, slot.y == cvPhase.y)))
    {
        int2 m = int2(floor(q / cvStride.xx));
        cvOut = cvMarch.Load(int3(m, 0));
        cvDepth = cvMarchDepth.Load(int3(m, 0));
        return;
    }
    float4 coarse = cvMarch.Sample(_cvMarch_sampler, uv);
    float dk = cvMarchDepth.Sample(_cvMarchDepth_sampler, uv).x;
    if (cvHistOn < 0.5f)
    {
        cvOut = coarse;
        cvDepth = dk.xxxx;
        return;
    }
    float2 pv = uv;
    if (cvReproj > 0.5f)
    {
        float2 ndc = (uv * 2.0f) - 1.0f.xx;
        float3 du = mul(float3((ndc.x + cvProj.z) / cvProj.x, (ndc.y + cvProj.w) / cvProj.y, -1.0f), cvCam);
        float3 d = du * rsqrt(mad(du.z, du.z, mad(du.y, du.y, du.x * du.x)));	// NV GL's normalize: x*x first
        // the cloud this pixel saw last frame: the previous depth along the ray (a sky pixel: far away)
        float dp = cvPrevDepth.Sample(_cvPrevDepth_sampler, uv).x;
        float dist = min((dp < 1000.0f) ? dp : dk, 400.0f);
        // NV GL: u = fma(d, dist, cam) - prev; transpose(M) * u per GL column fma(c.z, u.z, fma(c.x, u.x, c.y * u.y))
        float3 u = mad(d, dist.xxx, cvCamKm) - cvPrevCamKm;
        float3 v = float3(mad(cvPrevCam[0].z, u.z, mad(cvPrevCam[0].x, u.x, cvPrevCam[0].y * u.y)),
                          mad(cvPrevCam[1].z, u.z, mad(cvPrevCam[1].x, u.x, cvPrevCam[1].y * u.y)),
                          mad(cvPrevCam[2].z, u.z, mad(cvPrevCam[2].x, u.x, cvPrevCam[2].y * u.y)));
        if (v.z >= (-9.9999997473787516355514526367188e-05f))
        {
            cvOut = coarse;
            cvDepth = dk.xxxx;
            return;
        }
        float2 vr = v.xy / (-v.z).xx;
        float2 pn = float2((vr.x * cvPrevProj.x) - cvPrevProj.z, (vr.y * cvPrevProj.y) - cvPrevProj.w);
        pv = (pn * 0.5f) + 0.5f.xx;
        bool cond4 = any(bool2(pv.x < 0.0f.xx.x, pv.y < 0.0f.xx.y));
        bool cond3;
        if (!cond4)
        {
            cond3 = any(bool2(pv.x > 1.0f.xx.x, pv.y > 1.0f.xx.y));
        }
        else
        {
            cond3 = cond4;
        }
        if (cond3)
        {
            cvOut = coarse;
            cvDepth = dk.xxxx;
            return;
        }
    }
    // Catmull-Rom: a bilinear read each frame blurs the history over the up to 16 resamples before a refresh, and the
    // nearest texel drifts; the depth stays nearest (it is a distance, not a picture)
    float2 xy = mad(pv, cvHistSize, -0.5f.xx);
    float2 f = frac(xy);
    int2 i0 = int2(floor(xy)) - int2(1, 1);
    int2 hi = int2(cvHistSize) - int2(1, 1);
    float tArg2 = f.x;
    float4 wx = cvCatmull(tArg2);
    float tArg = f.y;
    float4 wy = cvCatmull(tArg);
    float4 c = 0.0f.xxxx;
    for (int j = 0; j < 4; j++)
    {
        for (int i = 0; i < 4; i++)
        {
            c += (cvPrev.Load(int3(clamp(i0 + int2(i, j), int2(0, 0), hi), 0)) * (wx[i] * wy[j]));
        }
    }
    float2 qArg = q;
    float2 uvArg = uv;
    float2 pvArg = pv;
    float4 cArg = float4(max(c.xyz, 0.0f.xxx), clamp(c.w, 0.0f, 1.0f));
    // lane CLOUD6g
    cvOut = cvMoveBox(qArg, uvArg, pvArg, cArg);
    cvDepth = cvPrevDepth.Load(int3(clamp(int2(floor(pv * cvHistSize)), int2(0, 0), hi), 0));
}

SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
{
    gl_FragCoord = stage_input.gl_FragCoord;
    gl_FragCoord.w = 1.0 / gl_FragCoord.w;
    frag_main();
    SPIRV_Cross_Output stage_output;
    stage_output.cvOut = cvOut;
    stage_output.cvDepth = cvDepth;
    return stage_output;
}
