// HLSL port of features/clouds/cloud_resolve_a.frag (frag shader). Generated by notes/hlslbulk1/tools/convert.py:
// glslang -G, then spirv-cross --hlsl; loose uniforms are the LooseUniforms cbuffer (register b31); the
// GLSL includes are inlined as the loader does. Fusion Shaders (F4FS) feeds it the GL-side inputs
// named in notes/vkcompute1/hlsl_plan.md. Not wired: nothing loads this file.
// profile: ps_6_0
#include "CloudsBindingsVk.hlsli"
cbuffer LooseUniforms : register(b31, space0)
{
    float cvMoveClamp;
    float2 cvHistSize;
    float cvStride;
    float cvReproj;	// 0 = the red noreproj: the same pixel of the history, the camera's motion ignored
    row_major float3x3 cvCam;	// this frame: world columns right, up, back
    float4 cvProj;	// P00, P11, P20, P21
    row_major float3x3 cvPrevCam;	// last frame's
    float3 cvCamKm;
    float3 cvPrevCamKm;
    float4 cvPrevProj;
    float2 cvPhase;
    float cvHistAge;
    float cvHistOn;	// 0 = no history yet (first frame, resize, a jump)
    float cvAccReset;
    float cvAgeK;
    float cvAccResetSd;
    float cvAccAlpha;	// the fresh march's weight; 1 = the red noaccum
    float cvAccClamp;	// 1 = clamp the history to the fresh neighbourhood's box; 0 = the red noclamp
    float cvLitReset;
    float cvLitFloor;
};
Texture2D<float4> cvMarch : register(t0, space0);	// rgb = light, a = transmittance, at history / stride
SamplerState _cvMarch_sampler : register(s0, space0);
Texture2D<float4> cvPrevDepth : register(t1, space0);
SamplerState _cvPrevDepth_sampler : register(s1, space0);
Texture2D<float4> cvMarchDepth : register(t2, space0);	// km
SamplerState _cvMarchDepth_sampler : register(s2, space0);
Texture2D<float4> cvPrev : register(t3, space0);	// last frame's history
SamplerState _cvPrev_sampler : register(s3, space0);

static float4 gl_FragCoord;
static float4 cvOut;
static float4 cvDepth;

struct SPIRV_Cross_Input
{
    float4 gl_FragCoord : SV_Position;
};

struct SPIRV_Cross_Output
{
    float4 cvOut : SV_Target0;
    float4 cvDepth : SV_Target1;
};

static uint dummy_parameter;

float mod(float x, float y)
{
    return x - y * floor(x / y);
}

float2 mod(float2 x, float2 y)
{
    return x - y * floor(x / y);
}

float3 mod(float3 x, float3 y)
{
    return x - y * floor(x / y);
}

float4 mod(float4 x, float4 y)
{
    return x - y * floor(x / y);
}

uint2 spvTextureSize(Texture2D<float4> Tex, uint Level, out uint Param)
{
    uint2 ret;
    Tex.GetDimensions(Level, ret.x, ret.y, Param);
    return ret;
}

//! where this pixel's cloud was in the previous history (Off's reprojection); false = no history there
bool cvReprojUv(float2 uv, float dk, inout float2 pv)
{
    pv = uv;
    if (cvReproj < 0.5f)
    {
        return true;
    }
    float2 ndc = (uv * 2.0f) - 1.0f.xx;
    float3 du = mul(float3((ndc.x + cvProj.z) / cvProj.x, (ndc.y + cvProj.w) / cvProj.y, -1.0f), cvCam);
    float3 d = du * rsqrt(mad(du.z, du.z, mad(du.y, du.y, du.x * du.x)));	// NV GL's normalize: x*x first
    float dp = cvPrevDepth.Sample(_cvPrevDepth_sampler, uv).x;
    float dist = min((dp < 1000.0f) ? dp : dk, 400.0f);
    // NV GL: u = fma(d, dist, cam) - prev; transpose(M) * u per GL column fma(c.z, u.z, fma(c.x, u.x, c.y * u.y))
    float3 u = mad(d, dist.xxx, cvCamKm) - cvPrevCamKm;
    float3 v = float3(mad(cvPrevCam[0].z, u.z, mad(cvPrevCam[0].x, u.x, cvPrevCam[0].y * u.y)),
                      mad(cvPrevCam[1].z, u.z, mad(cvPrevCam[1].x, u.x, cvPrevCam[1].y * u.y)),
                      mad(cvPrevCam[2].z, u.z, mad(cvPrevCam[2].x, u.x, cvPrevCam[2].y * u.y)));
    if (v.z >= (-9.9999997473787516355514526367188e-05f))
    {
        return false;
    }
    float2 vr = v.xy / (-v.z).xx;
    float2 pn = float2((vr.x * cvPrevProj.x) - cvPrevProj.z, (vr.y * cvPrevProj.y) - cvPrevProj.w);
    pv = (pn * 0.5f) + 0.5f.xx;
    bool cond = all(bool2(pv.x >= 0.0f.xx.x, pv.y >= 0.0f.xx.y));
    bool cvReprojUvRet;
    if (cond)
    {
        cvReprojUvRet = all(bool2(pv.x <= 1.0f.xx.x, pv.y <= 1.0f.xx.y));
    }
    else
    {
        cvReprojUvRet = cond;
    }
    return cvReprojUvRet;
}

float4 cvCatmull(float t)
{
    float t2 = t * t;
    float t3 = t2 * t;
    // NV GL's lowering: w1, w2 by Horner on t2; w0, w3 unfused
    precise float w0 = ((2.0f * t2) - t3) - t;
    precise float w3 = t3 - t2;
    return float4(w0, mad(t2, mad(3.0f, t, -5.0f), 2.0f), mad(t2, mad(-3.0f, t, 4.0f), t), w3) * 0.5f;
}

float4 cvMoveBox(float2 q, float2 uv, float2 pv, float4 c)
{
    bool cond3 = cvMoveClamp < 0.5f;
    bool cond2;
    if (!cond3)
    {
        float2 condPart = abs(pv - uv) * cvHistSize;
        cond2 = all(bool2(condPart.x < 0.00999999977648258209228515625f.xx.x, condPart.y < 0.00999999977648258209228515625f.xx.y));
    }
    else
    {
        cond2 = cond3;
    }
    if (cond2)
    {
        return c;
    }
    int2 m = int2(floor(q / cvStride.xx));
    int2 mhi = int2(spvTextureSize(cvMarch, uint(0), dummy_parameter)) - int2(1, 1);
    float4 lo = 1000000015047466219876688855040.0f.xxxx;
    float4 up = (-1000000015047466219876688855040.0f).xxxx;
    for (int j = -1; j <= 1; j++)
    {
        for (int i = -1; i <= 1; i++)
        {
            float4 n = cvMarch.Load(int3(clamp(m + int2(i, j), int2(0, 0), mhi), 0));
            lo = min(lo, n);
            up = max(up, n);
        }
    }
    return clamp(c, lo, up);
}

float cvLum(float3 c)
{
    // NV GL's dot: x product first, then y, then z fused
    return mad(c.z, 0.072200000286102294921875f, mad(c.y, 0.715200006961822509765625f, c.x * 0.2125999927520751953125f));
}

void frag_main()
{
    float2 q = floor(gl_FragCoord.xy);
    float2 slot = mod(q, cvStride.xx);
    float2 uv = (q + 0.5f.xx) / cvHistSize;
    bool fresh = all(bool2(slot.x == cvPhase.x, slot.y == cvPhase.y));
    int2 m = int2(floor(q / cvStride.xx));
    float2 muvPick;
    if (cvHistAge > 0.0f)
    {
        muvPick = (((q - cvPhase) / cvStride.xx) + 0.5f.xx) / float2(int2(spvTextureSize(cvMarch, uint(0), dummy_parameter)));
    }
    else
    {
        muvPick = uv;
    }
    // lane CLOUD6h: with History Age, the march is read where its samples sit (texel m looked at m x stride + phase)
    float2 muv = muvPick;
    float4 coarsePick;
    if (fresh)
    {
        coarsePick = cvMarch.Load(int3(m, 0));
    }
    else
    {
        coarsePick = cvMarch.Sample(_cvMarch_sampler, muv);
    }
    float4 coarse = coarsePick;
    float dkPick;
    if (fresh)
    {
        dkPick = cvMarchDepth.Load(int3(m, 0)).x;
    }
    else
    {
        dkPick = cvMarchDepth.Sample(_cvMarchDepth_sampler, uv).x;
    }
    float dk = dkPick;
    bool cond5 = cvHistOn < 0.5f;
    float2 pv;
    bool cond4;
    if (!cond5)
    {
        float2 uvArg2 = uv;
        float dkArg = dk;
        float2 pvArg2;
        bool cvReprojUvRet2 = cvReprojUv(uvArg2, dkArg, pvArg2);
        pv = pvArg2;
        cond4 = !cvReprojUvRet2;
    }
    else
    {
        cond4 = cond5;
    }
    if (cond4)
    {
        cvOut = coarse;
        // lane CLOUD6h: .g = the age (0: this frame's march)
        cvDepth = float4(dk, 0.0f, 0.0f, 0.0f);
        return;
    }
    // the history at pv: Catmull-Rom colour, nearest depth (as Off)
    float2 xy = mad(pv, cvHistSize, -0.5f.xx);
    float2 f = frac(xy);
    int2 i0 = int2(floor(xy)) - int2(1, 1);
    int2 hi = int2(cvHistSize) - int2(1, 1);
    float tArg2 = f.x;
    float4 wx = cvCatmull(tArg2);
    float tArg = f.y;
    float4 wy = cvCatmull(tArg);
    float4 c = 0.0f.xxxx;
    for (int j = 0; j < 4; j++)
    {
        for (int i = 0; i < 4; i++)
        {
            c += (cvPrev.Load(int3(clamp(i0 + int2(i, j), int2(0, 0), hi), 0)) * (wx[i] * wy[j]));
        }
    }
    c = float4(max(c.xyz, 0.0f.xxx), clamp(c.w, 0.0f, 1.0f));
    int2 hp0 = clamp(int2(floor(pv * cvHistSize)), int2(0, 0), hi);
    // lane CLOUD6h: the nearest trace's depth and age
    float2 hd = cvPrevDepth.Load(int3(hp0, 0)).xy;
    float age = hd.y + 1.0f;
    if (!fresh)
    {
        float2 qArg = q;
        float2 uvArg = uv;
        float2 pvArg = pv;
        float4 cArg3 = c;
        // lane CLOUD6g
        cvOut = cvMoveBox(qArg, uvArg, pvArg, cArg3);
        // lane CLOUD6h: an old trace
        if (((cvHistAge > 0.0f) && (age > cvHistAge)) && (cvAccReset > 0.0f))
        {
            // the 9 places the march texels looked this frame (m x stride + phase), moved as this pixel moved
            int2 mhi = int2(spvTextureSize(cvMarch, uint(0), dummy_parameter)) - int2(1, 1);
            int2 hp = hp0 + int2(((float2(m) * cvStride) + cvPhase) - q);
            float s1 = 0.0f;
            float s2 = 0.0f;
            float h1 = 0.0f;
            float h2 = 0.0f;
            for (int j_1 = -1; j_1 <= 1; j_1++)
            {
                for (int i_1 = -1; i_1 <= 1; i_1++)
                {
                    float n = cvMarch.Load(int3(clamp(m + int2(i_1, j_1), int2(0, 0), mhi), 0)).w;
                    s1 += n;
                    s2 += (n * n);
                    float ha = cvPrev.Load(int3(clamp(hp + (int(cvStride).xx * int2(i_1, j_1)), int2(0, 0), hi), 0)).w;
                    h1 += ha;
                    h2 += (ha * ha);
                }
            }
            float mu = s1 / 9.0f;
            float sd = sqrt(max((s2 / 9.0f) - (mu * mu), 0.0f));
            float hm = h1 / 9.0f;
            float hsd = sqrt(max((h2 / 9.0f) - (hm * hm), 0.0f));
            float te = cvAgeK * (cvAccReset + ((cvAccResetSd * min(sd, hsd)) / 3.0f));
            float w = smoothstep(te, 2.0f * te, abs(hm - mu));
            cvOut = lerp(cvOut, coarse, w.xxxx);
            age = lerp(age, 0.0f, w);
        }
        cvDepth = float4(hd.x, age, 0.0f, 0.0f);
        return;
    }
    float a = cvAccAlpha;
    if (cvAccClamp > 0.5f)
    {
        // the 3x3 box of the fresh marches, tightened to their mean +- one deviation (variance clipping, Salvi 2016: the
        // march texels sit 4 history px apart, so the bare min / max box held most of a textured old field), never
        // tighter than the fresh march itself
        int2 mhi_1 = int2(spvTextureSize(cvMarch, uint(0), dummy_parameter)) - int2(1, 1);
        float4 lo = coarse;
        float4 up = coarse;
        float4 s1_1 = 0.0f.xxxx;
        float4 s2_1 = 0.0f.xxxx;
        for (int j_2 = -1; j_2 <= 1; j_2++)
        {
            for (int i_2 = -1; i_2 <= 1; i_2++)
            {
                float4 n_1 = cvMarch.Load(int3(clamp(m + int2(i_2, j_2), int2(0, 0), mhi_1), 0));
                lo = min(lo, n_1);
                up = max(up, n_1);
                s1_1 += n_1;
                s2_1 += (n_1 * n_1);
            }
        }
        float4 mu_1 = s1_1 / 9.0f.xxxx;
        float4 sd_1 = sqrt(max((s2_1 / 9.0f.xxxx) - (mu_1 * mu_1), 0.0f.xxxx));
        lo = min(max(lo, mu_1 - sd_1), coarse);
        up = max(min(up, mu_1 + sd_1), coarse);
        c = clamp(c, lo, up);
        // lane CLOUD6g: Change Clamp
        if (cvAccReset > 0.0f)
        {
            int2 hp_1 = int2(floor(pv * cvHistSize));
            float h1_1 = 0.0f;
            float h2_1 = 0.0f;
            float l1 = 0.0f;
            float l2 = 0.0f;
            float f1 = 0.0f;
            float f2 = 0.0f;
            for (int j_3 = -1; j_3 <= 1; j_3++)
            {
                for (int i_3 = -1; i_3 <= 1; i_3++)
                {
                    float4 hv = cvPrev.Load(int3(clamp(hp_1 + (int(cvStride).xx * int2(i_3, j_3)), int2(0, 0), hi), 0));
                    h1_1 += hv.w;
                    h2_1 += (hv.w * hv.w);
                    // lane CLOUD6h: Lit Clamp, the light at the same 9 places
                    if (cvLitReset > 0.0f)
                    {
                        float3 cArg2 = hv.xyz;
                        float hl = cvLum(cArg2);
                        float3 cArg = cvMarch.Load(int3(clamp(m + int2(i_3, j_3), int2(0, 0), mhi_1), 0)).xyz;
                        float fl = cvLum(cArg);
                        l1 += hl;
                        l2 += (hl * hl);
                        f1 += fl;
                        f2 += (fl * fl);
                    }
                }
            }
            float hm_1 = h1_1 / 9.0f;
            float hsd_1 = sqrt(max((h2_1 / 9.0f) - (hm_1 * hm_1), 0.0f));
            float te_1 = cvAccReset + ((cvAccResetSd * min(sd_1.w, hsd_1)) / 3.0f);
            a = max(a, smoothstep(te_1, 2.0f * te_1, abs(hm_1 - mu_1.w)));
            if (cvLitReset > 0.0f)
            {
                float lm = l1 / 9.0f;
                float lsd = sqrt(max((l2 / 9.0f) - (lm * lm), 0.0f));
                float fm = f1 / 9.0f;
                float fsd = sqrt(max((f2 / 9.0f) - (fm * fm), 0.0f));
                float lref = max(0.5f * (lm + fm), cvLitFloor);
                // NV GL: x / (3 lref) as x * rcp(lref) fused with the 1 / 3 onto cvLitReset
                float tl = mad((cvAccResetSd * min(fsd, lsd)) * (1.0f / lref), 0.3333333432674407958984375f, cvLitReset);
                a = max(a, smoothstep(tl, 2.0f * tl, abs(lm - fm) / lref));
            }
        }
    }
    cvOut = lerp(c, coarse, a.xxxx);
    // the fresh march's mean distance (a mix with the 1e4 of no cloud means nothing); age 0
    cvDepth = float4(dk, 0.0f, 0.0f, 0.0f);
}

SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
{
    gl_FragCoord = stage_input.gl_FragCoord;
    gl_FragCoord.w = 1.0 / gl_FragCoord.w;
    frag_main();
    SPIRV_Cross_Output stage_output;
    stage_output.cvOut = cvOut;
    stage_output.cvDepth = cvDepth;
    return stage_output;
}
