// HLSL port of features/clouds/cloudmap.vert (vert shader). Generated by notes/hlslbulk1/tools/convert.py:
// glslang -G, then spirv-cross --hlsl; loose uniforms are the LooseUniforms cbuffer (register b31); the
// GLSL includes are inlined as the loader does. Fusion Shaders (F4FS) feeds it the GL-side inputs
// named in notes/vkcompute1/hlsl_plan.md. Not wired: nothing loads this file.
// profile: vs_6_0
#include "CloudsBindingsVk.hlsli"
cbuffer LooseUniforms : register(b31, space0)
{
    bool cmShow;
    bool cmQuad;	// SKYLIGHT1 round 3: the layer laid on the world (a quad over the map, uv from the world point)
    float2 uvOffset;	// the layer's scroll
    float cmHeight;	// the band plane above the eye, game units
    float cmHalfExtent;	// the map square's half side, game units
};

static float4 gl_Position;
static float vfade;
static float2 uv;
static float3 vertexPosition;
static float4 vertexColor;
static float2 multiTexCoord0;

struct SPIRV_Cross_Input
{
    float3 vertexPosition : TEXCOORD0;
    float4 vertexColor : TEXCOORD1;
    float2 multiTexCoord0 : TEXCOORD7;
};

struct SPIRV_Cross_Output
{
    float vfade : TEXCOORD0;
    float2 uv : TEXCOORD1;
    float4 gl_Position : SV_Position;
};

void vert_main()
{
    if (cmShow)
    {
        vfade = 1.0f;
        uv = (vertexPosition.xy * 0.5f) + 0.5f.xx;
        gl_Position = float4(vertexPosition.xy, 0.0f, 1.0f);
        return;
    }
    if (cmQuad)
    {
        vfade = vertexColor.w;
        uv = multiTexCoord0 + uvOffset;
        gl_Position = float4(vertexPosition.xy, 0.0f, 1.0f);
        return;
    }
    vfade = vertexColor.w;
    uv = multiTexCoord0 + uvOffset;
    gl_Position = float4(vertexPosition.xy * (cmHeight / cmHalfExtent), 0.0f, vertexPosition.z);
}

SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
{
    vertexPosition = stage_input.vertexPosition;
    vertexColor = stage_input.vertexColor;
    multiTexCoord0 = stage_input.multiTexCoord0;
    vert_main();
    SPIRV_Cross_Output stage_output;
    stage_output.gl_Position = gl_Position;
    stage_output.vfade = vfade;
    stage_output.uv = uv;
    return stage_output;
}
