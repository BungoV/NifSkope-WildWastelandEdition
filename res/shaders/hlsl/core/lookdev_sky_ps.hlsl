// HLSL port of lookdev_sky.frag (frag shader). Generated by notes/hlslbulk1/tools/convert.py:
// glslang -G, then spirv-cross --hlsl; loose uniforms are the LooseUniforms cbuffer (register b31); the
// GLSL includes' functions are #included from the shared .hlsli files, the rest is inlined as the loader does. Fusion Shaders (F4FS) feeds it the GL-side inputs
// named in notes/vkcompute1/hlsl_plan.md. Not wired: nothing loads this file.
// profile: ps_6_0
#include "CoreBindingsVk.hlsli"
cbuffer globalUniforms : register(b0, space0)
{
    row_major float3x3 viewMatrix : packoffset(c0);
    row_major float3x3 envMapRotation : packoffset(c3);
    row_major float4x4 projectionMatrix : packoffset(c6);
    float4 lightSourcePosition[3] : packoffset(c10);
    float4 lightSourceDiffuse[3] : packoffset(c13);
    float4 lightSourceAmbient : packoffset(c16);
    float toneMapScale : packoffset(c17);
    float brightnessScale : packoffset(c17.y);
    float glowScale : packoffset(c17.z);
    float glowScaleSRGB : packoffset(c17.w);
    int4 viewportDimensions : packoffset(c18);
    uint doSkinning : packoffset(c19);
    int sceneOptions : packoffset(c19.y);
    int cubeBgndMipLevel : packoffset(c19.z);
    int sfParallaxMaxSteps : packoffset(c19.w);
    float sfParallaxScale : packoffset(c20);
    float sfParallaxOffset : packoffset(c20.y);
    float unusedUniform1 : packoffset(c20.z);
    float unusedUniform2 : packoffset(c20.w);
};

cbuffer LooseUniforms : register(b31, space0)
{
    float sceneExposure;
    int viewTransform;
    bool invertZAxis;
    bool hasCubeMap;
    bool sunDiscUp;
    float3 sunDiscView;	// view space, unit; z of the WORLD disc <= 0 -> sunDiscUp false
    float3 sunLinear;
};
TextureCube<float4> CubeMap : register(t0, space0);
SamplerState _CubeMap_sampler : register(s0, space0);

static float4 fragColor;
static float2 ndc;

struct SPIRV_Cross_Input
{
    float2 ndc : TEXCOORD0;
};

struct SPIRV_Cross_Output
{
    float4 fragColor : SV_Target0;
};

// AgX, Benjamin Wrensch's minimal fit (sRGB display out, the "base" look)
#define WW_FN_agxContrast
#define WW_FN_agxDisplay
#include "lookdev_output.hlsli"
#undef WW_FN_agxContrast
#undef WW_FN_agxDisplay

// Khronos PBR Neutral (linear in, linear out)
#define WW_FN_pbrNeutral
#include "lookdev_output.hlsli"
#undef WW_FN_pbrNeutral

// the sRGB OETF: the encode is here, never GL_FRAMEBUFFER_SRGB (docs s8)
#define WW_FN_linearToSrgb
#define WW_FN_studioOutput
#include "lookdev_output.hlsli"
#undef WW_FN_linearToSrgb
#undef WW_FN_studioOutput

void frag_main()
{
    if (projectionMatrix[3].w == 1.0f)
    {
        float3 param = 0.180000007152557373046875f.xxx;
        float3 tmp290 = studioOutput(param);
        fragColor = float4(tmp290, 1.0f);
        return;
    }
    float3 ray = normalize(float3((ndc.x + projectionMatrix[2].x) / projectionMatrix[0].x, (ndc.y + projectionMatrix[2].y) / projectionMatrix[1].y, -1.0f));
    float3x3 r = envMapRotation;
    if (invertZAxis)
    {
        r[0].z *= (-1.0f);
        r[1].z *= (-1.0f);
        r[2].z *= (-1.0f);
    }
    float3 tmp346;
    if (hasCubeMap)
    {
        tmp346 = CubeMap.SampleLevel(_CubeMap_sampler, mul(ray, r), 0.0f).xyz;
    }
    else
    {
        tmp346 = 0.180000007152557373046875f.xxx;
    }
    float3 color = tmp346;
    if (sunDiscUp)
    {
        float VdotL = dot(ray, normalize(sunDiscView));
        if (VdotL > 0.0f)
        {
            float alpha = 0.00999999977648258209228515625f;
            float a2 = alpha * alpha;
            float denom = ((VdotL * a2) + a2) + max(1.0f - VdotL, 0.0f);
            color += ((sunLinear * (a2 / (denom * denom))) * VdotL);
        }
    }
    float3 param_1 = color;
    float3 tmp406 = studioOutput(param_1);
    fragColor = float4(tmp406, 1.0f);
}

SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
{
    ndc = stage_input.ndc;
    frag_main();
    SPIRV_Cross_Output stage_output;
    stage_output.fragColor = fragColor;
    return stage_output;
}
