// HLSL port of sk_effectshader.frag (frag shader). Generated by notes/hlslbulk1/tools/convert.py:
// glslang -G, then spirv-cross --hlsl; loose uniforms are the LooseUniforms cbuffer (register b31); the
// GLSL includes are inlined as the loader does. Fusion Shaders (F4FS) feeds it the GL-side inputs
// named in notes/vkcompute1/hlsl_plan.md. Not wired: nothing loads this file.
// profile: ps_6_0
#include "CoreBindingsVk.hlsli"
cbuffer globalUniforms : register(b0, space0)
{
    row_major float3x3 viewMatrix : packoffset(c0);
    row_major float3x3 envMapRotation : packoffset(c3);
    row_major float4x4 projectionMatrix : packoffset(c6);
    float4 lightSourcePosition[3] : packoffset(c10);
    float4 lightSourceDiffuse[3] : packoffset(c13);
    float4 lightSourceAmbient : packoffset(c16);
    float toneMapScale : packoffset(c17);
    float brightnessScale : packoffset(c17.y);
    float glowScale : packoffset(c17.z);
    float glowScaleSRGB : packoffset(c17.w);
    int4 viewportDimensions : packoffset(c18);
    uint doSkinning : packoffset(c19);
    int sceneOptions : packoffset(c19.y);
    int cubeBgndMipLevel : packoffset(c19.z);
    int sfParallaxMaxSteps : packoffset(c19.w);
    float sfParallaxScale : packoffset(c20);
    float sfParallaxOffset : packoffset(c20.y);
    float unusedUniform1 : packoffset(c20.z);
    float unusedUniform2 : packoffset(c20.w);
};

Texture2D<float4> GreyscaleMap : register(t0, space0);
SamplerState _GreyscaleMap_sampler : register(s0, space0);
Texture2D<float4> BaseMap : register(t1, space0);
SamplerState _BaseMap_sampler : register(s1, space0);
cbuffer LooseUniforms : register(b31, space0)
{
    float2 uvScale;
    float2 uvOffset;
    float falloffDepth;
    bool useFalloff;
    float4 falloffParams;
    float4 glowColor;
    bool hasWeaponBlood;
    bool greyscaleColor;
    bool greyscaleAlpha;
    int alphaFlags;	// bits 0 to 2: alpha test mode, bit 3: alpha blending enabled
    float alphaThreshold;
    float glowMult;
    bool hasSourceTexture;
    bool hasGreyscaleMap;
    bool vertexColors;
    bool vertexAlpha;
};

static float2 texCoord;
static float3 N;
static float3 ViewDir;
static float4 C;
static float4 fragColor;
static float3 LightDir;

struct SPIRV_Cross_Input
{
    WW_LOC(3) float3 LightDir : TEXCOORD3;
    WW_LOC(4) float3 ViewDir : TEXCOORD4;
    WW_LOC(8) float2 texCoord : TEXCOORD8;
    WW_LOC(1) float4 C : TEXCOORD1;
    WW_LOC(5) float3 N : TEXCOORD5;
};

struct SPIRV_Cross_Output
{
    float4 fragColor : SV_Target0;
};

float4 colorLookup(float x, float y)
{
    return GreyscaleMap.Sample(_GreyscaleMap_sampler, float2(clamp(x, 0.0f, 1.0f), clamp(y, 0.0f, 1.0f)));
}

void frag_main()
{
    float4 baseMap = BaseMap.Sample(_BaseMap_sampler, (texCoord * uvScale) + uvOffset);
    float3 normal = normalize(N);
    // Reconstructed normal
    // normal = normalize(cross(dFdy(v.xyz), dFdx(v.xyz)));
    float3 E = normalize(ViewDir);
    float part = falloffDepth;
    // Falloff
    float falloff = 1.0f;
    if (useFalloff)
    {
        float startO = min(falloffParams.z, 1.0f);
        float stopO = max(falloffParams.w, 0.0f);
        // TODO: When X and Y are both 0.0 or both 1.0 the effect is reversed.
        falloff = smoothstep(falloffParams.y, falloffParams.x, abs(E.z));
        falloff = lerp(max(falloffParams.w, 0.0f), min(falloffParams.z, 1.0f), falloff);
    }
    float alphaMult = glowColor.w * glowColor.w;
    float4 color = baseMap;
    if (hasWeaponBlood)
    {
        float3 colorPart3 = float3(1.0f, 0.0f, 0.0f) * baseMap.x;
        color.x = colorPart3.x;
        color.y = colorPart3.y;
        color.z = colorPart3.z;
        color.w = baseMap.w * baseMap.y;
    }
    color *= C;
    float4 colorPart2 = color;
    float3 colorPart = colorPart2.xyz * glowColor.xyz;
    color.x = colorPart.x;
    color.y = colorPart.y;
    color.z = colorPart.z;
    color.w *= (falloff * alphaMult);
    if (greyscaleColor)
    {
        // Only Red emissive channel is used
        float emRGB = glowColor.x;
        float xArg2 = baseMap.y;
        float yArg2 = (C.y * falloff) * emRGB;
        float4 luG = colorLookup(xArg2, yArg2);
        color.x = luG.xyz.x;
        color.y = luG.xyz.y;
        color.z = luG.xyz.z;
    }
    if (greyscaleAlpha)
    {
        float xArg = baseMap.w;
        float yArg = (C.w * falloff) * alphaMult;
        float4 luA = colorLookup(xArg, yArg);
        color.w = luA.w;
    }
    if (alphaFlags > 0)
    {
        int mPick;
        if (color.w < alphaThreshold)
        {
            mPick = 11051;
        }
        else
        {
            mPick = (color.w > alphaThreshold) ? 29041 : 19789;
        }
        // 0: always, 1: <, 2: ==, 3: <=, 4: >, 5: !=, 6: >=, 7: never
        int m = mPick;
        if ((m & (1 << alphaFlags)) == 0)
        {
            discard;
        }
    }
    if (alphaFlags < 8)
    {
        color.w = 1.0f;
    }
    fragColor = float4(color.xyz * (glowMult * sqrt(brightnessScale)), color.w);
}

SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
{
    texCoord = stage_input.texCoord;
    N = stage_input.N;
    ViewDir = stage_input.ViewDir;
    C = stage_input.C;
    LightDir = stage_input.LightDir;
    frag_main();
    SPIRV_Cross_Output stage_output;
    stage_output.fragColor = fragColor;
    return stage_output;
}
