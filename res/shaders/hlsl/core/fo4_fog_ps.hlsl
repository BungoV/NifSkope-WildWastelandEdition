float wwDecalVertexA(float vertexA)
{
    if (!wwDecalAngle)
    {
        return vertexA;
    }
    return clamp(((vertexA / max(length(btnMatrix[2]), 9.9999997473787516355514526367188e-05f)) - 0.300000011920928955078125f) / 0.25f, 0.0f, 1.0f);
}

// Schlick's Fresnel approximation
float fresnelSchlick(float VdotH, float F0)
{
    float base = 1.0f - VdotH;
    float _exp = pow(base, fresnelPower);
    return clamp(_exp + (F0 * (1.0f - _exp)), 0.0f, 1.0f);
}

// GGX/Trowbridge-Reitz normal distribution. Ported from the PBR Material
// Editor's shader (D_GGX/G1 there) so the two tools agree on the spec/gloss
// response instead of NifSkope using a normalized Phong lobe.
float D_GGX(float NdotH, float alpha_1)
{
    float a2 = alpha_1 * alpha_1;
    float d = ((NdotH * NdotH) * (a2 - 1.0f)) + 1.0f;
    return a2 / max((3.1415927410125732421875f * d) * d, 9.9999997473787516355514526367188e-05f);
}

// Smith geometry term, one direction. k = (rough+1)^2/8 (the editor's split).
float G1(float NdotX, float k)
{
    return NdotX / max((NdotX * (1.0f - k)) + k, 9.9999997473787516355514526367188e-05f);
}

// The Torrance-Sparrow visibility factor, G
float VisibDiv(float NdotL, float NdotV, float VdotH, float NdotH)
{
    float denom = max(VdotH, 1.1920928955078125e-07f);
    float numL = min(NdotV, NdotL);
    float numR = 2.0f * NdotH;
    if (denom >= (numL * numR))
    {
        float tmp4586;
        if (numL == NdotV)
        {
            tmp4586 = 1.0f;
        }
        else
        {
            tmp4586 = NdotL / NdotV;
        }
        numL = tmp4586;
        return (numL * numR) / denom;
    }
    return 1.0f / NdotV;
}

// this is a normalized Phong model used in the Torrance-Sparrow model
float3 TorranceSparrow(float NdotL, float NdotH, float NdotV, float VdotH, float3 color, float power, float F0)
{
    float D_1 = ((power + 2.0f) / 6.283185482025146484375f) * pow(NdotH, power);
    float param = NdotL;
    float param_1 = NdotV;
    float param_2 = VdotH;
    float param_3 = NdotH;
    float G_NdotV = VisibDiv(param, param_1, param_2, param_3);
    float param_4 = VdotH;
    float param_5 = F0;
    float F = fresnelSchlick(param_4, param_5);
    float spec = ((F * G_NdotV) * D_1) / 4.0f;
    return (color * spec) * 3.1415927410125732421875f;
}

float OrenNayarFull(float NdotL, float NdotV, float LdotV, float roughness)
{
    float NdotL0 = clamp(NdotL, 1.1920928955078125e-07f, 1.0f);
    float angleVN = acos(clamp(abs(NdotV), 1.1920928955078125e-07f, 1.0f));
    float angleLN = acos(NdotL0);
    float alpha_1 = max(angleVN, angleLN);
    float beta = min(angleVN, angleLN);
    float gamma = (LdotV - (NdotL * NdotV)) / sqrt(max((1.0f - (NdotL * NdotL)) * (1.0f - (NdotV * NdotV)), 2.4999999368446879088878631591797e-05f));
    float roughnessSquared = roughness * roughness;
    float roughnessSquared9 = roughnessSquared / (roughnessSquared + 0.0900000035762786865234375f);
    float C1 = 1.0f - (0.5f * (roughnessSquared / (roughnessSquared + 0.3300000131130218505859375f)));
    float C2 = 0.449999988079071044921875f * roughnessSquared9;
    if (gamma >= 0.0f)
    {
        C2 *= sin(alpha_1);
    }
    else
    {
        C2 *= (sin(alpha_1) - pow((2.0f * beta) / 3.1415927410125732421875f, 3.0f));
    }
    float powValue = ((4.0f * alpha_1) * beta) / 9.8696041107177734375f;
    float C3 = ((0.125f * roughnessSquared9) * powValue) * powValue;
    float asym = 1.57079637050628662109375f;
    float lim1 = asym + 0.004999999888241291046142578125f;
    float lim2 = asym - 0.004999999888241291046142578125f;
    float ab2 = (alpha_1 + beta) / 2.0f;
    if ((beta >= asym) && (beta < lim1))
    {
        beta = lim1;
    }
    else
    {
        if ((beta < asym) && (beta >= lim2))
        {
            beta = lim2;
        }
    }
    if ((ab2 >= asym) && (ab2 < lim1))
    {
        ab2 = lim1;
    }
    else
    {
        if ((ab2 < asym) && (ab2 >= lim2))
        {
            ab2 = lim2;
        }
    }
    float A_1 = (gamma * C2) * tan(beta);
    float B = ((1.0f - abs(gamma)) * C3) * tan(ab2);
    float L1 = NdotL0 * ((C1 + A_1) + B);
    float twoBetaPi = (2.0f * beta) / 3.1415927410125732421875f;
    float L2 = ((0.17000000178813934326171875f * NdotL0) * (roughnessSquared / (roughnessSquared + 0.12999999523162841796875f))) * (1.0f - ((gamma * twoBetaPi) * twoBetaPi));
    return L1 + L2;
}

