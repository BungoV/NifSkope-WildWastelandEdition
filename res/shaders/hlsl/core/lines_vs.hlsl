// HLSL port of lines.vert (vert shader). Generated by notes/hlslbulk1/tools/convert.py:
// glslang -G, then spirv-cross --hlsl; loose uniforms are the LooseUniforms cbuffer (register b31); the
// GLSL includes are inlined as the loader does. Fusion Shaders (F4FS) feeds it the GL-side inputs
// named in notes/vkcompute1/hlsl_plan.md. Not wired: nothing loads this file.
// profile: vs_6_0
#include "CoreBindingsVk.hlsli"
cbuffer LooseUniforms : register(b31, space0)
{
    row_major float4x4 modelViewMatrix;
    float4 vertexColorOverride;	// components greater than zero replace the vertex color
    float4 highlightColor;
};

static float4 gl_Position;
static float3 vertexPosition;
static float4 vsColor;
static float4 vertexColor;

struct SPIRV_Cross_Input
{
    float3 vertexPosition : TEXCOORD0;
    float4 vertexColor : TEXCOORD1;
};

struct SPIRV_Cross_Output
{
    WW_LOC(0) float4 vsColor : TEXCOORD0;
    float4 gl_Position : SV_Position;
};

void vert_main()
{
    float4 v = float4(vertexPosition, 1.0f);
    gl_Position = mul(v, modelViewMatrix);
    bool4 vsColorPart = bool4(vertexColorOverride.x > 0.0f.xxxx.x, vertexColorOverride.y > 0.0f.xxxx.y, vertexColorOverride.z > 0.0f.xxxx.z, vertexColorOverride.w > 0.0f.xxxx.w);
    vsColor = float4(vsColorPart.x ? vertexColorOverride.x : vertexColor.x, vsColorPart.y ? vertexColorOverride.y : vertexColor.y, vsColorPart.z ? vertexColorOverride.z : vertexColor.z, vsColorPart.w ? vertexColorOverride.w : vertexColor.w);
}

SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
{
    vertexPosition = stage_input.vertexPosition;
    vertexColor = stage_input.vertexColor;
    vert_main();
    SPIRV_Cross_Output stage_output;
    stage_output.gl_Position = gl_Position;
    stage_output.vsColor = vsColor;
    return stage_output;
}
