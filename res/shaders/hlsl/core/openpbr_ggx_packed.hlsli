struct WwOpenPbrGgxTable
{
	float3 operator[]( int i )
	{
		const float4 p = wwOpenPbrGgxPacked[uint( i ) >> 1];
		const float2 v = ( uint( i ) & 1u ) != 0u ? p.zw : p.xy;
		return float3( v.x, 0.0, v.y );
	}
};
// The sheen (fuzz) table: no .pbrm layer reads it; declared so the copy's fuzz function compiles (it returns 0 if called)
struct WwOpenPbrNoTable
{
	float3 operator[]( int i ) { return (float3)( 0.0 ); }
};
static const WwOpenPbrGgxTable OpenPbrGgxEnergyTable;
static const WwOpenPbrNoTable OpenPbrFuzzTable;
