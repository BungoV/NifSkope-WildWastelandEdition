// HLSL port of boltstrip.frag (frag shader). Generated by notes/hlslbulk1/tools/convert.py:
// glslang -G, then spirv-cross --hlsl; loose uniforms are the LooseUniforms cbuffer (register b31); the
// GLSL includes are inlined as the loader does. Fusion Shaders (F4FS) feeds it the GL-side inputs
// named in notes/vkcompute1/hlsl_plan.md. Not wired: nothing loads this file.
// profile: ps_6_0
#include "CoreBindingsVk.hlsli"
Texture2D<float4> boltTexture : register(t0, space0);
SamplerState _boltTexture_sampler : register(s0, space0);
cbuffer LooseUniforms : register(b31, space0)
{
    bool greyscaleColor;
    float paletteRow;	// the effect's base colour R, the palette row
    bool greyscaleAlpha;
};
Texture2D<float4> GreyscaleMap : register(t1, space0);
SamplerState _GreyscaleMap_sampler : register(s1, space0);

static float2 texCoord;
static float4 fragColor;
static float4 C;

struct SPIRV_Cross_Input
{
    float4 C : TEXCOORD0;
    float2 texCoord : TEXCOORD1;
};

struct SPIRV_Cross_Output
{
    float4 fragColor : SV_Target0;
};

void frag_main()
{
    float4 tex = boltTexture.Sample(_boltTexture_sampler, texCoord);
    fragColor = tex * C;
    if (greyscaleColor)
    {
        float3 GreyscaleMapTexel = GreyscaleMap.SampleLevel(_GreyscaleMap_sampler, float2(tex.y, paletteRow), 0.0f).xyz;
        fragColor.x = GreyscaleMapTexel.x;
        fragColor.y = GreyscaleMapTexel.y;
        fragColor.z = GreyscaleMapTexel.z;
    }
    if (greyscaleAlpha)
    {
        fragColor.w = GreyscaleMap.SampleLevel(_GreyscaleMap_sampler, float2(tex.w, C.w), 0.0f).w;
    }
}

SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
{
    texCoord = stage_input.texCoord;
    C = stage_input.C;
    frag_main();
    SPIRV_Cross_Output stage_output;
    stage_output.fragColor = fragColor;
    return stage_output;
}
