// one placed light on a lit effect at world point P, as the game's lit effect shader sums it
float3 cellFxLight(int i, float3 P)
{
    // lane FXLIT1: the stride is HEMI1's 8 texels a light
    float4 t0 = cellLights.Load(i * 8);
    float4 t1 = cellLights.Load((i * 8) + 1);
    float3 Lv = t0.xyz - P;
    float d = length(Lv);
    float q = clamp(d / max(t0.w, 0.001000000047497451305389404296875f), 0.0f, 1.0f);
    float a = 1.0f - (q * q);
    if ((fxLitMode & 4) == 0)
    {
        a = pow(a, 2.2000000476837158203125f);
    }
    bool cond12 = cellLightPhys.x > 0.5f;
    bool cond11;
    if (cond12)
    {
        cond11 = (fxLitMode & 4) == 0;
    }
    else
    {
        cond11 = cond12;
    }
    if (cond11)
    {
        float vanArg = a;
        float xArg = q;
        float rArg = t0.w;
        float3 cArg = float3(0.0f, 1.0f, 2.0f);
        a = cellPhysFalloff(vanArg, xArg, rArg, cArg);
    }
    // lane LIGHTS5 (GOBO-FX): the light's pattern, as on surfaces (GOBO2: every shape)
    float3 g = 1.0f.xxx;
    float3 gAx = 0.0f.xxx;
    // a spot: the game's cone, its cosine + 0.001
    if (t1.w > (-1.5f))
    {
        float4 t2 = cellLights.Load((i * 8) + 2);
        float c = clamp(dot((-Lv) / max(d, 0.001000000047497451305389404296875f).xxx, t2.xyz), 0.0f, 1.0f);
        float base = clamp(1.0f - ((1.0f - c) / max(1.0f - (t1.w + 0.001000000047497451305389404296875f), 9.9999997473787516355514526367188e-05f)), 0.0f, 1.0f);
        a *= min(pow(base, max(t2.w, 0.001000000047497451305389404296875f)), 1.0f);
        gAx = t2.xyz;
    }
    if (a > 0.0f)
    {
        int iArg2 = i;
        float3 DArg = -Lv;
        float3 axisArg = gAx;
        bool spotArg = t1.w > (-1.5f);
        g = cellGobo(iArg2, DArg, axisArg, spotArg);
    }
    return (t1.xyz * g) * a;
}

