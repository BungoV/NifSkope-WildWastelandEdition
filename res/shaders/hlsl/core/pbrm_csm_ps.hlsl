// Lazarov's analytic environment DFG (FO4CS truepbr_brdf.hlsli:90-93), perceptual
// roughness: env specular = F0 * x + y. No LUT texture.
float2 dfgLazarov(float NdotV, float r)
{
    float4 rr = (float4(-1.0f, -0.0274999998509883880615234375f, -0.572000026702880859375f, 0.02199999988079071044921875f) * r) + float4(1.0f, 0.0425000004470348358154296875f, 1.03999996185302734375f, -0.039999999105930328369140625f);
    float a004 = (min(rr.x * rr.x, exp2((-9.27999973297119140625f) * NdotV)) * rr.x) + rr.y;
    return (float2(-1.03999996185302734375f, 1.03999996185302734375f) * a004) + rr.zw;
}

// The specular F0 the multiscatter term takes (FO4CS: lerp(F0_diel, base, metal))
float3 surfaceF0(Surface s)
{
    return lerp(s.f0d * s.weight, s.base * s.weight, s.metal.xxx);
}

// Multiscatter energy compensation (FO4CS truepbr_brdf.hlsli:104-105). Debug "noms": 1.
float3 multiScatter(Surface s, float2 dfg)
{
    if ((r3Red & 1) != 0)
    {
        return 1.0f.xxx;
    }
    float Ess = max(clamp(dfg.x + dfg.y, 0.0f, 1.0f), 0.0500000007450580596923828125f);
    Surface param = s;
    return 1.0f.xxx + (clamp(surfaceF0(param), 0.0f.xxx, 1.0f.xxx) * ((1.0f / Ess) - 1.0f));
}

float3 dielF0(Surface s)
{
    return clamp(s.f0d * s.weight, 0.0f.xxx, 1.0f.xxx);
}

float3 dielF90(Surface s)
{
    if ((r3Red & 4) != 0)
    {
        return 1.0f.xxx;
    }
    Surface param = s;
    return clamp(dielF0(param) * 50.0f, 0.0f.xxx, 1.0f.xxx);
}

// E_spec: the specular lobe's directional albedo, multiscatter included -- the env
// specular scale and the energy the indirect diffuse gives up
float3 specAlbedo(Surface s, float2 dfg, float3 ms)
{
    float3 tmp7791;
    if ((r3Red & 16) != 0)
    {
        tmp7791 = ((s.f0d * dfg.x) + dfg.y.xxx) * s.weight;
    }
    else
    {
        Surface param = s;
        Surface param_1 = s;
        tmp7791 = (dielF0(param) * dfg.x) + (dielF90(param_1) * dfg.y);
    }
    float3 diel = tmp7791;
    float3 metl = ((s.base * dfg.x) + (s.tint * dfg.y)) * s.weight;
    return lerp(diel, metl, s.metal.xxx) * ms;
}

float pow5(float x)
{
    float x2 = x * x;
    return (x2 * x2) * x;
}

float3 fresnelSchlick(float c, float3 F0)
{
    float param = clamp(1.0f - c, 0.0f, 1.0f);
    return F0 + ((1.0f.xxx - F0) * pow5(param));
}

// OpenPBR F82 conductor Fresnel (the editor's, materialpreviewwidget.cpp:1789):
// Schlick bent so the 82-degree reflectance is tint x Schlick(82); tint 1 = Schlick.
float3 fresnelF82(float mu, float3 f0, float3 tint)
{
    float param = mu;
    float3 param_1 = f0;
    float3 fs = fresnelSchlick(param, param_1);
    float param_2 = 0.14285714924335479736328125f;
    float3 param_3 = f0;
    float3 fsb = fresnelSchlick(param_2, param_3);
    float3 b = (fsb * (1.0f.xxx - tint)) / 0.0566527806222438812255859375f.xxx;
    return clamp(fs - ((b * mu) * pow(1.0f - mu, 6.0f)), 0.0f.xxx, 1.0f.xxx);
}

// The whole specular Fresnel of the surface at cosine c
float3 surfaceF(Surface s, float c)
{
    float3 fd;
    if ((r3Red & 16) != 0)
    {
        float param = c;
        float3 param_1 = s.f0d;
        fd = fresnelSchlick(param, param_1) * s.weight;
    }
    else
    {
        Surface param_2 = s;
        float3 F0 = dielF0(param_2);
        Surface param_3 = s;
        float param_4 = clamp(1.0f - c, 0.0f, 1.0f);
        fd = F0 + ((dielF90(param_3) - F0) * pow5(param_4));
    }
    float param_5 = c;
    float3 param_6 = s.base;
    float3 param_7 = s.tint;
    return lerp(fd, fresnelF82(param_5, param_6, param_7) * s.weight, s.metal.xxx);
}

// EON directional albedo (Portsmouth-Kutz-Hill 2024 fit; the editor's eonAlbedo)
float eonAlbedo(float mu, float r)
{
    float mc = 1.0f - mu;
    float mc2 = mc * mc;
    float g = ((0.057108528912067413330078125f * mc) + (0.4918818771839141845703125f * mc2)) + ((((-0.332181453704833984375f) * mc) + (0.071442998945713043212890625f * mc2)) * mc2);
    return (1.0f + (r * g)) / (1.0f + (0.28786098957061767578125f * r));
