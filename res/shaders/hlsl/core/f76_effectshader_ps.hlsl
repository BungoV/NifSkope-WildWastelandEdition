        color.y = GreyscaleMapTexel.y;
        color.z = GreyscaleMapTexel.z;
    }
    if (greyscaleAlpha)
    {
        color.w = GreyscaleMap.SampleLevel(_GreyscaleMap_sampler, float2(BaseMap.Sample(_BaseMap_sampler, offset).w, color.w), 0.0f).w;
    }
    if (alphaFlags > 0)
    {
        int mPick;
        if (color.w < alphaThreshold)
        {
            mPick = 11051;
        }
        else
        {
            mPick = (color.w > alphaThreshold) ? 29041 : 19789;
        }
        // 0: always, 1: <, 2: ==, 3: <=, 4: >, 5: !=, 6: >=, 7: never
        int m = mPick;
        if ((m & (1 << alphaFlags)) == 0)
