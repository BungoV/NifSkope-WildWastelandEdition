    {
        float m_1 = roughness * ((roughness * (-4.0f)) + 10.0f);
        float3 cube = CubeMap.SampleLevel(_CubeMap_sampler, reflectedWS, max(m_1, 0.0f)).xyz;
        cube *= (envReflection * g);
        cube = lerp(cube, cube * lightSourceDiffuse[0].xyz, lightingInfluence.xxx);
        if (hasEnvMask)
        {
            cube *= EnvironmentMap.Sample(_EnvironmentMap_sampler, offset).xyz;
        }
        float4 colorPart2 = color;
        float3 colorPart = colorPart2.xyz + (cube * falloff);
        color.x = colorPart.x;
        color.y = colorPart.y;
        color.z = colorPart.z;
    }
    fragColor = float4(color.xyz * brightnessScale, color.w);
