    float4 normalMap = NormalMap.Sample(_NormalMap_sampler, offset);
    float4 reflMap = ReflMap.Sample(_ReflMap_sampler, offset);
    float3 normal = normalMap.xyz;
    // Calculate missing blue channel
    normal.z = sqrt(max(1.0f - dot(normal.xy, normal.xy), 0.0f));
    normal = normalize(mul(normal, btnMatrix_norm));
    if (!gl_FrontFacing)
    {
        normal *= (-1.0f);
    }
    float3 f0 = reflMap.xyz;
    float3 L = normalize(LightDir);
    float3 V = ViewDir_norm;
    float3 R = reflect(-V, normal);
    float3 H = normalize(L + V);
    float NdotL = max(dot(normal, L), 9.9999999747524270787835121154785e-07f);
    float NdotH = max(dot(normal, H), 9.9999999747524270787835121154785e-07f);
    float NdotV = max(abs(dot(normal, V)), 9.9999999747524270787835121154785e-07f);
    float LdotH = max(dot(L, H), 9.9999999747524270787835121154785e-07f);
    float NdotNegL = max(dot(normal, -L), 9.9999999747524270787835121154785e-07f);
    float3 reflectedWS = mul(R, reflMatrix);
    if (greyscaleAlpha)
    {
        baseMap.w = 1.0f;
    }
    float4 baseColor = glowColor;
    if (!greyscaleColor)
    {
        float4 baseColorPart2 = baseColor;
        float3 baseColorPart = baseColorPart2.xyz * glowMult;
        baseColor.x = baseColorPart.x;
        baseColor.y = baseColorPart.y;
        baseColor.z = baseColorPart.z;
