        }
        else
        {
            UVStream uvStreamArg2 = lm.blenders[n].uvStream;
            float2 offset = getTexCoord(uvStreamArg2);
            r = textureUnits[lm.blenders[n].maskTexture].Sample(_textureUnits_sampler[lm.blenders[n].maskTexture], offset).x;
        }
