        l *= exp2(luminanceParams.y);
        // minOffsetEmittance, maxOffsetEmittance
        if (adaptiveLimits)
        {
            l = clamp(l, luminanceParams.w, luminanceParams.z);
        }
    }
    return sqrt(l * 0.00999999977648258209228515625f) * glowScale;
}

float3 tonemap(float3 x, float y)
{
    float a = 0.1500000059604644775390625f;
    float b = 0.5f;
    float c = 0.100000001490116119384765625f;
    float d = 0.20000000298023223876953125f;
    float e = 0.0199999995529651641845703125f;
    float f = 0.300000011920928955078125f;
    float3 z = x * (y * 4.229787349700927734375f);
    z = (((z * ((z * a) + (b * c).xxx)) + (d * e).xxx) / ((z * ((z * a) + b.xxx)) + (d * f).xxx)) - (e / f).xxx;
    return z / (y * 0.933333337306976318359375f).xxx;
}

