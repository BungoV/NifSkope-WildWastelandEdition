void directLight(Surface s, float3 L, float3 V, float3 ms, out float3 dDiff, out float3 dSpec)
{
    Surface param = s;
    float3 param_1 = L;
    float3 param_2 = L;
    float param_3 = s.rough;
    float3 param_4 = V;
    float3 param_5 = ms;
    float3 param_6;
    float3 param_7;
    directLightA(param, param_1, param_2, param_3, param_4, param_5, param_6, param_7);
    dDiff = param_6;
    dSpec = param_7;
}

