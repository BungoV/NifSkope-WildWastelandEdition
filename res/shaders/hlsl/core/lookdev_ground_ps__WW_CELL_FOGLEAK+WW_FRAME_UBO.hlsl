    {
        wwAirTailJRet = dL / dT.xxx;
    }
    else
    {
        wwAirTailJRet = 0.0f.xxx;
    }
    return lerp(Jc, wwAirTailJRet, clamp(((dT * 64.0f) / max(last.w, 9.9999999747524270787835121154785e-07f)) - 1.0f, 0.0f, 1.0f).xxx);
