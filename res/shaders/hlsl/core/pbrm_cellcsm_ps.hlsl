void frag_main()
{
    wwAirFree = false;
    ussLastTerr = 1.0f;
    csmNOff = 0.0f.xxx;
    cellDirVis = 1.0f;
    cellBackK = 0.0f;
    cellAirDif = 0.0f;
    cellExtAmb = 0.0f.xxx;
    cellExtSpec = 0.0f.xxx;
    cellReflAdd = 0.0f.xxx;
    cellSpecTint = 1.0f.xxx;
    cellGiPath = 0;
    cellFarIters = 0;
    ViewDir_norm = normalize(ViewDir);
    btnMatrix_norm = float3x3(float3(normalize(btnMatrix[0])), float3(normalize(btnMatrix[1])), float3(normalize(btnMatrix[2])));
    cellEmitOut = 0.0f.xxxx;
    float2 offset = (texCoord * uvScale) + uvOffset;
    // --- base color / opacity ---
    float3 base = pbrBaseColor;
    float op = pbrOpacity;
    int bitArg13 = 1;
    if (hasFeature(bitArg13))
    {
        float4 bc = BaseMap.Sample(_BaseMap_sampler, offset);
        float3 basePick;
        if (baseIsSrgbTex)
        {
            basePick = bc.xyz;
        }
        else
        {
            float3 cArg9 = bc.xyz;
            basePick = srgbToLinear(cArg9);
        }
        // decoded as sRGB whatever the DXGI tag says: an sRGB-tagged
        base = basePick * pbrBaseColor;
        int bitArg12 = 2048;
        if (hasFeature(bitArg12))
        {
            float opPick;
            if (pbrComposition >= 0)
            {
                opPick = bc.w;
            }
            else
            {
                opPick = bc.w * pbrOpacity;
            }
            // the editor's baseAlpha replaces (ED:2258)
            op = opPick;
        }
    }
    bool cond27;
    if (pbrTintEnabled)
    {
        cond27 = (r4Red & 4) == 0;
    }
    else
    {
        cond27 = pbrTintEnabled;
    }
