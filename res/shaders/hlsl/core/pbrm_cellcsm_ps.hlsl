    float3 posViewArg = posView + (csmNOff * ussCsmTexel[i]);
    // lane SHADOWSHIMMER2: as csmHard
    float3 q = csmUvd(iArg, posViewArg);
    float zRefPick;
    if (ussCsmStable.w != 0.0f)
    {
