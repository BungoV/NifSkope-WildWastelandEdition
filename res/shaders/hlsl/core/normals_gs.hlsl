// HLSL port of normals.geom (geom shader). Generated by notes/hlslbulk1/tools/convert.py:
// glslang -G, then spirv-cross --hlsl; loose uniforms are the LooseUniforms cbuffer (register b31); the
// GLSL includes' functions are #included from the shared .hlsli files, the rest is inlined as the loader does. Fusion Shaders (F4FS) feeds it the GL-side inputs
// named in notes/vkcompute1/hlsl_plan.md. Not wired: nothing loads this file.
// profile: gs_6_0
#include "CoreBindingsVk.hlsli"
cbuffer globalUniforms : register(b0, space0)
{
    row_major float3x3 viewMatrix : packoffset(c0);
    row_major float3x3 envMapRotation : packoffset(c3);
    row_major float4x4 projectionMatrix : packoffset(c6);
    float4 lightSourcePosition[3] : packoffset(c10);
    float4 lightSourceDiffuse[3] : packoffset(c13);
    float4 lightSourceAmbient : packoffset(c16);
    float toneMapScale : packoffset(c17);
    float brightnessScale : packoffset(c17.y);
    float glowScale : packoffset(c17.z);
    float glowScaleSRGB : packoffset(c17.w);
    int4 viewportDimensions : packoffset(c18);
    uint doSkinning : packoffset(c19);
    int sceneOptions : packoffset(c19.y);
    int cubeBgndMipLevel : packoffset(c19.z);
    int sfParallaxMaxSteps : packoffset(c19.w);
    float sfParallaxScale : packoffset(c20);
    float sfParallaxOffset : packoffset(c20.y);
    float unusedUniform1 : packoffset(c20.z);
    float unusedUniform2 : packoffset(c20.w);
};

cbuffer LooseUniforms : register(b31, space0)
{
    float lineWidth;
    int btnSelection;	// 0: draw bitangent, 1: draw tangent, 2: draw normal
    float normalLineLength;	// line length in view space
};

static float4 gl_PositionIn[1];
static float4 gl_Position;
static float4 C;
static float4 vsColor[1];
static float3x3 btnMatrix[1];

struct SPIRV_Cross_Input
{
    WW_LOC(5) float3x3 btnMatrix : TEXCOORD5;
    WW_LOC(0) float4 vsColor : TEXCOORD0;
    float4 gl_PositionIn : SV_Position;
};

struct SPIRV_Cross_Output
{
    WW_LOC(1) float4 C : TEXCOORD1;
    float4 gl_Position : SV_Position;
};

#define WW_FN_drawLine
#include "drawline.hlsli"
#undef WW_FN_drawLine

void geom_main(point SPIRV_Cross_Input stage_input[1], inout TriangleStream<SPIRV_Cross_Output> geometry_stream)
{
    float4 c = float4(vsColor[0].xyz, vsColor[0].w * min(lineWidth, 1.0f));
    float4 d = float4(btnMatrix[0][clamp(btnSelection, 0, 2)] * normalLineLength, 0.0f);
    float4 p0 = mul(gl_PositionIn[0] - (d * 0.20000000298023223876953125f), projectionMatrix);
    float4 p1 = mul(gl_PositionIn[0] + (d * 0.800000011920928955078125f), projectionMatrix);
    float4 p0Arg = p0;
    float4 p1Arg = p1;
    float4 c0Arg = c;
    float4 c1Arg = c;
    drawLine(p0Arg, p1Arg, c0Arg, c1Arg, geometry_stream);
}

[maxvertexcount(4)]
void main(point SPIRV_Cross_Input stage_input[1], inout TriangleStream<SPIRV_Cross_Output> geometry_stream)
{
    for (int i = 0; i < 1; i++)
    {
        gl_PositionIn[i] = stage_input[i].gl_PositionIn;
    }
    for (int i = 0; i < 1; i++)
    {
        vsColor[i] = stage_input[i].vsColor;
    }
    for (int i = 0; i < 1; i++)
    {
        btnMatrix[i] = stage_input[i].btnMatrix;
    }
    geom_main(stage_input, geometry_stream);
}
