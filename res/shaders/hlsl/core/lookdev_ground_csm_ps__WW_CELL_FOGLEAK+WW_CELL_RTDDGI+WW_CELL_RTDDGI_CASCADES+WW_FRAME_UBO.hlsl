    if (ussCsmStable.w != 0.0f)
    {
        zRefPick = ussCsmBias[i];
    }
    else
    {
        zRefPick = offsetWorld;
    }
    float zRef = q.z - (zRefPick * csmInvRange[i]);
    float k = 6.0f / csmParams.z;
    float sum = 0.0f;
    for (int t = 0; t < 16; t++)
