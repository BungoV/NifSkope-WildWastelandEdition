float3 landDetailN(float3 n, float2 w, float2 wdx, float2 wdy, float v)
{
    float2 dd = (LandLodDetail.SampleGrad(_LandLodDetail_sampler, w * 0.000349999987520277500152587890625f, wdx * 0.000349999987520277500152587890625f, wdy * 0.000349999987520277500152587890625f).xy * 2.0f) - 1.0f.xx;
    float3 d = float3(dd, sqrt(1.0f - min(dot(dd, dd), 1.0f)));
    float3 t1 = normalize(cross(n, cross(n, float3(1.0f, 0.0f, 0.0f))));
    float3 t2 = normalize(cross(n, t1));
    return normalize(lerp(n, float3(dot(t1, d), dot(t2, d), dot(normalize(n), d)), v.xxx));
}

float3 landDetailSplatN(float3 n, float2 w, float2 wdx, float2 wdy, float v)
{
    if (landLodWin.w > 0.5f)
    {
        float3 nArg = n;
        float2 wArg = w;
        float2 wdxArg = wdx;
        float2 wdyArg = wdy;
        float vArg = v;
        return landDetailN(nArg, wArg, wdxArg, wdyArg, vArg);
    }
    float2 dd = (LandLodDetail.SampleGrad(_LandLodDetail_sampler, w * 0.000349999987520277500152587890625f, wdx * 0.000349999987520277500152587890625f, wdy * 0.000349999987520277500152587890625f).xy * 2.0f) - 1.0f.xx;
    return normalize(lerp(n, float3(-dd, sqrt(1.0f - min(dot(dd, dd), 1.0f))), v.xxx));
}

