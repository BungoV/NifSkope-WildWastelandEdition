        }
        float3 lt = ltPick;
        float4 fragColorPart2 = fragColor;
        float3 fragColorPart = lt * (0.25f + (0.75f * clamp(dot(fragColorPart2.xyz, float3(0.2125999927520751953125f, 0.715200006961822509765625f, 0.072200000286102294921875f)), 0.0f, 1.0f)));
        fragColor.x = fragColorPart.x;
        fragColor.y = fragColorPart.y;
        fragColor.z = fragColorPart.z;
    }
    fragColor.w = farSplatA;
    cellEmitOut.w *= farSplatA;
}

SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
{
    gl_FragCoord = stage_input.gl_FragCoord;
    gl_FragCoord.w = 1.0 / gl_FragCoord.w;
    gl_FrontFacing = stage_input.gl_FrontFacing;
    ViewDir = stage_input.ViewDir;
    btnMatrix = stage_input.btnMatrix;
    D = stage_input.D;
    A = stage_input.A;
    C = stage_input.C;
    farLadder = stage_input.farLadder;
    texCoord = stage_input.texCoord;
    rawVertexAlpha = stage_input.rawVertexAlpha;
    LightDir = stage_input.LightDir;
    reflMatrix = stage_input.reflMatrix;
    wwFarSkyVis = stage_input.wwFarSkyVis;
    wwFarAo = stage_input.wwFarAo;
    farSplatA = stage_input.farSplatA;
    frag_main();
    SPIRV_Cross_Output stage_output;
    stage_output.cellEmitOut = cellEmitOut;
    stage_output.fragColor = fragColor;
    return stage_output;
}
