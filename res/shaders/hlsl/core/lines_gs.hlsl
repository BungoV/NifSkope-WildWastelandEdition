// glslang -G, then spirv-cross --hlsl; loose uniforms are the LooseUniforms cbuffer (register b31); the
// GLSL includes are inlined as the loader does. Fusion Shaders (F4FS) feeds it the GL-side inputs
// named in notes/vkcompute1/hlsl_plan.md. Not wired: nothing loads this file.
// profile: gs_6_0
#include "CoreBindingsVk.hlsli"
cbuffer globalUniforms : register(b0, space0)
{
    row_major float3x3 viewMatrix : packoffset(c0);
    row_major float3x3 envMapRotation : packoffset(c3);
    row_major float4x4 projectionMatrix : packoffset(c6);
    float4 lightSourcePosition[3] : packoffset(c10);
    float4 lightSourceDiffuse[3] : packoffset(c13);
    float4 lightSourceAmbient : packoffset(c16);
    float toneMapScale : packoffset(c17);
    float brightnessScale : packoffset(c17.y);
    float glowScale : packoffset(c17.z);
    float glowScaleSRGB : packoffset(c17.w);
    int4 viewportDimensions : packoffset(c18);
    uint doSkinning : packoffset(c19);
    int sceneOptions : packoffset(c19.y);
    int cubeBgndMipLevel : packoffset(c19.z);
    int sfParallaxMaxSteps : packoffset(c19.w);
    float sfParallaxScale : packoffset(c20);
    float sfParallaxOffset : packoffset(c20.y);
    float unusedUniform1 : packoffset(c20.z);
    float unusedUniform2 : packoffset(c20.w);
};

cbuffer LooseUniforms : register(b31, space0)
{
    float lineWidth;
};

static float4 gl_PositionIn[2];
static float4 gl_Position;
static float4 C;
static float4 vsColor[2];

struct SPIRV_Cross_Input
{
    float4 vsColor : TEXCOORD0;
    float4 gl_PositionIn : SV_Position;
};

struct SPIRV_Cross_Output
{
    float4 C : TEXCOORD0;
    float4 gl_Position : SV_Position;
};

void drawLine(inout float4 p0, inout float4 p1, inout float4 c0, inout float4 c1, inout TriangleStream<SPIRV_Cross_Output> geometry_stream)
{
    float p0zw = p0.z + p0.w;
    float p1zw = p1.z + p1.w;
    if (!((p0zw > 0.0f) && (p1zw > 0.0f)))
    {
        if (p0zw > 9.9999999747524270787835121154785e-07f)
        {
            float t = p0zw / (p0zw - p1zw);
            p1 = lerp(p0, p1, t.xxxx);
            c1 = lerp(c0, c1, t.xxxx);
        }
        else
        {
            if (p1zw > 9.9999999747524270787835121154785e-07f)
            {
                float t_1 = p1zw / (p1zw - p0zw);
                p0 = lerp(p1, p0, t_1.xxxx);
                c0 = lerp(c1, c0, t_1.xxxx);
            }
            else
            {
                return;
            }
        }
    }
    float3 p0_ndc = p0.xyz / p0.w.xxx;
    float3 p1_ndc = p1.xyz / p1.w.xxx;
    float2 vpScale = float2(viewportDimensions.zw) * 0.5f;
    float2 vpOffs = float2(viewportDimensions.xy) + vpScale;
    float2 p0_ss = p0_ndc.xy * vpScale;
    float2 p1_ss = p1_ndc.xy * vpScale;
    float2 d = normalize(p1_ss - p0_ss) * max(lineWidth * 0.5f, 0.5f);
    float2 n = float2(-d.y, d.x) / vpScale;
    C = c0;
    gl_Position = float4(p0_ndc.xy + n, p0_ndc.z, 1.0f);
    {
        SPIRV_Cross_Output stage_output;
        stage_output.gl_Position = gl_Position;
        stage_output.C = C;
        geometry_stream.Append(stage_output);
    }
    C = c0;
    gl_Position = float4(p0_ndc.xy - n, p0_ndc.z, 1.0f);
    {
        SPIRV_Cross_Output stage_output;
        stage_output.gl_Position = gl_Position;
        stage_output.C = C;
        geometry_stream.Append(stage_output);
    }
    C = c1;
    gl_Position = float4(p1_ndc.xy + n, p1_ndc.z, 1.0f);
    {
        SPIRV_Cross_Output stage_output;
        stage_output.gl_Position = gl_Position;
        stage_output.C = C;
        geometry_stream.Append(stage_output);
    }
    C = c1;
    gl_Position = float4(p1_ndc.xy - n, p1_ndc.z, 1.0f);
    {
        SPIRV_Cross_Output stage_output;
        stage_output.gl_Position = gl_Position;
        stage_output.C = C;
        geometry_stream.Append(stage_output);
    }
    geometry_stream.RestartStrip();
}

void geom_main(line SPIRV_Cross_Input stage_input[2], inout TriangleStream<SPIRV_Cross_Output> geometry_stream)
{
    float a = min(lineWidth, 1.0f);
    float4 c0 = float4(vsColor[0].xyz, vsColor[0].w * a);
    float4 c1 = float4(vsColor[1].xyz, vsColor[1].w * a);
    float4 p0 = mul(gl_PositionIn[0], projectionMatrix);
    float4 p1 = mul(gl_PositionIn[1], projectionMatrix);
    float4 param = p0;
    float4 param_1 = p1;
    float4 param_2 = c0;
    float4 param_3 = c1;
    drawLine(param, param_1, param_2, param_3, geometry_stream);
}

[maxvertexcount(4)]
void main(line SPIRV_Cross_Input stage_input[2], inout TriangleStream<SPIRV_Cross_Output> geometry_stream)
{
    for (int i = 0; i < 2; i++)
    {
        gl_PositionIn[i] = stage_input[i].gl_PositionIn;
    }
    for (int i = 0; i < 2; i++)
    {
        vsColor[i] = stage_input[i].vsColor;
    }
    geom_main(stage_input, geometry_stream);
}
