        }
        float pull = pullPick;
        float4 sumPart = float4(q.xy + (o * pull), float(i), zRef + clamp(dz * pull, -lim, lim));
        sum += csmMap.SampleCmp(_csmMap_sampler, sumPart.xyz, sumPart.w);
    }
    return sum / float(n);
}

