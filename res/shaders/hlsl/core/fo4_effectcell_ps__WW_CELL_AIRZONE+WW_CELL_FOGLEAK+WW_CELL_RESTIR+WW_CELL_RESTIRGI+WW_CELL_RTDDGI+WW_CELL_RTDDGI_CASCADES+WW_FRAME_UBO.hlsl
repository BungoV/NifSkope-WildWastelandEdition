    }
    if (ussOn != 0)
    {
        float3 posViewArg14 = posView;
        float ussComposeRet = ussCompose(posViewArg14);
        return ussComposeRet;
    }
    float dv = (-posView.z) * csmParams.x;
    if (dv > (csmParams.y + csmParams.w))
