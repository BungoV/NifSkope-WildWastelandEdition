float3 dalcAmbient(float3 n)
{
    float3 n2 = n * n;
    bool fx = dalcFlip;
    float3 tmp5739;
    if ((n.x > 0.0f) != fx)
    {
        tmp5739 = dalc[1];
    }
    else
    {
        tmp5739 = dalc[0];
    }
    float3 x = tmp5739;
    float3 tmp5758;
    if ((n.y > 0.0f) != fx)
    {
        tmp5758 = dalc[3];
    }
    else
    {
        tmp5758 = dalc[2];
    }
    float3 y = tmp5758;
    float3 tmp5773;
    if ((n.z > 0.0f) != fx)
    {
        tmp5773 = dalc[5];
    }
    else
    {
        tmp5773 = dalc[4];
    }
    float3 z = tmp5773;
    return ((x * n2.x) + (y * n2.y)) + (z * n2.z);
}

