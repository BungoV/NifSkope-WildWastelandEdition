// glslang -G, then spirv-cross --hlsl; loose uniforms are the LooseUniforms cbuffer (register b31); the
// GLSL includes are inlined as the loader does. Fusion Shaders (F4FS) feeds it the GL-side inputs
// named in notes/vkcompute1/hlsl_plan.md. Not wired: nothing loads this file.
// profile: ps_6_0
// note: gl_PointCoord is the stage input wwPointCoord: HLSL has no point sprites, so the point is drawn as a quad (see the *_points_gs.hlsl beside it) that writes the corner
#include "CoreBindingsVk.hlsli"
cbuffer LooseUniforms : register(b31, space0)
{
    int selectionFlags;
};

static uint gl_PrimitiveID;
static float4 C;
static float2 wwPointCoord;
static float4 fragColor;

struct SPIRV_Cross_Input
{
    float2 wwPointCoord : TEXCOORD0;
    float4 C : TEXCOORD1;
    uint gl_PrimitiveID : SV_PrimitiveID;
};

struct SPIRV_Cross_Output
{
    float4 fragColor : SV_Target0;
};

uint spvPackUnorm4x8(float4 value)
{
    uint4 Packed = uint4(round(saturate(value) * 255.0));
    return Packed.x | (Packed.y << 8) | (Packed.z << 16) | (Packed.w << 24);
}

float4 spvUnpackUnorm4x8(uint value)
{
    uint4 Packed = uint4(value & 0xff, (value >> 8) & 0xff, (value >> 16) & 0xff, value >> 24);
    return float4(Packed) / 255.0;
}

void frag_main()
{
    float4 color = C;
    if ((selectionFlags & 2) != 0)
    {
        float2 d = wwPointCoord - 0.5f.xx;
        float r2 = dot(d, d);
        if (r2 > 0.25f)
        {
            discard;
        }
        int p = selectionFlags & 65280;
        if (p != 0)
        {
            color.w *= clamp(((0.5f - sqrt(r2)) * float(p)) / 2048.0f, 0.0f, 1.0f);
        }
    }
    else
    {
        if ((selectionFlags & 4) != 0)
        {
            color = spvUnpackUnorm4x8(spvPackUnorm4x8(color) + (uint(gl_PrimitiveID) << uint(15))) + 0.0005000000237487256526947021484375f.xxxx;
        }
    }
    fragColor = color;
}

SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
{
    gl_PrimitiveID = stage_input.gl_PrimitiveID;
    C = stage_input.C;
    wwPointCoord = stage_input.wwPointCoord;
    frag_main();
    SPIRV_Cross_Output stage_output;
    stage_output.fragColor = fragColor;
    return stage_output;
}
