        // Debug "lambert": fd = 1.
        float f90 = 0.5f + (((2.0f * s.rough) * LoH) * LoH);
        float xArg4 = 1.0f - NoL;
        float xArg3 = 1.0f - NoV;
        float fd = (1.0f + ((f90 - 1.0f) * pow5(xArg4))) * (1.0f + ((f90 - 1.0f) * pow5(xArg3)));
