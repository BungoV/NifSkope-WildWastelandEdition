float2 wwDecalPomUv(float2 uv0, float3 P, float3 N, float3 E)
{
    float3 dpx = ddx(P);
    float3 dpy = ddy(P);
    float2 dux = ddx(uv0);
    float2 duy = ddy(uv0);
    float det = (dux.x * duy.y) - (duy.x * dux.y);
    if (abs(det) < 9.9999999600419720025001879548654e-13f)
    {
        return uv0;
    }
    // +u on the surface
    float3 T = normalize(((dpx * duy.y) - (dpy * dux.y)) / det.xxx);
    // +v
    float3 B = normalize(((dpy * dux.x) - (dpx * duy.x)) / det.xxx);
    float ez = max(dot(E, N), 0.001000000047497451305389404296875f);
    float2 ofs = ((-float2(dot(E, T), dot(E, B))) / ez.xx) * wwDecalPom.x;
    float n = min(72.0f - (56.0f * clamp(dot(N, E), 0.0f, 1.0f)), wwDecalPom.y);
    float stepH = 1.0f / n;
    float layer = 1.0f;
    float prevLayer = 1.0f;
    float h = 0.0f;
    float prevH = 1.0f;
    float2 uv = uv0;
    for (int i = 0; i < 72; i++)
    {
        if (float(i) >= n)
        {
            break;
        }
        uv = uv0 + (ofs * (1.0f - layer));
        h = GlowMap.SampleGrad(_GlowMap_sampler, uv, dux, duy).x;
        if (layer < h)
        {
            break;
        }
        prevLayer = layer;
        prevH = h;
        layer -= stepH;
    }
    float d0 = prevLayer - prevH;
    float d1 = layer - h;
    float tPick;
    if ((d0 - d1) != 0.0f)
    {
        tPick = prevLayer + (((layer - prevLayer) * d0) / (d0 - d1));
    }
    else
    {
        tPick = layer;
    }
    float t = tPick;
    return uv0 + (ofs * (1.0f - t));
}

float3 csmNormalOff(float3 posView, float3 dPx, float3 dPy)
{
    float3 n = cross(dPx, dPy);
    float ln = length(n);
    float3 lv = float3(csmMat[0][0].z, csmMat[0][1].z, csmMat[0][2].z);
    bool cond2 = ln <= 9.9999996826552253889678874634872e-21f;
    bool cond;
    if (!cond2)
    {
        cond = dot(lv, lv) <= 0.0f;
    }
    else
    {
        cond = cond2;
    }
    if (cond)
    {
        return 0.0f.xxx;
    }
    float3 nPick;
    if (dot(n, posView) > 0.0f)
    {
        nPick = (-n) / ln.xxx;
    }
    else
    {
        nPick = n / ln.xxx;
    }
    n = nPick;
    float c = dot(n, normalize(lv));
    return n * ((ussCsmStable.w * sqrt(max(1.0f - (c * c), 0.0f))) / csmParams.x);
}

//! the cascade pair and the blend weight at this view depth (spec 2.4)
void csmSelect(float3 posView, out int a, out int b, out float t)
{
    float dv = (-posView.z) * csmParams.x;
    float bound;
    if (dv < csmSplitOffset.y)
    {
        a = 0;
        b = 1;
        bound = csmSplitOffset.x;
    }
    else
    {
        a = 1;
        b = 2;
        bound = csmSplitOffset.y;
    }
    float x = clamp((dv - bound) / csmParams.w, 0.0f, 1.0f);
    float tPick2;
    if ((csmRed & 1) != 0)
    {
        tPick2 = step(0.5f, x);
    }
    else
    {
        tPick2 = smoothstep(0.0f, 1.0f, x);
    }
    t = tPick2;
}

float3 csmUvd(int i, float3 posView)
{
    return mul(float4(posView, 1.0f), csmMat[i]).xyz;
}

float ussIgn(float2 p)
{
    return frac(52.98291778564453125f * frac(dot(p, float2(0.067110560834407806396484375f, 0.005837149918079376220703125f))));
}

