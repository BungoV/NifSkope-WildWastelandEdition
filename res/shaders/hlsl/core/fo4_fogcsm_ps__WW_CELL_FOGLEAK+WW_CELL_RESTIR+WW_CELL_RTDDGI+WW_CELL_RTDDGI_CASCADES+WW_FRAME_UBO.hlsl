}

//! the receiver's slope (rise over run) from its position's screen derivatives
float ussSlope(float3 dPx, float3 dPy)
{
    float3 n = cross(dPx, dPy);
    float l = length(n);
    bool cond6 = l < 9.9999996826552253889678874634872e-21f;
