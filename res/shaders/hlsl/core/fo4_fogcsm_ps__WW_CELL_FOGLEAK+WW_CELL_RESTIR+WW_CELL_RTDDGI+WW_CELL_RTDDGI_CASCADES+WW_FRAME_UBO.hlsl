    }
    float nz = abs(mul(float4(n / l.xxx, 0.0f), ussWorldFromView).z) / max(length(ussWorldFromView[0].xyz), 9.9999996826552253889678874634872e-21f);
    return sqrt(max(1.0f - (nz * nz), 0.0f)) / max(nz, 0.20000000298023223876953125f);
