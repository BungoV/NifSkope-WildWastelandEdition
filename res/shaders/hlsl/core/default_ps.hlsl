// HLSL port of default.frag (frag shader). Generated by notes/hlslbulk1/tools/convert.py:
// glslang -G, then spirv-cross --hlsl; loose uniforms are the LooseUniforms cbuffer (register b31); the
// GLSL includes are inlined as the loader does. Fusion Shaders (F4FS) feeds it the GL-side inputs
// named in notes/vkcompute1/hlsl_plan.md. Not wired: nothing loads this file.
// profile: ps_6_0
#include "CoreBindingsVk.hlsli"
struct Texture
{
    float2 uvCenter;
    float2 uvScale;
    float2 uvOffset;
    float uvRotation;
    int coordSet;
    int textureUnit;
};

cbuffer globalUniforms : register(b0, space0)
{
    row_major float3x3 viewMatrix : packoffset(c0);
    row_major float3x3 envMapRotation : packoffset(c3);
    row_major float4x4 projectionMatrix : packoffset(c6);
    float4 lightSourcePosition[3] : packoffset(c10);
    float4 lightSourceDiffuse[3] : packoffset(c13);
    float4 lightSourceAmbient : packoffset(c16);
    float toneMapScale : packoffset(c17);
    float brightnessScale : packoffset(c17.y);
    float glowScale : packoffset(c17.z);
    float glowScaleSRGB : packoffset(c17.w);
    int4 viewportDimensions : packoffset(c18);
    uint doSkinning : packoffset(c19);
    int sceneOptions : packoffset(c19.y);
    int cubeBgndMipLevel : packoffset(c19.z);
    int sfParallaxMaxSteps : packoffset(c19.w);
    float sfParallaxScale : packoffset(c20);
    float sfParallaxOffset : packoffset(c20.y);
    float unusedUniform1 : packoffset(c20.z);
    float unusedUniform2 : packoffset(c20.w);
};

cbuffer LooseUniforms : register(b31, space0)
{
    Texture textures[10];
    int vertexColorFlags;
    float4 frontMaterialAmbient;
    float4 frontMaterialDiffuse;
    float4 frontMaterialEmission;
    float alpha;
    int alphaFlags;	// bits 0 to 2: alpha test mode, bit 3: alpha blending enabled
    float alphaThreshold;
    float4 frontMaterialSpecular;
    float frontMaterialShininess;
};
Texture2D<float4> textureUnits[10] : register(t0, space0);
SamplerState _textureUnits_sampler[10] : register(s0, space0);

static float2 texCoords[9];
static float3 LightDir;
static float3 ViewDir;
static float3 N;
static float4 C;
static float4 A;
static float4 D;
static float4 fragColor;

struct SPIRV_Cross_Input
{
    float3 LightDir : TEXCOORD0;
    float3 ViewDir : TEXCOORD1;
    float2 texCoords[9] : TEXCOORD2;
    nointerpolation float4 A : TEXCOORD11;
    float4 C : TEXCOORD12;
    nointerpolation float4 D : TEXCOORD13;
    float3 N : TEXCOORD14;
};

struct SPIRV_Cross_Output
{
    float4 fragColor : SV_Target0;
};

float4 getTexture(int n)
{
    float r_c = cos(textures[n].uvRotation);
    float r_s = sin(textures[n].uvRotation) * (-1.0f);
    float2 offs = texCoords[textures[n].coordSet] - textures[n].uvCenter;
    offs = float2((offs.x * r_c) - (offs.y * r_s), (offs.x * r_s) + (offs.y * r_c));
    offs = ((offs * textures[n].uvScale) + textures[n].uvCenter) + textures[n].uvOffset;
    int getTextureRet = textures[n].textureUnit - 1;
    return textureUnits[getTextureRet].Sample(_textureUnits_sampler[getTextureRet], offs);
}

void frag_main()
{
    float3 L = normalize(LightDir);
    float3 E = normalize(ViewDir);
    float4 color = 1.0f.xxxx;
    float3 normal = normalize(N);
    float NdotL = max(dot(normal, L), 0.0f);
    if ((vertexColorFlags & 40) == 40)
    {
        color *= C;
        float4 colorPart20 = color;
        float3 colorPart19 = colorPart20.xyz * (A.xyz + (D.xyz * NdotL));
        color.x = colorPart19.x;
        color.y = colorPart19.y;
        color.z = colorPart19.z;
    }
    else
    {
        if ((vertexColorFlags & 8) != 0)
        {
            float4 colorPart18 = color;
            float3 colorPart17 = colorPart18.xyz * ((A.xyz * frontMaterialAmbient.xyz) + ((D.xyz * frontMaterialDiffuse.xyz) * NdotL));
            color.x = colorPart17.x;
            color.y = colorPart17.y;
            color.z = colorPart17.z;
            color.w *= min(frontMaterialAmbient.w + frontMaterialDiffuse.w, 1.0f);
        }
        else
        {
            float4 colorPart16 = color;
            float3 colorPart15 = colorPart16.xyz * (A.xyz + (D.xyz * NdotL));
            color.x = colorPart15.x;
            color.y = colorPart15.y;
            color.z = colorPart15.z;
        }
    }
    // Emissive
    float3 emissive = frontMaterialEmission.xyz * frontMaterialEmission.w;
    if ((vertexColorFlags & 16) != 0)
    {
        emissive = C.xyz * C.w;
    }
    float4 colorPart14 = color;
    float3 colorPart13 = colorPart14.xyz + (emissive * glowScaleSRGB);
    color.x = colorPart13.x;
    color.y = colorPart13.y;
    color.z = colorPart13.z;
    color.w *= alpha;
    // Texturing
    if (textures[0].textureUnit > 0)
    {
        int nArg8 = 0;
        color *= getTexture(nArg8);
    }
    if (textures[1].textureUnit > 0)
    {
        int nArg7 = 1;
        color *= getTexture(nArg7);
    }
    if (textures[2].textureUnit > 0)
    {
        int nArg6 = 2;
        color *= getTexture(nArg6);
        float4 colorPart12 = color;
        float3 colorPart11 = colorPart12.xyz * 2.0f;
        color.x = colorPart11.x;
        color.y = colorPart11.y;
        color.z = colorPart11.z;
    }
    if (textures[6].textureUnit > 0)
    {
        int nArg5 = 6;
        // decal 0
        float4 tmp = getTexture(nArg5);
        float4 colorPart10 = color;
        float3 colorPart9 = lerp(colorPart10.xyz, tmp.xyz, tmp.w.xxx);
        color.x = colorPart9.x;
        color.y = colorPart9.y;
        color.z = colorPart9.z;
    }
    if (textures[7].textureUnit > 0)
    {
        int nArg4 = 7;
        // decal 1
        float4 tmp_1 = getTexture(nArg4);
        float4 colorPart8 = color;
        float3 colorPart7 = lerp(colorPart8.xyz, tmp_1.xyz, tmp_1.w.xxx);
        color.x = colorPart7.x;
        color.y = colorPart7.y;
        color.z = colorPart7.z;
    }
    if (textures[8].textureUnit > 0)
    {
        int nArg3 = 8;
        // decal 2
        float4 tmp_2 = getTexture(nArg3);
        float4 colorPart6 = color;
        float3 colorPart5 = lerp(colorPart6.xyz, tmp_2.xyz, tmp_2.w.xxx);
        color.x = colorPart5.x;
        color.y = colorPart5.y;
        color.z = colorPart5.z;
    }
    if (textures[9].textureUnit > 0)
    {
        int nArg2 = 9;
        // decal 3
        float4 tmp_3 = getTexture(nArg2);
        float4 colorPart4 = color;
        float3 colorPart3 = lerp(colorPart4.xyz, tmp_3.xyz, tmp_3.w.xxx);
        color.x = colorPart3.x;
        color.y = colorPart3.y;
        color.z = colorPart3.z;
    }
    if (textures[4].textureUnit > 0)
    {
        int nArg = 4;
        float4 colorPart2 = color;
        float3 colorPart = colorPart2.xyz + (getTexture(nArg).xyz * glowScaleSRGB);
        color.x = colorPart.x;
        color.y = colorPart.y;
        color.z = colorPart.z;
    }
    // Specular
    float a = 1.0f;
    if (alphaFlags > 0)
    {
        int mPick;
        if (color.w < alphaThreshold)
        {
            mPick = 11051;
        }
        else
        {
            mPick = (color.w > alphaThreshold) ? 29041 : 19789;
        }
        // 0: always, 1: <, 2: ==, 3: <=, 4: >, 5: !=, 6: >=, 7: never
        int m = mPick;
        if ((m & (1 << alphaFlags)) == 0)
        {
            discard;
        }
        if ((alphaFlags & 8) != 0)
        {
            a = color.w;
        }
    }
    fragColor = float4(color.xyz * D.w, a);
}

SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
{
    texCoords = stage_input.texCoords;
    LightDir = stage_input.LightDir;
    ViewDir = stage_input.ViewDir;
    N = stage_input.N;
    C = stage_input.C;
    A = stage_input.A;
    D = stage_input.D;
    frag_main();
    SPIRV_Cross_Output stage_output;
    stage_output.fragColor = fragColor;
    return stage_output;
}
