// HLSL source of features/sky/atmo_apl.frag (include-only GLSL), lane HLSLSRC2 (notes/hlslsrc2/tools/glsl2hlsl.py): the GLSL's comments,
// names and order kept. Its loose uniforms sit at the top under WW_LOOSE_UNIFORMS: the entry that includes this
// file includes it once more inside its LooseUniforms cbuffer with that defined (HLSL has one cbuffer for them).
#ifdef WW_HLSL_SRC
// lane PERFFIX3 (item 1): atmo_ap.frag with the slice from the geometry shader (atmo_apl.geom), one layered draw
#define WW_AP_LAYERED 1
#include "atmo_ap_ps.hlsl"
#else	// WW_HLSL_SRC: the per-variant files' half (HLSLBULK1, WW_FN_<name> picks functions); it goes with the last of them
// HLSL port of features/sky/atmo_apl.frag (frag shader). Generated by notes/hlslbulk1/tools/convert.py:
// glslang -G, then spirv-cross --hlsl; loose uniforms are the LooseUniforms cbuffer (register b31); the
// GLSL includes' functions are #included from the shared .hlsli files, the rest is inlined as the loader does. Fusion Shaders (F4FS) feeds it the GL-side inputs
// named in notes/vkcompute1/hlsl_plan.md. Not wired: nothing loads this file.
// profile: ps_6_0
#include "SkyBindingsVk.hlsli"
cbuffer LooseUniforms : register(b31, space0)
{
    float3 atHaze;	// the weather fog's haze layer: ground extinction /km, scale height km, plateau top km
    float3 atRay;	// Rayleigh scattering /km (5.802, 13.558, 33.1)e-3
    float atMieS;	// Mie scattering /km (3.996e-3)
    float3 atHazeSpec;	// lane WEATHERRECX1: the haze extinction's (lambda / 550)^-angstrom (1 = grey, before 1.3)
    float3 atHazeAlbedo;	// lane WEATHERRECX1: the haze's albedo at 680 / 550 / 440 nm (3.996 / 4.40 grey before 1.3)
    float atMieE;	// Mie extinction /km (4.40e-3)
    float3 atOzone;	// ozone absorption /km (0.650, 1.881, 0.085)e-3; 0 under the red "noozone"
    float atMsOld;
    float atApNoSunT;	// red "nosunt": the in-scatter ignores the sun's transmittance (must fail the AP gate)
    float atG;	// Mie Henyey-Greenstein g (lane WEATHERRECX1: the haze's, atmomath.h hazeOptics)
    float atMsOn;
    float2 atMsSize;
    float3 atTint[17];	// the weather dome's linear color at 90 (i / 16)^2 degrees (gl/atmomath.h tintTable)
    float3 atApDims;	// width, height, slices
    float3 atFrustum0;	// world ray (not unit) at the viewport's lower-left corner
    float3 atFrustumX;	// its change across the viewport's width
    float3 atFrustumY;	// and height
    float atApMaxKm;
    float atCamR;	// km from the planet centre
    float3 atSunW;	// world, TO the sun
    float atSunK;	// pi k for the sun (atmosphere.cpp)
    float atMoonK;	// 0 = no moon term
    float3 atMoonW;
    float atTintOn;	// SKY2B (SKYTINT2): 1 = the Sky Color row's Weather Tint (0 under red WW_ATMO_TINT_RED=physical)
};
Texture2D<float4> atTransTex : register(t0, space0);
SamplerState _atTransTex_sampler : register(s0, space0);
Texture2D<float4> atMsTex : register(t1, space0);
SamplerState _atMsTex_sampler : register(s1, space0);

static float4 gl_FragCoord;
static float atApSliceIn;
static float4 fragColor;

struct SPIRV_Cross_Input
{
    nointerpolation float atApSliceIn : TEXCOORD0;
    float4 gl_FragCoord : SV_Position;
};

struct SPIRV_Cross_Output
{
    float4 fragColor : SV_Target0;
};

#define WW_FN_atMedium
#define WW_FN_atHitsGround
#define WW_FN_atDistTop
#include "atmo_common.hlsli"
#undef WW_FN_atMedium
#undef WW_FN_atHitsGround
#undef WW_FN_atDistTop

// texel centers sit on the [0,1] ends of the parameter range
#define WW_FN_atUnitToSub
#define WW_FN_atTransUv
#define WW_FN_atTrans
#define WW_FN_atPhaseR
#define WW_FN_atPhaseHg
#define WW_FN_atMsUv
#include "atmo_common.hlsli"
#undef WW_FN_atUnitToSub
#undef WW_FN_atTransUv
#undef WW_FN_atTrans
#undef WW_FN_atPhaseR
#undef WW_FN_atPhaseHg
#undef WW_FN_atMsUv

float3 atLightS(float3 up, float rp, float3 rs, float3 ms, float3 v, float3 l, float k)
{
    float mus = dot(up, l);
    float c = dot(v, l);
    float3 TsPick;
    if (atApNoSunT > 0.5f)
    {
        TsPick = 1.0f.xxx;
    }
    else
    {
        float rArg2 = rp;
        float muArg = mus;
        TsPick = atTrans(atTransTex, _atTransTex_sampler, rArg2, muArg);
    }
    float3 Ts = TsPick;
    float cArg2 = c;
    float gArg = atG;
    float cArg = c;
    float rArg = rp;
    float musArg = mus;
    float2 nArg = atMsSize;
    return ((Ts * ((rs * atPhaseR(cArg2)) + (ms * atPhaseHg(gArg, cArg)))) + ((atMsTex.Sample(_atMsTex_sampler, atMsUv(rArg, musArg, nArg)).xyz * atMsOn) * (rs + ms))) * k;
}

// atmo_sky.frag atWeatherTint's twin (gl/atmomath.h weatherTint): the luminance kept, the dome's color at this elevation
float3 atWeatherTint(float3 c, float elevDeg)
{
    float t = sqrt(clamp(elevDeg, 0.0f, 90.0f) / 90.0f) * 16.0f;
    int i = min(int(t), 15);
    float3 w = lerp(atTint[i], atTint[i + 1], (t - float(i)).xxx);
    float lw = dot(w, float3(0.2125999927520751953125f, 0.715200006961822509765625f, 0.072200000286102294921875f));
    float3 atWeatherTintRet;
    if (lw > 9.9999999392252902907785028219223e-09f)
    {
        atWeatherTintRet = w * (dot(c, float3(0.2125999927520751953125f, 0.715200006961822509765625f, 0.072200000286102294921875f)) / lw);
    }
    else
    {
        atWeatherTintRet = c;
    }
    return atWeatherTintRet;
}

void frag_main()
{
    float2 uv = gl_FragCoord.xy / atApDims.xy;
    float3 v = normalize((atFrustum0 + (atFrustumX * uv.x)) + (atFrustumY * uv.y));
    float z = (atApSliceIn + 0.5f) / atApDims.z;
    float D = (atApMaxKm * z) * z;
    float3 thr = 1.0f.xxx;
    float3 L = 0.0f.xxx;
    float t0 = 0.0f;
    float3 raySArg;
    float3 mieSArg;
    float3 extArg;
    for (int i = 0; i < 16; i++)
    {
        float a = float(i + 1) / 16.0f;
        // packed toward the camera: the haze layer can be ~100 m thick
        float t1 = (D * a) * a;
        float dt = t1 - t0;
        float t = t0 + (dt * 0.5f);
        t0 = t1;
        float3 p = float3(v.xy * t, atCamR + (v.z * t));
        float rp = length(p);
        float3 up = p / rp.xxx;
        float hArg = rp - 6360.0f;
        atMedium(hArg, raySArg, mieSArg, extArg);
        float3 rs = raySArg;
        float3 ms = mieSArg;
        float3 e = extArg;
        float3 upArg2 = up;
        float rpArg2 = rp;
        float3 rsArg2 = rs;
        float3 msArg2 = ms;
        float3 vArg2 = v;
        float3 lArg2 = atSunW;
        float kArg2 = atSunK;
        float3 S = atLightS(upArg2, rpArg2, rsArg2, msArg2, vArg2, lArg2, kArg2);
        if (atMoonK > 0.0f)
        {
            float3 upArg = up;
            float rpArg = rp;
            float3 rsArg = rs;
            float3 msArg = ms;
            float3 vArg = v;
            float3 lArg = atMoonW;
            float kArg = atMoonK;
            S += atLightS(upArg, rpArg, rsArg, msArg, vArg, lArg, kArg);
        }
        float3 Tst = exp((-e) * dt);
        L += (((thr * S) * (1.0f.xxx - Tst)) / max(e, 9.999999717180685365747194737196e-10f.xxx));
        thr *= Tst;
    }
    if (atTintOn > 0.5f)
    {
        float3 cArg3 = L;
        float elevDegArg = degrees(asin(clamp(v.z, -1.0f, 1.0f)));
        L = atWeatherTint(cArg3, elevDegArg);
    }
    fragColor = float4(L, dot(thr, 0.3333333432674407958984375f.xxx));
}

SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
{
    gl_FragCoord = stage_input.gl_FragCoord;
    gl_FragCoord.w = 1.0 / gl_FragCoord.w;
    atApSliceIn = stage_input.atApSliceIn;
    frag_main();
    SPIRV_Cross_Output stage_output;
    stage_output.fragColor = fragColor;
    return stage_output;
}
#endif	// WW_HLSL_SRC
