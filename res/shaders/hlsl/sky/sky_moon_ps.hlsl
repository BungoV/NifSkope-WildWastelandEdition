float2 atSkyDirToUv(float r, float cosZ, float cosAz, float2 n)
{
    float vh = sqrt(max(0.0f, (r * r) - 40449600.0f));
    float beta = acos(clamp(vh / r, -1.0f, 1.0f));
    float zh = 3.1415927410125732421875f - beta;
    float za = acos(clamp(cosZ, -1.0f, 1.0f));
    float2 uv_1;
    if (za < zh)
    {
        float c = 1.0f - (za / zh);
        uv_1.y = (1.0f - sqrt(max(0.0f, c))) * 0.5f;
    }
    else
    {
        float c_1 = (za - zh) / max(beta, 9.9999997473787516355514526367188e-06f);
        uv_1.y = (sqrt(clamp(c_1, 0.0f, 1.0f)) * 0.5f) + 0.5f;
    }
    uv_1.x = sqrt(clamp(((-cosAz) * 0.5f) + 0.5f, 0.0f, 1.0f));
    float param = uv_1.x;
    float param_1 = n.x;
    float param_2 = uv_1.y;
    float param_3 = n.y;
    return float2(atUnitToSub(param, param_1), atUnitToSub(param_2, param_3));
}

