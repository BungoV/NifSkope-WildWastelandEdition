// lane SKY2B: one view ray's march (Hillaire 2020 sec. 5.3: single scattering + the MS term, 30 quadratic steps),
// shared by the sky-view LUT and the per-pixel sky (red WW_ATMO_RED=perpixel). ground = 1 adds the lit ground
// (albedo kAlbedo, as the MS pass does) where the ray ends on the planet: without it high cameras saw a black earth.
#define WW_FN_atSkyMarch
#define WW_FN_atSkyDirToUv
#include "atmo_common.hlsli"
#undef WW_FN_atSkyMarch
#undef WW_FN_atSkyDirToUv

float3 atLookup(Texture2D<float4> lut, SamplerState _lut_sampler, float3 d, float3 l)
{
    float2 a = d.xy;
    float2 b = l.xy;
    float la = length(a);
    float lb = length(b);
    float cosAzPick;
    if ((la > 9.9999997473787516355514526367188e-06f) && (lb > 9.9999997473787516355514526367188e-06f))
    {
        cosAzPick = dot(a / la.xx, b / lb.xx);
    }
    else
    {
        cosAzPick = 1.0f;
    }
    float cosAz = cosAzPick;
    float rArg = atCamR;
    float cosZArg = d.z;
    float cosAzArg = cosAz;
    float2 nArg = atViewSize;
    return lut.Sample(_lut_sampler, atSkyDirToUv(rArg, cosZArg, cosAzArg, nArg)).xyz;
}

// the GLSL twin of gl/atmomath.h weatherTint: the physical luminance in the weather's color at this elevation
float3 atWeatherTint(float3 c, float elevDeg)
{
    float t = sqrt(clamp(elevDeg, 0.0f, 90.0f) / 90.0f) * 16.0f;
    int i = min(int(t), 15);
    float3 w = lerp(atTint[i], atTint[i + 1], (t - float(i)).xxx);
    float lw = dot(w, float3(0.2125999927520751953125f, 0.715200006961822509765625f, 0.072200000286102294921875f));
    float3 atWeatherTintRet;
    if (lw > 9.9999999392252902907785028219223e-09f)
    {
        atWeatherTintRet = w * (dot(c, float3(0.2125999927520751953125f, 0.715200006961822509765625f, 0.072200000286102294921875f)) / lw);
    }
    else
    {
        atWeatherTintRet = c;
    }
    return atWeatherTintRet;
}

