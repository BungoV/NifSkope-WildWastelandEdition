float wwAirCurvedLeg(float a, float u0, float u1, float4 g)
{
    if (u1 <= u0)
    {
        return 0.0f;
    }
    float h = (u1 - u0) / 24.0f;
    float c = 0.0f;
    for (int i = 0; i < 24; i++)
    {
        float u = u0 + ((float(i) + 0.5f) * h);
        float zArg = a + (u * u);
        float4 medArg = volAirMed;
        float4 layerArg = volAirLayer;
        float4 groundArg = g;
        float wwAirRhoLawRet = wwAirRhoLaw(zArg, medArg, layerArg, groundArg);
        c += wwAirRhoLawRet;
    }
    return c * h;
}

// sigma0 x the column from height z0 at elevation sine s to the air's end `end` or the ground gz (hit)
float wwAirCurvedTau(float z0, float s, float gz, float end, float4 g, inout bool hit)
{
    float k = 14932.6826171875f;
    float a = z0 - (((0.5f * s) * s) * 445969984.0f);
    float uz = sqrt(max(min(z0, end) - a, 0.0f));
    float ue = sqrt(max(end - a, 0.0f));
    hit = (s < 0.0f) && (a <= gz);
    float cPick;
    if (s >= 0.0f)
    {
        float aArg4 = a;
        float u0Arg4 = s * k;
        float u1Arg4 = ue;
        float4 gArg4 = g;
        cPick = wwAirCurvedLeg(aArg4, u0Arg4, u1Arg4, gArg4);
    }
    else
    {
        float cPick2;
        if (hit)
        {
            float aArg3 = a;
            float u0Arg3 = sqrt(max(gz - a, 0.0f));
            float u1Arg3 = uz;
            float4 gArg3 = g;
            cPick2 = wwAirCurvedLeg(aArg3, u0Arg3, u1Arg3, gArg3);
        }
        else
        {
            float aArg2 = a;
            float u0Arg2 = 0.0f;
            float u1Arg2 = uz;
            float4 gArg2 = g;
            float aArg = a;
            float u0Arg = 0.0f;
            float u1Arg = ue;
            float4 gArg = g;
            cPick2 = wwAirCurvedLeg(aArg2, u0Arg2, u1Arg2, gArg2) + wwAirCurvedLeg(aArg, u0Arg, u1Arg, gArg);
        }
        cPick = cPick2;
    }
    float c = cPick;
    return ((volAirMed.x * 2.0f) * k) * c;
}

