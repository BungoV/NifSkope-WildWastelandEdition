// the band's weight: 1 where the sky's own air is opaque, 0 from tSky = kSkyBandT up
float wwSkyBandW(float tSky)
{
    float t = clamp(tSky / 0.02999999932944774627685546875f, 0.0f, 1.0f);
    return 1.0f - ((t * t) * (3.0f - (2.0f * t)));
}

