// the density per unit sigma0 at height z (cell_volair.frag airRho)
float wwAirRhoLaw(inout float z, float4 med, float4 layer, float4 ground)
{
    float k = 1.0f;
    if (z > med.w)
    {
        if (ground.z <= 0.0f)
        {
            return 0.0f;
        }
        // G2: the top's density, falling off
        k = exp((-(z - med.w)) * ground.z);
        z = med.w;
    }
    float rPick3;
    if (med.z > 0.0f)
    {
        rPick3 = min(1.0f, exp((-(z - med.y)) * med.z));
    }
    else
    {
        rPick3 = 1.0f;
    }
    float r = rPick3;
    bool cond4 = layer.x <= 0.0f;
    bool cond3;
    if (cond4)
    {
        cond3 = layer.w <= 0.0f;
    }
    else
    {
        cond3 = cond4;
    }
    if (cond3)
    {
        return k * r;
    }
    if (layer.x > 0.0f)
    {
        float rPick2;
        if (layer.z > 0.0f)
        {
            rPick2 = min(1.0f, exp((-(z - layer.y)) * layer.z));
        }
        else
        {
            rPick2 = 1.0f;
        }
        r = ((1.0f - layer.x) * r) + (layer.x * rPick2);
    }
    if (layer.w > 0.0f)
    {
        float rPick;
        if (ground.y > 0.0f)
        {
            rPick = min(1.0f, exp((-(z - ground.x)) * ground.y));
        }
        else
        {
            rPick = 1.0f;
        }
        r += (layer.w * rPick);
    }
    return k * r;
}

// the column between heights lo < hi of one term B(z) = min(1, exp(-(z - z0) invH)): flat under z0, exponential
// above (invH 0: flat everywhere); no cancellation of two large columns. Shared with cell_volair.frag airCol.
float wwAirColOne(float lo, float hi, float z0, float invH)
{
    if (hi <= lo)
    {
        return 0.0f;
    }
    if (invH <= 0.0f)
    {
        return hi - lo;
    }
    float below = max(min(hi, z0) - lo, 0.0f);
    float a = max(lo, z0);
    if (hi <= a)
    {
        return below;
    }
    float w = hi - a;
    float u = w * invH;
    float e1Pick;
    if (u < 0.001000000047497451305389404296875f)
    {
        e1Pick = 1.0f - (u * (0.5f - (u / 6.0f)));
    }
    else
    {
        e1Pick = (1.0f - exp(-u)) / u;
    }
    float e1 = e1Pick;
    return below + ((exp((-(a - z0)) * invH) * w) * e1);
}

float wwAirColLaw(float lo, inout float hi, float4 med, float4 layer, float4 ground)
{
    bool cond8 = ground.z > 0.0f;
    bool cond7;
    if (cond8)
    {
        cond7 = hi > med.w;
    }
    else
    {
        cond7 = cond8;
    }
    float upPick;
    if (cond7)
    {
        float zArg = med.w;
        float4 medArg = med;
        float4 layerArg = layer;
        float4 groundArg = ground;
        float wwAirRhoLawRet = wwAirRhoLaw(zArg, medArg, layerArg, groundArg);
        float loArg4 = max(lo, med.w);
        float hiArg4 = hi;
        float z0Arg4 = med.w;
        float invHArg4 = ground.z;
        upPick = wwAirRhoLawRet * wwAirColOne(loArg4, hiArg4, z0Arg4, invHArg4);
    }
    else
    {
        upPick = 0.0f;
    }
    float up = upPick;
    hi = min(hi, med.w);
    float loArg3 = lo;
    float hiArg3 = hi;
    float z0Arg3 = med.y;
    float invHArg3 = med.z;
    float c = wwAirColOne(loArg3, hiArg3, z0Arg3, invHArg3);
    bool cond6 = layer.x <= 0.0f;
    bool cond5;
    if (cond6)
    {
