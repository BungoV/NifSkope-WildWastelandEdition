        float hiArg2 = hi;
        float z0Arg2 = layer.y;
        float invHArg2 = layer.z;
        c = ((1.0f - layer.x) * c) + (layer.x * wwAirColOne(loArg2, hiArg2, z0Arg2, invHArg2));
    }
    if (layer.w > 0.0f)
    {
        float loArg = lo;
        float hiArg = hi;
        float z0Arg = ground.x;
        float invHArg = ground.y;
        c += (layer.w * wwAirColOne(loArg, hiArg, z0Arg, invHArg));
    }
    return c + up;
}

