// HLSL port of features/near/cell_vrs_rate.frag (frag shader). Generated by notes/hlslbulk1/tools/convert.py:
// glslang -G, then spirv-cross --hlsl; loose uniforms are the LooseUniforms cbuffer (register b31); the
// GLSL includes are inlined as the loader does. Fusion Shaders (F4FS) feeds it the GL-side inputs
// named in notes/vkcompute1/hlsl_plan.md. Not wired: nothing loads this file.
// profile: ps_6_0
#include "NearBindingsVk.hlsli"
cbuffer LooseUniforms : register(b31, space0)
{
    float2 vrsSize;
    float2 vrsTile;
    int vrsMvOn;
    float vrsMotion;
    float vrsCut;	// the opaque pass's allowance
    int vrsMax;	// 2 or 4
    float vrsCutSorted;	// the sorted pass's (stricter, never past 2x2)
};
Texture2D<float4> vrsSrc : register(t0, space0);	// this frame's picture, resolved, display values
SamplerState _vrsSrc_sampler : register(s0, space0);
Texture2D<float4> vrsMv : register(t1, space0);	// previous minus current, texture units (read only when vrsMvOn)
SamplerState _vrsMv_sampler : register(s1, space0);

static float4 gl_FragCoord;
static uint rateOpaque;
static uint rateSorted;

struct SPIRV_Cross_Input
{
    float4 gl_FragCoord : SV_Position;
};

struct SPIRV_Cross_Output
{
    uint rateOpaque : SV_Target0;
    uint rateSorted : SV_Target1;
};

// palette indices (cellvrs.cpp): 0 1x1, 1 1x2, 2 2x1, 3 2x2, 4 2x4, 5 4x2, 6 4x4 (width x height)
uint pick(float2 d, float cut, int maxRate)
{
    int rx = (d.x < cut) ? 2 : 1;
    int ry = (d.y < cut) ? 2 : 1;
    if (maxRate >= 4)
    {
        if ((d.x < (cut * 0.25f)) && (rx == 2))
        {
            rx = 4;
        }
        if ((d.y < (cut * 0.25f)) && (ry == 2))
        {
            ry = 4;
        }
    }
    // no 4x1 / 1x4 in the hardware's set
    if ((rx == 4) && (ry == 1))
    {
        rx = 2;
    }
    if ((ry == 4) && (rx == 1))
    {
        ry = 2;
    }
    if (rx == 1)
    {
        return (ry == 1) ? 0u : 1u;
    }
    if (ry == 1)
    {
        return 2u;
    }
    if (rx == 2)
    {
        return (ry == 2) ? 3u : 4u;
    }
    return (ry == 2) ? 5u : 6u;
}

void frag_main()
{
    int2 size = int2(vrsSize);
    int2 tile = int2(vrsTile);
    int2 o = int2(gl_FragCoord.xy) * tile;
    int2 hi = size - int2(1, 1);
    float2 d = 0.0f.xx;
    for (int y = -1; y < tile.y; y++)
    {
        for (int x = -1; x < tile.x; x++)
        {
            int2 p = clamp(o + int2(x, y), int2(0, 0), hi);
            float3 c = vrsSrc.Load(int3(p, 0)).xyz;
            float3 r = vrsSrc.Load(int3(clamp(p + int2(1, 0), int2(0, 0), hi), 0)).xyz;
            float3 u = vrsSrc.Load(int3(clamp(p + int2(0, 1), int2(0, 0), hi), 0)).xyz;
            float3 dx = abs(c - r);
            float3 dy = abs(c - u);
            d = max(d, float2(max(dx.x, max(dx.y, dx.z)), max(dy.x, max(dy.y, dy.z))));
        }
    }
    float k = 1.0f;
    if (vrsMvOn != 0)
    {
        int2 m = clamp(o + (tile / int2(2, 2)), int2(0, 0), hi);
        float v = length(vrsMv.Load(int3(m, 0)).xy * vrsSize);
        // under a pixel a frame: none
        k = clamp(1.0f + (vrsMotion * max(v - 1.0f, 0.0f)), 1.0f, 4.0f);
    }
    float2 dArg2 = d;
    float cutArg2 = vrsCut * k;
    int maxRateArg2 = vrsMax;
    rateOpaque = pick(dArg2, cutArg2, maxRateArg2);
    float2 dArg = d;
    float cutArg = vrsCutSorted * k;
    int maxRateArg = 2;
    rateSorted = pick(dArg, cutArg, maxRateArg);
}

SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
{
    gl_FragCoord = stage_input.gl_FragCoord;
    gl_FragCoord.w = 1.0 / gl_FragCoord.w;
    frag_main();
    SPIRV_Cross_Output stage_output;
    stage_output.rateOpaque = rateOpaque;
    stage_output.rateSorted = rateSorted;
    return stage_output;
}
