float4 getTexture(int n)
{
    float r_c = cos(textures[n].uvRotation);
    float r_s = sin(textures[n].uvRotation) * (-1.0f);
    float2 offs = texCoords[textures[n].coordSet] - textures[n].uvCenter;
    offs = float2((offs.x * r_c) - (offs.y * r_s), (offs.x * r_s) + (offs.y * r_c));
    offs = ((offs * textures[n].uvScale) + textures[n].uvCenter) + textures[n].uvOffset;
    int getTextureRet = textures[n].textureUnit - 1;
    return textureUnits[getTextureRet].Sample(_textureUnits_sampler[getTextureRet], offs);
}

float pfxSoftFade()
{
    bool wwh0 = (((pfxGame & 2) == 0) || (!fxSoft));
    bool wwh1 = (volPart != 0);
    if (or(wwh0, wwh1))   // HLSLFIX2 orfix.py: no short-circuit branch (NV took the wrong side)
    {
        return 1.0f;
    }
    float d = fxDepth.Load(int3(int2(gl_FragCoord.xy) - viewportDimensions.xy, 0)).x;
    float sceneW = projectionMatrix[3].z / (projectionMatrix[2].z + ((2.0f * d) - 1.0f));
    float k = fxDistScale / max(fxSoftDepth, 1.0f);
    float fragW = 1.0f / gl_FragCoord.w;
    float soft = clamp((sceneW - fragW) * k, 0.0f, 1.0f);
    float t = clamp(((fragW * k) - 0.07500000298023223876953125f) * 2.352941036224365234375f, 0.0f, 1.0f);
    return ((soft * t) * t) * (3.0f - (2.0f * t));
}

