        float base = clamp(1.0f - ((1.0f - c) / max(1.0f - (t1.w + 0.001000000047497451305389404296875f), 9.9999997473787516355514526367188e-05f)), 0.0f, 1.0f);
        a *= min(pow(base, max(t2.w, 0.001000000047497451305389404296875f)), 1.0f);
