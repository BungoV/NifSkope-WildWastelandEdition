// glslang -G, then spirv-cross --hlsl; loose uniforms are the LooseUniforms cbuffer (register b31); the
// GLSL includes are inlined as the loader does. Fusion Shaders (F4FS) feeds it the GL-side inputs
// named in notes/vkcompute1/hlsl_plan.md. Not wired: nothing loads this file.
// profile: ps_6_0
#include "ParticlesBindingsVk.hlsli"
cbuffer LooseUniforms : register(b31, space0)
{
    int fxrScale;	// full-resolution pixels per layer texel, per axis
    int2 fxrSrcSize;
};
Texture2D<float4> fxrSrc : register(t0, space0);	// the opaque pass's depth at full resolution (Scene::fxDepthTexId)
SamplerState _fxrSrc_sampler : register(s0, space0);

static float4 gl_FragCoord;
static float gl_FragDepth;
static float4 fxrZ;

struct SPIRV_Cross_Input
{
    float4 gl_FragCoord : SV_Position;
};

struct SPIRV_Cross_Output
{
    float4 fxrZ : SV_Target0;
    float gl_FragDepth : SV_Depth;
};

void frag_main()
{
    int2 base = int2(gl_FragCoord.xy) * fxrScale.xx;
    float d = 1.0f;
    for (int y = 0; y < fxrScale; y++)
    {
        for (int x = 0; x < fxrScale; x++)
        {
            d = min(d, fxrSrc.Load(int3(min((base + int2(x, y)), (fxrSrcSize - int2(1, 1))), 0)).x);
        }
    }
    fxrZ = d.xxxx;
    gl_FragDepth = d;
}

SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
{
    gl_FragCoord = stage_input.gl_FragCoord;
    gl_FragCoord.w = 1.0 / gl_FragCoord.w;
    frag_main();
    SPIRV_Cross_Output stage_output;
    stage_output.gl_FragDepth = gl_FragDepth;
    stage_output.fxrZ = fxrZ;
    return stage_output;
}
