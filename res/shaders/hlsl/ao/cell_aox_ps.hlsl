}

float4 XeGTAO_UnpackEdges(float packedValue)
{
    uint packedVal = uint(packedValue * 255.5f);
    float4 edgesLRTB;
    edgesLRTB.x = float((packedVal >> uint(6)) & 3u) / 3.0f;
    edgesLRTB.y = float((packedVal >> uint(4)) & 3u) / 3.0f;
    edgesLRTB.z = float((packedVal >> uint(2)) & 3u) / 3.0f;
    edgesLRTB.w = float((packedVal >> uint(0)) & 3u) / 3.0f;
    return clamp(edgesLRTB, 0.0f.xxxx, 1.0f.xxxx);
}

// one pixel of XeGTAO_Denoise (finalApply): the edge-aware 3x3 over the working term (src.r) and edges (src.g)
float XeGTAO_Denoise(int2 pixCoord, float blurBeta)
