    float3 n = gbuf.Load(int3(int2(t.x, (fullSize.y - 1) - t.y), 0)).xyz;
    return normalize(float3(n.x, n.y, -n.z));
}

// SSAO_StaticCleanNoise: the 4x4 tile the static denoise kernel reassembles
float2 aoxStaticNoise(int2 p)
{
    uint x = uint(p.x) & 3u;
    uint y = uint(p.y) & 3u;
    uint xy = x ^ y;
    uint index = (((((xy >> uint(1)) & 1u) << uint(3)) | (((y >> uint(1)) & 1u) << uint(2))) | ((xy & 1u) << uint(1))) | (y & 1u);
    uint stepIndex = ((((index & 1u) << uint(3)) | ((index & 2u) << uint(1))) | ((index & 4u) >> uint(1))) | ((index & 8u) >> uint(3));
    return (float2(float(index), float(stepIndex)) + 0.5f.xx) * 0.0625f;
}

uint aoxSelectMip(float len)
