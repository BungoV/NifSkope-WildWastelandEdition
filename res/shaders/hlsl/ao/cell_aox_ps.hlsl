// DenoiseCS, static sampling: a (2r+1)^2 box with half-weight rims, cut by the relative depth
float aoxBilateral(int2 P)
{
    int radius = clamp(int(aoxDenoise.x), 1, 4);
    int2 tArg11 = P;
    float centerDepth = aoxZ(tArg11);
    float invDepthSigma = 1.0f / max(aoxDenoise.y * centerDepth, 0.001000000047497451305389404296875f);
    float weightedAO = 0.0f;
    float weightSum = 0.0f;
    int part2 = -radius;
    for (int y = part2; y <= radius; y++)
    {
        int part = -radius;
        for (int x = part; x <= radius; x++)
        {
            int2 q = P + int2(x, y);
            int2 tArg10 = q;
            float dz = abs(aoxZ(tArg10) - centerDepth) * invDepthSigma;
            float spatial = ((abs(x) == radius) ? 0.5f : 1.0f) * ((abs(y) == radius) ? 0.5f : 1.0f);
            float weight = spatial * exp((-dz) * dz);
            int2 tArg9 = q;
            weightedAO += (aoxSrc(tArg9).x * weight);
            weightSum += weight;
        }
    }
    return weightedAO / max(weightSum, 9.9999997473787516355514526367188e-05f);
}

float XeGTAO_PackEdges(inout float4 edgesLRTB)
{
    edgesLRTB = round(clamp(edgesLRTB, 0.0f.xxxx, 1.0f.xxxx) * 2.900000095367431640625f);
    return dot(edgesLRTB, float4(0.2509804069995880126953125f, 0.062745101749897003173828125f, 0.01568627543747425079345703125f, 0.0039215688593685626983642578125f));
}

float4 XeGTAO_CalculateEdges(float centerZ, float leftZ, float rightZ, float topZ, float bottomZ)
{
    float4 edgesLRTB = float4(leftZ, rightZ, topZ, bottomZ) - centerZ.xxxx;
    float slopeLR = (edgesLRTB.y - edgesLRTB.x) * 0.5f;
    float slopeTB = (edgesLRTB.w - edgesLRTB.z) * 0.5f;
    float4 edgesLRTBSlopeAdjusted = edgesLRTB + float4(slopeLR, -slopeLR, slopeTB, -slopeTB);
    edgesLRTB = min(abs(edgesLRTB), abs(edgesLRTBSlopeAdjusted));
    return clamp(1.25f.xxxx - (edgesLRTB / (centerZ * 0.010999999940395355224609375f).xxxx), 0.0f.xxxx, 1.0f.xxxx);
}

float XeGTAO_FastSqrt(float x)
{
    return asfloat(532487669 + (asint(x) >> 1));
}

float XeGTAO_FastACos(float inX)
{
    float x = abs(inX);
    float res = ((-0.15658299624919891357421875f) * x) + 1.57079601287841796875f;
    float xArg = 1.0f - x;
    res *= XeGTAO_FastSqrt(xArg);
    float XeGTAO_FastACosRet;
    if (inX >= 0.0f)
    {
        XeGTAO_FastACosRet = res;
    }
    else
    {
        XeGTAO_FastACosRet = 3.14159297943115234375f - res;
    }
    return XeGTAO_FastACosRet;
}

