    edgesC_LRTB = clamp(edgesC_LRTB + edginess.xxxx, 0.0f.xxxx, 1.0f.xxxx);
    float weightTL = 0.425000011920928955078125f * ((edgesC_LRTB.x * edgesL_LRTB.z) + (edgesC_LRTB.z * edgesT_LRTB.x));
    float weightTR = 0.425000011920928955078125f * ((edgesC_LRTB.z * edgesT_LRTB.y) + (edgesC_LRTB.y * edgesR_LRTB.z));
    float weightBL = 0.425000011920928955078125f * ((edgesC_LRTB.w * edgesB_LRTB.x) + (edgesC_LRTB.x * edgesL_LRTB.w));
    float weightBR = 0.425000011920928955078125f * ((edgesC_LRTB.y * edgesR_LRTB.w) + (edgesC_LRTB.w * edgesB_LRTB.y));
    float sumWeight = blurBeta;
    float sum = (cC.x / 255.0f) * sumWeight;
    sum += ((cL.x / 255.0f) * edgesC_LRTB.x);
    sumWeight += edgesC_LRTB.x;
    sum += ((cR.x / 255.0f) * edgesC_LRTB.y);
    sumWeight += edgesC_LRTB.y;
    sum += ((cT.x / 255.0f) * edgesC_LRTB.z);
    sumWeight += edgesC_LRTB.z;
    sum += ((cB.x / 255.0f) * edgesC_LRTB.w);
    sumWeight += edgesC_LRTB.w;
    int2 tArg21 = pixCoord + int2(-1, -1);
    sum += ((aoxSrc(tArg21).x / 255.0f) * weightTL);
    sumWeight += weightTL;
    int2 tArg20 = pixCoord + int2(1, -1);
    sum += ((aoxSrc(tArg20).x / 255.0f) * weightTR);
    sumWeight += weightTR;
    int2 tArg19 = pixCoord + int2(-1, 1);
    sum += ((aoxSrc(tArg19).x / 255.0f) * weightBL);
    sumWeight += weightBL;
    int2 tArg18 = pixCoord + int2(1, 1);
    sum += ((aoxSrc(tArg18).x / 255.0f) * weightBR);
    sumWeight += weightBR;
    float outputValue = (sum / sumWeight) * 1.5f;
