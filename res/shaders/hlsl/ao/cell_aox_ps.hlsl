float aoxZMip(int m, inout int2 t)
{
    t = clamp(t, int2(0, 0), mipSize[m] - int2(1, 1));
    if (m == 0)
    {
        return xz0.Load(int3(t, 0)).x;
    }
    if (m == 1)
    {
        return xz1.Load(int3(t, 0)).x;
    }
    if (m == 2)
    {
        return xz2.Load(int3(t, 0)).x;
    }
    if (m == 3)
    {
        return xz3.Load(int3(t, 0)).x;
    }
    return xz4.Load(int3(t, 0)).x;
}

float aoxZ(int2 t)
{
    int mArg = 0;
