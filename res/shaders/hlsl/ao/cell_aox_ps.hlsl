            float lenArg = length(offsetPixels);
            uint tapMip = aoxSelectMip(lenArg);
            int2 sp0 = clamp(int2(round(float2(P) + offsetPixels)), int2(0, 0), pmax);
            int mArg3 = int(tapMip);
