// HLSL port of features/ao/cell_aodecal.vert (vert shader). Generated by notes/hlslbulk1/tools/convert.py:
// glslang -G, then spirv-cross --hlsl; loose uniforms are the LooseUniforms cbuffer (register b31); the
// GLSL includes are inlined as the loader does. Fusion Shaders (F4FS) feeds it the GL-side inputs
// named in notes/vkcompute1/hlsl_plan.md. Not wired: nothing loads this file.
// profile: vs_6_0
#include "AoBindingsVk.hlsli"
cbuffer LooseUniforms : register(b31, space0)
{
    float4 aoClip[4];	// clip = aoClip[r] . (model, 1), r = x, y, z, w
};

static float4 gl_Position;
static float3 vertexPosition;

struct SPIRV_Cross_Input
{
    float3 vertexPosition : TEXCOORD0;
};

struct SPIRV_Cross_Output
{
    float4 gl_Position : SV_Position;
};

void vert_main()
{
    float4 p = float4(vertexPosition, 1.0f);
    gl_Position = float4(dot(aoClip[0], p), dot(aoClip[1], p), dot(aoClip[2], p), dot(aoClip[3], p));
}

SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
{
    vertexPosition = stage_input.vertexPosition;
    vert_main();
    SPIRV_Cross_Output stage_output;
    stage_output.gl_Position = gl_Position;
    return stage_output;
}
