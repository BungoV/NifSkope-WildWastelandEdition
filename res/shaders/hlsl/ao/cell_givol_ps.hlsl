// shape -> world: Rz Ry Rx
#define WW_FN_volRot
#include "cell_givol.hlsli"
#undef WW_FN_volRot

// l: the point in the shape's own frame (centered, unrotated)
bool volInside(float3 l, int type, float3 s)
{
    float3 h = max(s * 0.5f, 0.001000000047497451305389404296875f.xxx);
    if (type == 4)
    {
        return dot(l / h, l / h) <= 1.0f;
    }
    if (type == 3)
    {
        float r = min(h.x, h.y);
        float hz = max(h.z - r, 0.0f);
        float3 d = float3(l.xy, l.z - clamp(l.z, -hz, hz));
        return dot(d, d) <= (r * r);
    }
    float3 cond = abs(l);
    if (any(bool3(cond.x > h.x, cond.y > h.y, cond.z > h.z)))
    {
        return false;
    }
    if (type == 1)
    {
        return dot(l.xy / h.xy, l.xy / h.xy) <= 1.0f;
    }
    if (type == 2)
    {
        return (l.z + h.z) <= ((2.0f * h.z) * (0.5f - ((0.5f * l.y) / h.y)));
    }
    return true;
}

void frag_main()
{
    int2 f = int2(gl_FragCoord.xy);
    float4 g = volGbuf.Load(int3(f, 0));
    bool cond3 = g.w >= 100000.0f;
    bool cond2;
    if (!cond3)
    {
        cond2 = dot(g.xyz, g.xyz) < 0.5f;
    }
    else
    {
        cond2 = cond3;
    }
    if (cond2)
    {
        discard;
    }
    float z = (-g.w) / length(volRow[0].xyz);
    float2 ndc = (((float2(f) + 0.5f.xx) / float2(volFull)) * 2.0f) - 1.0f.xx;
    float4 pv = float4((ndc * (-z)) / volProj, z, 1.0f);
    float3 P = float3(dot(volRow[0], pv), dot(volRow[1], pv), dot(volRow[2], pv));
    float3 N = normalize(float3(dot(volRow[0].xyz, g.xyz), dot(volRow[1].xyz, g.xyz), dot(volRow[2].xyz, g.xyz)));
    float4 a = volShapes.Load(3 * vShape);
    float4 b = volShapes.Load((3 * vShape) + 1);
    float4 c = volShapes.Load((3 * vShape) + 2);
    float3 degArg = c.xyz;
    float3 l = mul((P + (N * volBias)) - a.xyz, transpose(volRot(degArg)));
    float3 lArg = l;
    int typeArg = int(a.w + 0.5f);
    float3 sArg = b.xyz;
    if (!volInside(lArg, typeArg, sArg))
    {
        discard;
    }
    volOut = (b.w + 1.0f).xxxx;
}

SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
{
    gl_FragCoord = stage_input.gl_FragCoord;
    gl_FragCoord.w = 1.0 / gl_FragCoord.w;
    vShape = stage_input.vShape;
    frag_main();
    SPIRV_Cross_Output stage_output;
    stage_output.volOut = volOut;
