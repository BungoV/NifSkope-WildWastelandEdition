void addLod(inout float4 w, float lod, float scale)
{
    float l = clamp(lod, 1.0f, 4.0f);
    int lo = int(floor(l));
    int hi = min((lo + 1), 4);
    float f = frac(l);
    int wPart2 = lo - 1;
    w[wPart2] += (scale * (1.0f - f));
    int wPart = hi - 1;
    w[wPart] += (scale * f);
}

