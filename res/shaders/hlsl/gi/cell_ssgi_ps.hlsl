                int2 fullTexelArg6 = q;
                float z = gAt(fullTexelArg6).w;
                if (z > 0.0f)
                {
                    r = float2(min(r.x, z), max(r.y, z));
                }
            }
            else
            {
                float2 iv = hiz.Load(int3(q, 0)).xy;
                r = float2(min(r.x, iv.x), max(r.y, iv.y));
            }
