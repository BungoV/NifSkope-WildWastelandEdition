}

float3 ffClamp(float3 c, float mean, float span)
{
    float y = dot(c, float3(0.2125999927520751953125f, 0.715200006961822509765625f, 0.072200000286102294921875f)) + 9.9999997473787516355514526367188e-05f;
    float l = log2(y);
    float lc = clamp(l, mean - span, mean + span);
    return c * exp2(lc - l);
}

