// glslang -G, then spirv-cross --hlsl; loose uniforms are the LooseUniforms cbuffer (register b31); the
// GLSL includes are inlined as the loader does. Fusion Shaders (F4FS) feeds it the GL-side inputs
// named in notes/vkcompute1/hlsl_plan.md. Not wired: nothing loads this file.
// profile: vs_6_0
// note: gl_PointSize writes dropped (HLSL has no point size)
#include "FarLodBindingsVk.hlsli"
cbuffer LooseUniforms : register(b31, space0)
{
    float4 dotRow[3];
    float4x4 dotProj;
    float3 dotCam;	// the camera, world
    int dotRed;	// 1 = never faded (debug)
    float2 dotBand;
    float dotFocal;	// f, pixels
    float dotBulb;	// the bulb radius, world units
};

static float4 gl_Position;
static float3 vertexPosition;
static float3 dotView;
static float dotSigma;
static float3 dotValue;
static float3 vertexColor;

struct SPIRV_Cross_Input
{
    float3 vertexPosition : TEXCOORD0;
    float3 vertexColor : TEXCOORD1;
};

struct SPIRV_Cross_Output
{
    float3 dotValue : TEXCOORD0;
    float3 dotView : TEXCOORD1;
    float dotSigma : TEXCOORD2;
    float4 gl_Position : SV_Position;
};

void vert_main()
{
    float4 w = float4(vertexPosition, 1.0f);
    float3 v = float3(dot(dotRow[0], w), dot(dotRow[1], w), dot(dotRow[2], w));
    gl_Position = mul(float4(v, 1.0f), dotProj);
    dotView = v;
    float d = max(length(vertexPosition - dotCam), 1.0f);
    float tmp80;
    if ((dotRed & 1) != 0)
    {
        tmp80 = 1.0f;
    }
    else
    {
        tmp80 = smoothstep(dotBand.x, dotBand.y, d);
    }
    float fade = tmp80;
    dotSigma = max(0.60000002384185791015625f, (dotFocal * dotBulb) / d);
    float k = dotFocal / d;
    dotValue = (((vertexColor * fade) * k) * k) / ((6.283185482025146484375f * dotSigma) * dotSigma).xxx;
}

SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
{
    vertexPosition = stage_input.vertexPosition;
    vertexColor = stage_input.vertexColor;
    vert_main();
    SPIRV_Cross_Output stage_output;
    stage_output.gl_Position = gl_Position;
    stage_output.dotView = dotView;
    stage_output.dotSigma = dotSigma;
    stage_output.dotValue = dotValue;
    return stage_output;
}
