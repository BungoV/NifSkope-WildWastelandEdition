# fo4_effectshader for an effect decal in the cell view, lit as the surface under it (lane DECALLIT1; src/gl/celllights.h).
# No conditions: the condition scan never picks it; Renderer::setupProgram swaps it in by name for
# fo4_effectshader.prog while the draw is a cell-lit effect decal.

shaders fo4_default.vert fo4_effectdecal.frag
